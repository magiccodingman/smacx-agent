<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <meta name="theme-color" content="#07151c" />
    <meta name="application-name" content="SMACX Agent" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <script>
        (() => {
            const isFramed = window.top !== window.self;
            const search = new URLSearchParams(window.location.search);
            const isEmbedView = search.get('hideNav') === '1' || search.get('hideImage') === '1';
            const shouldTrack = !isFramed && !isEmbedView;

            if (!shouldTrack) {
                window.plausible = window.plausible || function () {};
                return;
            }

            window.plausible = window.plausible || function () {
                (window.plausible.q = window.plausible.q || []).push(arguments);
            };

            let lastTrackedUrl = window.location.href;
            const trackNavigation = () => {
                const nextUrl = window.location.href;
                if (nextUrl === lastTrackedUrl) return;
                lastTrackedUrl = nextUrl;
                window.plausible('pageview', { u: nextUrl });
            };
            const observeHistory = method => {
                const original = window.history[method];
                window.history[method] = function () {
                    const result = original.apply(this, arguments);
                    queueMicrotask(trackNavigation);
                    return result;
                };
            };
            observeHistory('pushState');
            observeHistory('replaceState');
            window.addEventListener('popstate', trackNavigation);
            window.addEventListener('hashchange', trackNavigation);

            const script = document.createElement('script');
            script.defer = true;
            script.dataset.domain = 'smacx-agent.magiccodingman';
            script.dataset.api = 'https://track.truthorigin.com/api/event';
            script.src = '/js/potato.js';
            document.head.appendChild(script);
        })();
    </script>
    <script src="js/pwa-install.js"></script>
    <script src="js/access-verification.js"></script>
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="192x192" href="icons/smacx-planetary-network-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Space+Grotesk:wght@500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Smacx.Portal.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" sizes="192x192" href="@Assets["icons/smacx-planetary-network-192.png"]" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting()
            // Authentication and other browser-bound APIs must execute in the
            // browser so their cookies belong to the user's session. Keeping
            // the portal shell in WASM also prevents an initial server circuit
            // from accidentally retaining response cookies inside HttpClient.
            ? new InteractiveWebAssemblyRenderMode(prerender: false)
            : null;
}
