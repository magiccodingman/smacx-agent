@implements IDisposable
@inject NavigationManager Navigation
@inject Services.PortalApiClient Api

<MudAppBar Elevation="0" Class="portal-appbar">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="ToggleRequested" Class="menu-button" />
    <div class="appbar-wordmark">
        <MudText Typo="Typo.h6">SMACX Agent</MudText>
        <MudText Typo="Typo.caption">Planetary network</MudText>
    </div>
    <MudSpacer />
    <div class="network-pill"><span></span> LAN ONLY</div>
    <AuthorizeView>
        <Authorized Context="auth">
            <MudMenu Label="@auth.User.Identity?.Name" Variant="Variant.Text"
                     StartIcon="@Icons.Material.Filled.Person" Class="account-button"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Href="account" Icon="@Icons.Material.Filled.ManageAccounts">Account</MudMenuItem>
                <MudMenuItem Href="install" Icon="@Icons.Material.Filled.InstallMobile">Install app</MudMenuItem>
                <MudMenuItem OnClick="Logout" Icon="@Icons.Material.Filled.Logout">Sign out</MudMenuItem>
            </MudMenu>
        </Authorized>
        <NotAuthorized>
            <MudIconButton Href="install" Icon="@Icons.Material.Filled.InstallMobile" aria-label="Install app" />
            <MudButton Href="login" Variant="Variant.Outlined" Color="Color.Primary">Sign in</MudButton>
        </NotAuthorized>
    </AuthorizeView>
</MudAppBar>

@code {
    [Parameter] public EventCallback ToggleRequested { get; set; }

    protected override void OnInitialized() => Navigation.LocationChanged += LocationChanged;
    private async Task Logout()
    {
        await Api.PostAsync<bool>("api/auth/logout", new { });
        Navigation.NavigateTo("login", forceLoad: true);
    }
    private void LocationChanged(object? sender, LocationChangedEventArgs args) => InvokeAsync(StateHasChanged);
    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
}
