@page "/knowledge"
@inject Services.PortalApiClient Api
<PageTitle>Datalinks · SMACX Agent</PageTitle>
<PageHeader Kicker="LOCAL KNOWLEDGE" Title="Datalinks archive" Description="Search factual mechanics and reference material. Strategy guides and hidden match information are deliberately excluded." />
<div class="surface-panel knowledge-search">
 <div class="knowledge-query"><MudTextField @bind-Value="query" Placeholder="Search mechanics, facilities, technologies, factions…" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Immediate="true" OnKeyDown="KeyDown"/><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Search">Search</MudButton></div>
 <div class="knowledge-tags"><MudChip T="string" OnClick="()=>SelectTopic(null)" Color="@(topic is null?Color.Primary:Color.Default)" Variant="Variant.Outlined">All mechanics</MudChip>@foreach(var item in topics){<MudChip T="string" OnClick="()=>SelectTopic(item.Topic)" Color="@(topic==item.Topic?Color.Primary:Color.Default)" Variant="Variant.Outlined">@item.Topic (@item.DocumentCount)</MudChip>}</div>
 @if(loading){<MudProgressLinear Indeterminate="true" Color="Color.Primary"/>}
 else if(results.Count==0){<div class="empty-state compact"><MudIcon Icon="@Icons.Material.Filled.MenuBook"/><strong>@(searched?"No matching references":"Search the local mechanics corpus")</strong><span>The bundled text is independently written; administrators can additionally retrieve private reference text from their own legal game materials.</span></div>}
 else{<div class="knowledge-results">@foreach(var item in results){<button class="knowledge-card" @onclick="()=>Open(item.DocumentId)"><span class="panel-kicker">@item.Topic</span><strong>@item.Title</strong><p>@item.Summary</p><small>@string.Join(" · ",item.Tags)</small></button>}</div>}
</div>
@if(selected is not null){<MudOverlay Visible="true" DarkBackground="true" AutoClose="true" OnClosed="()=>selected=null"><article class="surface-panel knowledge-reader" @onclick:stopPropagation="true"><div class="panel-heading"><div><span class="panel-kicker">@selected.Topic</span><h2>@selected.Title</h2></div><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="()=>selected=null" aria-label="Close document"/></div><p>@selected.Body</p><div class="reference-provenance"><strong>Provenance</strong><span>@selected.Provenance</span><small>@selected.SourceLicense</small></div></article></MudOverlay>}
@if(!string.IsNullOrEmpty(error)){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>}
@code{private IReadOnlyList<KnowledgeTopic> topics=[];private IReadOnlyList<KnowledgeResult> results=[];private KnowledgeResult? selected;private string query="";private string? topic,error;private bool loading,searched;protected override async Task OnInitializedAsync(){try{topics=(await Api.GetAsync<IReadOnlyList<KnowledgeTopic>>("api/knowledge/topics"))?.Data??[];}catch(Exception ex){error=ex.Message;}}private async Task Search(){if(string.IsNullOrWhiteSpace(query))return;loading=true;searched=true;var path=$"api/knowledge/search?q={Uri.EscapeDataString(query)}"+(topic is null?"":$"&topic={Uri.EscapeDataString(topic)}");var response=await Api.GetAsync<KnowledgeSearchResponse>(path);results=response?.Data?.Results??[];error=response?.Error?.Message;loading=false;}private async Task Open(string id){var response=await Api.GetAsync<KnowledgeResult>($"api/knowledge/documents/{Uri.EscapeDataString(id)}");selected=response?.Data;}private async Task SelectTopic(string? value){topic=value;if(!string.IsNullOrWhiteSpace(query))await Search();}private async Task KeyDown(KeyboardEventArgs args){if(args.Key=="Enter")await Search();}}
