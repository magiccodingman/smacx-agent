@page "/lobbies/{MatchId}"
@implements IAsyncDisposable
@inject Services.PortalApiClient Api
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@using Microsoft.AspNetCore.SignalR.Client
<PageTitle>@(lobby?.DisplayName ?? "Lobby") · SMACX Agent</PageTitle>
@if (loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary"/> }
else if (lobby is null) { <div class="empty-state surface-panel"><h2>Lobby unavailable</h2><p>@error</p><MudButton Href="lobbies">Back to lobbies</MudButton></div> }
else
{
 <PageHeader Kicker="@HeaderKicker(DisplayStatus)" Title="@lobby.DisplayName" Description="@HeaderDescription(DisplayStatus,lobby.NeedsAttention is not null&&lobby.Status!="recovering")"><div class="lobby-header-actions"><AuthorizeView Roles="Administrator"><Authorized>
  <MudButton Href="@($"/api/lobbies/{MatchId}/diagnostics")" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download">Download diagnostics</MudButton>
 </Authorized></AuthorizeView><span class="lobby-state @(lobby.NeedsAttention is not null&&lobby.Status!="recovering"?"attention":lobby.Status)">@(lobby.NeedsAttention is not null&&lobby.Status!="recovering"?"AI PAUSED · NEEDS ATTENTION":StatusLabel(DisplayStatus))</span>@if(lobby.CanManage&&lobby.Status=="waiting"&&lobby.StartupRequestedAt is null){<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="@(busy||!CanStart)" OnClick="Start">Start match</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" Disabled="busy" OnClick="AskCloseLobby">Close lobby</MudButton>}@if(lobby.CanManage&&lobby.Status=="running"){<MudButton Variant="Variant.Outlined" Disabled="@(busy||lobby.NeedsAttention is not null)" OnClick="Checkpoint">Save checkpoint</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.StopCircle" Disabled="busy" OnClick="@(()=>AskManagedOperation("park_match"))">Stop &amp; park</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Disabled="busy" OnClick="@(()=>AskManagedOperation("end_match"))">End campaign</MudButton>}@if(lobby.CanManage&&lobby.NeedsAttention is null&&lobby.HasVerifiedRecoveryCheckpoint&&(lobby.Status=="parked"||lobby.Status=="error")){<MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="Recover">Resume campaign</MudButton>}@if(lobby.CanManage&&lobby.Status=="parked"){<MudButton Variant="Variant.Text" Color="Color.Error" Disabled="busy" OnClick="@(()=>AskManagedOperation("end_parked"))">End permanently</MudButton>}@if(lobby.CanManage&&lobby.Status=="error"){<MudButton Variant="Variant.Text" Color="Color.Error" Disabled="busy" OnClick="@(()=>AskManagedOperation("end_error"))">End campaign</MudButton>}</div></PageHeader>
 @if(launch.Active)
 {
  <LobbyLaunchOverlay Title="@lobby.DisplayName" Phase="@LaunchPhase" Elapsed="@LaunchElapsed" Confirmed="@LaunchConfirmed" NativeJoin="lobby.NativeJoin" OnStay="StayInLobby" />
 }
 @if(launch.ConnectionProblem is not null){<MudAlert Severity="Severity.Warning" Class="mb-4" role="status">@launch.ConnectionProblem Automatic entry is off; this page will keep checking. You can use the game buttons when the connection returns.</MudAlert>}
 @if(lobby.LastError is not null&&lobby.NeedsAttention is null){<MudAlert Severity="Severity.Error" Class="mb-4">@lobby.LastError</MudAlert>}
 @if((Services.LobbyLaunchState.IsStarting(lobby.Status)||lobby.Status=="waiting"&&lobby.StartupRequestedAt is not null)&&!launch.Active&&launch.ConnectionProblem is null){<MudAlert Severity="Severity.Info" Class="mb-4">@LaunchPhase You can keep managing this page while startup continues.</MudAlert>}
 @if(Services.LobbyLaunchState.Destination(lobby) is string destination)
 {
  <div class="lobby-entry surface-panel"><div><span class="panel-kicker">CAMPAIGN LIVE</span><h2>@(destination.StartsWith("/play/")?"Your faction is ready":"The observation deck is ready")</h2><p>Open the live view. You can return here for campaign controls.</p></div><MudButton Href="@destination" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(destination.StartsWith("/play/")?Icons.Material.Filled.SportsEsports:Icons.Material.Filled.Visibility)">@(destination.StartsWith("/play/")?"Return to game":"Watch live")</MudButton></div>
 }
 @if(lobby.NeedsAttention is not null&&lobby.Status!="recovering"){<CapabilityGapDialog Incident="lobby.NeedsAttention" MatchId="@MatchId" CanRetry="@(lobby.CanManage&&IsCapabilityGap(lobby.NeedsAttention)&&lobby.NeedsAttention.VerifiedCheckpointAvailable)" RetryBusy="busy" RetryRequested="AskIncidentRetry" />}
 @if(lobby.Status=="recovering"&&lobby.Maintenance is not null){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.SettingsSuggest"><strong>@lobby.Maintenance.Summary</strong><br/>@Humanize(lobby.Maintenance.Phase) · @lobby.Maintenance.CompletedSteps / @lobby.Maintenance.TotalSteps<br/><small>This durable operation continues if you navigate away, refresh, or restart the portal.</small><MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2"/></MudAlert>}
 @if((lobby.Status is "parked" or "error")&&!lobby.HasVerifiedRecoveryCheckpoint&&!string.IsNullOrWhiteSpace(lobby.RecoveryBlockedReason)){<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.WarningAmber"><strong>This campaign cannot be resumed safely.</strong><br/>@lobby.RecoveryBlockedReason</MudAlert>}
 @if(lobby.Status=="waiting"&&lobby.StartupRequestedAt is null&&!CanStart){<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4"><strong>A managed host is still needed.</strong><br/>Add an AI or take a seat using the browser before starting. The owner may remain an observer.</MudAlert>}
 @if(lobby.Status=="waiting"&&lobby.StartupRequestedAt is null&&lobby.Seats.Count(seat=>seat.ControllerKind=="open") is var openCount&&openCount>0){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4"><strong>@openCount open @(openCount==1?"seat":"seats")</strong><br/>When the owner starts, every still-open faction becomes a stock computer player. Human and AI assignments remain unchanged.</MudAlert>}
 @if(IsAiOnlyRunning){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.Visibility"><strong>AI-only simulation · observation is always available</strong><br/>Any signed-in nonparticipant may watch managed seats. The owner or an administrator can safely stop the simulation with <strong>Stop &amp; park</strong>.</MudAlert>}
 @if(lobby.Presence?.State is "idle_grace_period" or "awaiting_first_connection" or "checkpoint_pending")
 {
  <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
   <strong>@lobby.Presence.Summary</strong>
   @if(lobby.Presence.SecondsUntilParking is > 0){<text><br/>Safe parking begins in @FormatCountdown(lobby.Presence.SecondsUntilParking.Value) unless a browser player reconnects.</text>}
  </MudAlert>
 }
 <div class="lobby-detail-grid"><section class="surface-panel seats-panel"><div class="panel-heading"><div><span class="panel-kicker">SEAT ASSIGNMENTS</span><h2>Players</h2></div><span class="unranked-chip">UNRANKED</span></div>@if(lobby.CanManage&&lobby.Status=="waiting"&&lobby.StartupRequestedAt is null){<div class="staging-roster-actions"><MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SmartToy" Disabled="@(busy||!HasOpenSeat||catalog?.Agents.Count==0)" OnClick="@(()=>AddToFirstOpenSeat("agent"))">Add AI</MudButton><MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Computer" Disabled="@(busy||!HasOpenSeat)" OnClick="@(()=>AddToFirstOpenSeat("native"))">Add bot</MudButton><MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="@(busy||!HasOpenSeat)" OnClick="@(()=>AddToFirstOpenSeat("human"))">Reserve player</MudButton></div>}<div class="seat-list">@foreach(var seat in lobby.Seats){<div class="seat-row @seat.ControllerKind"><span class="seat-number">@(seat.SeatIndex+1)</span><span class="seat-avatar"><MudIcon Icon="@SeatIcon(seat.ControllerKind)"/></span><span class="seat-name"><strong>@SeatName(seat)</strong><small>@SeatDetail(seat)</small></span>@if(lobby.CanManage&&lobby.Status=="waiting"&&lobby.StartupRequestedAt is null&&seat.ControllerKind=="open"){<MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="() => EditSeat(seat)">Assign…</MudButton>}@if(lobby.CanManage&&lobby.Status=="waiting"&&lobby.StartupRequestedAt is null&&seat.ControllerKind!="open"){<MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Edit" OnClick="() => EditSeat(seat)">Configure</MudButton>}@if(seat.CanLeave){<MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Disabled="busy" OnClick="() => LeaveSeat(seat.SeatIndex)">Leave seat</MudButton>}else if(lobby.CanManage&&lobby.Status=="waiting"&&lobby.StartupRequestedAt is null&&seat.ControllerKind!="open"){<MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="busy" OnClick="() => AskRemoveSeat(seat)">Remove</MudButton>}@if(seat.CanJoin){<MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="() => Join(seat.SeatIndex)">@(seat.ControllerKind=="human"?"Claim seat":HasOwnSeat?"Move here":"Take seat")</MudButton>}else if(seat.CanControl&&seat.InstanceId is not null){<MudButton Href="@($"/play/{lobby.MatchId}/{seat.SeatIndex}")" Target="_blank" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SportsEsports">Play</MudButton>}else if(seat.CanSpectate&&seat.InstanceId is not null){<MudButton Href="@($"/spectate/{lobby.MatchId}?seat={seat.SeatIndex}")" Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility">Watch</MudButton>}@if(seat.StagingPresenceExpiresAt is not null){<span class="seat-status reconnecting"><MudIcon Icon="@Icons.Material.Filled.WifiOff"/>Reconnecting · @StagingCountdown(seat.StagingPresenceExpiresAt.Value)</span>}else{<span class="seat-status">@seat.Status</span>}</div>}</div>
 @if(editingSeat is not null){<div class="staging-seat-editor"><div class="panel-heading"><div><span class="panel-kicker">CONFIGURE SEAT @(editingSeat.SeatIndex+1)</span><h3>@SeatName(editingSeat)</h3></div><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseSeatEditor"/></div><MudSelect T="string" @bind-Value="editController" Label="Seat type" Variant="Variant.Outlined"><MudSelectItem Value="@("open")">Open for someone to join</MudSelectItem><MudSelectItem Value="@("human")">Reserved human player</MudSelectItem><MudSelectItem Value="@("agent")" Disabled="@(catalog?.Agents.Count==0)">AI player</MudSelectItem><MudSelectItem Value="@("native")">Stock computer player</MudSelectItem></MudSelect>@if(editController=="agent"){<MudSelect T="string" @bind-Value="editAgentId" Label="AI profile" Variant="Variant.Outlined">@foreach(var profile in catalog?.Agents??[]){<MudSelectItem Value="@profile.Id">@profile.DisplayName</MudSelectItem>}</MudSelect><div class="field-pair"><MudSelect T="string" Value="@editFactionId" ValueChanged="EditFactionChanged" Label="Faction" HelperText="Random chooses an unused faction when the match starts." Variant="Variant.Outlined"><MudSelectItem Value="@FactionCatalog.Random">Random at start</MudSelectItem>@foreach(var faction in personalities?.Factions??[]){<MudSelectItem Value="@faction.Id" Disabled="@FactionReservedByAnotherSeat(faction.Id)">@faction.FactionName · @faction.LeaderName</MudSelectItem>}</MudSelect><MudSelect T="string" @bind-Value="editPersonalityId" Label="Personality" Variant="Variant.Outlined">@foreach(var option in EditPersonalityOptions){<MudSelectItem Value="@option.Id">@PersonalityLabel(option)</MudSelectItem>}</MudSelect></div>}else if(editController=="human"){<MudTextField @bind-Value="editPlayerHandle" Label="Public display name" HelperText="Leave blank to reserve this seat for yourself." Variant="Variant.Outlined"/><div class="field-pair"><MudSelect T="string" @bind-Value="editJoinMode" Label="Play using" Variant="Variant.Outlined"><MudSelectItem Value="@("browser")">This browser</MudSelectItem><MudSelectItem Value="@("native")">A separate game client</MudSelectItem></MudSelect><MudSelect T="string" Value="@editFactionId" ValueChanged="EditFactionChanged" Label="Faction" HelperText="Random chooses an unused faction when the match starts." Variant="Variant.Outlined"><MudSelectItem Value="@FactionCatalog.Random">Random at start</MudSelectItem>@foreach(var faction in personalities?.Factions??[]){<MudSelectItem Value="@faction.Id" Disabled="@FactionReservedByAnotherSeat(faction.Id)">@faction.FactionName · @faction.LeaderName</MudSelectItem>}</MudSelect></div>}else if(editController=="native"){<MudSelect T="string" Value="@editFactionId" ValueChanged="EditFactionChanged" Label="Faction" HelperText="Random chooses an unused faction when the match starts." Variant="Variant.Outlined"><MudSelectItem Value="@FactionCatalog.Random">Random at start</MudSelectItem>@foreach(var faction in personalities?.Factions??[]){<MudSelectItem Value="@faction.Id" Disabled="@FactionReservedByAnotherSeat(faction.Id)">@faction.FactionName · @faction.LeaderName</MudSelectItem>}</MudSelect>}<div class="staging-editor-actions"><MudButton Variant="Variant.Text" OnClick="CloseSeatEditor">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(busy||editController=="agent"&&string.IsNullOrWhiteSpace(editAgentId))" OnClick="SaveSeat">Save seat</MudButton></div></div>}
 @if(lobby.Seats.Any(seat=>seat.CanSpectate)){<MudButton Href="@($"/spectate/{lobby.MatchId}")" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.GridView" Class="mt-3">Open observation deck</MudButton>}</section>
 <aside class="lobby-side"><section class="surface-panel match-rules"><span class="panel-kicker">MATCH POLICY</span><h2>Session details</h2><dl><div><dt>Ruleset</dt><dd>@lobby.RulesetId</dd></div><div><dt>Mode</dt><dd>@lobby.Mode</dd></div><div><dt>Turn / year</dt><dd>@(lobby.CurrentTurn?.ToString()??"—") / @(lobby.CurrentYear?.ToString()??"—")</dd></div><div><dt>Managed only</dt><dd>@YesNo(lobby.ManagedClientsOnly)</dd></div><div><dt>Non-player spectators</dt><dd>@SpectatorPolicy</dd></div><div><dt>Graphiti memory</dt><dd>@YesNo(lobby.GraphitiEnabled)</dd></div></dl>@if(lobby.NativeJoin is not null){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3"><strong>Native clients may join now</strong><br/>TCP/IP host: <code>@lobby.NativeJoin.HostAddress</code><br/>Session: <code>@lobby.NativeJoin.SessionName</code>@foreach(var player in lobby.NativeJoin.Players){<br/><span>Seat @(player.SeatIndex+1): use public display name <code>@player.PlayerName</code>@if(player.ExpectedFactionName is not null){<text> · choose @player.ExpectedFactionName</text>}else if(player.ExpectedFactionId is not null){<text> · faction @player.ExpectedFactionId</text>}</span>}</MudAlert>}<MudExpansionPanels Elevation="0" Class="mt-3"><MudExpansionPanel Text="Native game settings">@foreach(var setting in lobby.Settings){<div class="setting-row"><span>@Humanize(setting.Key)</span><strong>@setting.Value</strong></div>}</MudExpansionPanel></MudExpansionPanels></section>
 <LobbyChat @ref="chat" MatchId="@MatchId" Lobby="@lobby" /></aside></div>
 @if(!string.IsNullOrEmpty(notice)){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">@notice</MudAlert>}
 @if(!string.IsNullOrEmpty(error)&&error!=launch.ConnectionProblem){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>}
}
@code {
 [Parameter] public string MatchId {get;set;}=""; private LobbyDetails? lobby; private LobbyCatalog? catalog; private FactionPersonalityCatalog? personalities; private LobbySeatSummary? editingSeat; private LobbyChat? chat; private string editController="open",editAgentId="",editPlayerHandle="",editJoinMode="browser",editFactionId=FactionCatalog.Random,editPersonalityId="standard"; private string? error,notice,confirmOperation; private bool loading=true,busy; private HubConnection? hub;private PeriodicTimer? refreshTimer;private CancellationTokenSource? refreshCancellation;
 private bool HasOpenSeat=>lobby?.Seats.Any(seat=>seat.ControllerKind=="open")==true;
 private bool HasOwnSeat=>lobby?.Seats.Any(seat=>seat.CanLeave)==true;
 private bool IsAiOnlyRunning=>lobby?.Status=="running"&&lobby.Seats.All(seat=>seat.ControllerKind!="human");
 private string SpectatorPolicy=>IsAiOnlyRunning?"Always available (AI-only)":YesNo(lobby?.AllowSpectators==true);
 private bool CanStart=>lobby?.Seats.Any(seat=>seat.ControllerKind=="agent"||seat.ControllerKind=="human"&&seat.JoinMode=="browser")==true;
 private string? initializedMatch;
 protected override async Task OnParametersSetAsync(){if(initializedMatch==MatchId)return;await DisposeAsync();hub=null;initializedMatch=MatchId;launch=new();lobby=null;error=null;notice=null;editingSeat=null;startPending=false;busy=false;loading=true;await Refresh();catalog=(await Api.GetAsync<LobbyCatalog>("api/catalog/lobby"))?.Data;personalities=(await Api.GetAsync<FactionPersonalityCatalog>("api/catalog/factions-personalities"))?.Data;editAgentId=catalog?.Agents.FirstOrDefault()?.Id??"";try{hub=new HubConnectionBuilder().WithUrl(Navigation.ToAbsoluteUri("hubs/lobby")).WithAutomaticReconnect().Build();hub.On<string>("LobbyMessagesChanged",_=>InvokeAsync(async()=>{if(chat is not null)await chat.RefreshAsync();}));hub.On<string>("LobbyChanged",_=>InvokeAsync(Refresh));hub.On<string>("LobbyClosed",_=>InvokeAsync(()=>Navigation.NavigateTo("lobbies")));hub.On<GovernanceProposal>("GovernanceChanged",_=>InvokeAsync(Refresh));hub.Reconnected+=async _=>{if(hub is not null)await hub.InvokeAsync("JoinLobby",MatchId);await InvokeAsync(Refresh);};await hub.StartAsync();await hub.InvokeAsync("JoinLobby",MatchId);}catch(Exception){hub=null;}refreshCancellation=new();refreshTimer=new(TimeSpan.FromSeconds(1));_=RefreshPresence(refreshCancellation.Token);loading=false;}
 private bool startPending;
 private Services.LobbyLaunchState launch = new();
 private readonly SemaphoreSlim refreshLock = new(1,1);
 private string DisplayStatus => lobby?.Status=="waiting"&&lobby.StartupRequestedAt is not null?"provisioning":lobby?.Status??"waiting";
 private string LaunchPhase => lobby?.Status=="waiting"&&lobby.StartupRequestedAt is not null ? "Preparing the game and managed seats…" : lobby?.Status switch { "provisioning"=>"Preparing the game and managed seats…", "starting"=>"Starting the native game and connecting players…", "lobby"=>"Waiting for native players to join…", "running"=>"Confirming your game entry…", _=>"Requesting startup…" };
 private string LaunchElapsed => FormatCountdown((int)Math.Max(0,(DateTimeOffset.UtcNow-(launch.BeganAt??DateTimeOffset.UtcNow)).TotalSeconds));
 private string LaunchConfirmed => launch.LastConfirmedAt is DateTimeOffset last ? $"Status confirmed {(int)Math.Max(0,(DateTimeOffset.UtcNow-last).TotalSeconds)}s ago" : "Awaiting server confirmation";
 private void StayInLobby(){launch.Stay();notice="You’ll stay in the lobby. Use Return to game or Watch live when ready.";}
 private void ApplyLobby(LobbyDetails latest)
 {
  if(latest.MatchId!=MatchId)return;
  lobby=latest;
  if(startPending&&latest.Status=="waiting"&&latest.StartupRequestedAt is null)return;
  error=null;
  var wasActive=launch.Active;
  var destination=launch.Observe(latest,DateTimeOffset.UtcNow);
  if(destination is not null)Navigation.NavigateTo(destination);
  else if(wasActive&&!launch.Active&&latest.Status=="running"&&latest.NeedsAttention is null&&latest.LastError is null)
   notice="The campaign has started. No game view is currently available to your account; you can remain in the lobby.";
  else if(wasActive&&!launch.Active&&latest.Status=="waiting")notice="Startup did not proceed. The lobby is available again.";
 }
 private async Task RefreshPresence(CancellationToken cancellationToken)
 {
  var ticks=0;
  try { while(refreshTimer is not null&&await refreshTimer.WaitForNextTickAsync(cancellationToken))
   {
    if(++ticks%5==0)await InvokeAsync(Refresh);
    if(launch.Active&&launch.LastConfirmedAt is DateTimeOffset last&&DateTimeOffset.UtcNow-last>TimeSpan.FromSeconds(20))launch.Failed("The server’s startup status could not be confirmed.");
    await InvokeAsync(StateHasChanged);
   }
  }catch(OperationCanceledException)when(cancellationToken.IsCancellationRequested){}
 }
 private async Task Refresh()
 {
  var requestedMatch=MatchId;
  if(!await refreshLock.WaitAsync(0))return;
  try
  {
   using var timeout=new CancellationTokenSource(TimeSpan.FromSeconds(15));
   var response=await Api.GetAsync<LobbyDetails>($"api/lobbies/{requestedMatch}",timeout.Token);
   if(requestedMatch!=MatchId)return;
   if(response?.Ok==true&&response.Data is not null)ApplyLobby(response.Data);
   else {error=response?.Error?.Message??"The lobby could not be loaded.";launch.Failed(error);}
  }
  catch(Exception ex)when(ex is HttpRequestException or OperationCanceledException){if(requestedMatch==MatchId){error="The lobby connection was interrupted.";launch.Failed(error);}}
  finally{refreshLock.Release();StateHasChanged();}
 }
 private async Task Start()
 {
  var requestedMatch=MatchId;
  busy=true;startPending=true;error=null;launch.Begin(DateTimeOffset.UtcNow);
  try
  {
   var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{requestedMatch}/start",new{});
   if(requestedMatch!=MatchId)return;
   if(result.Payload?.Ok==true&&result.Payload.Data is not null)ApplyLobby(result.Payload.Data);
   else {error=result.Payload?.Error?.Message??"The match could not be provisioned.";launch.Failed(error);}
  }
  catch(Exception ex)when(ex is HttpRequestException or OperationCanceledException){if(requestedMatch==MatchId){error="Startup could not be confirmed. Checking the server before offering game entry.";launch.Failed(error);}}
  finally{if(requestedMatch==MatchId){busy=false;startPending=false;}}
 }
 private async Task Join(int seatIndex){busy=true;error=null;var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/join",new JoinLobbyRequest(seatIndex,"browser"));busy=false;if(result.Payload?.Ok==true)lobby=result.Payload.Data;else error=result.Payload?.Error?.Message??"The seat could not be claimed.";}
 private async Task LeaveSeat(int seatIndex){busy=true;error=null;var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/leave",new LeaveLobbySeatRequest(seatIndex));busy=false;if(result.Payload?.Ok==true)lobby=result.Payload.Data;else error=result.Payload?.Error?.Message??"The seat could not be released.";}
 private void AddToFirstOpenSeat(string controller){var seat=lobby?.Seats.FirstOrDefault(item=>item.ControllerKind=="open");if(seat is not null)EditSeat(seat,controller);}
 private async Task AskRemoveSeat(LobbySeatSummary seat){error=null;notice=null;var confirmed=await Dialogs.ShowMessageBoxAsync($"Remove {SeatName(seat)}?",$"This returns seat {seat.SeatIndex+1} to the open roster. No game process has started yet.",yesText:"Remove seat",noText:"Cancel",options:ConfirmationDialogOptions);if(confirmed==true)await RemoveSeat(seat);}
 private async Task RemoveSeat(LobbySeatSummary seat){busy=true;error=null;var result=await Api.PutAsync<LobbyDetails>($"api/lobbies/{MatchId}/seats/{seat.SeatIndex}",new UpdateLobbySeatRequest("open"));busy=false;if(result.Payload?.Ok==true)lobby=result.Payload.Data;else error=result.Payload?.Error?.Message??"The seat could not be removed.";}
 private async Task AskCloseLobby(){error=null;notice=null;var confirmed=await Dialogs.ShowMessageBoxAsync("Close this waiting lobby?","The room never started, so it has no campaign save or analytics to preserve. Closing removes it and immediately frees one of your waiting-lobby slots.",yesText:"Close lobby",noText:"Keep lobby",options:ConfirmationDialogOptions);if(confirmed==true)await CloseLobby();}
 private async Task CloseLobby(){busy=true;error=null;var result=await Api.PostAsync<bool>($"api/lobbies/{MatchId}/close",new{});busy=false;if(result.Payload?.Ok==true)Navigation.NavigateTo("lobbies");else error=result.Payload?.Error?.Message??"The waiting lobby could not be closed.";}
 private async Task Lifecycle(string action){busy=true;error=null;var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/lifecycle",new MatchLifecycleRequest(action));busy=false;if(result.Payload?.Ok==true)lobby=result.Payload.Data;else error=result.Payload?.Error?.Message??$"The {action} operation failed.";}
 private Task Checkpoint()=>Lifecycle("checkpoint");
 private Task Recover()=>Lifecycle("recover");
 private string OperationConfirmation=>confirmOperation switch{"end_match"=>"The platform will wait for a verified checkpoint, stop every managed AI and game worker, then place the campaign in completed history. It cannot be resumed afterward.","end_parked"=>"This safely parked campaign will be marked complete. Its history and analytics remain, but Resume will no longer be available.","end_error"=>"This permanently closes the failed campaign. Its history and incident record remain, but it can no longer be resumed.",_=>"The platform will wait for a verified checkpoint, stop every managed AI and game worker, and keep the campaign ready to resume later."};
 private async Task AskManagedOperation(string kind){confirmOperation=kind;error=null;notice=null;var ending=kind.StartsWith("end",StringComparison.Ordinal);var confirmed=await Dialogs.ShowMessageBoxAsync(ending?"End this campaign?":"Stop and park this campaign?",OperationConfirmation,yesText:ending?"End campaign":"Stop & park",noText:"Cancel",options:ConfirmationDialogOptions);if(confirmed==true)await ConfirmManagedOperation();else confirmOperation=null;}
 private async Task AskIncidentRetry(){if(lobby?.NeedsAttention is null||!lobby.CanManage)return;error=null;notice=null;var confirmed=await Dialogs.ShowMessageBoxAsync("Retry this paused AI from its checkpoint?","The platform will queue a durable recovery, stop the preserved session, rebuild its managed worker, bridge, and MCP from the current images, then restore the last verified checkpoint. You may navigate away while it runs.",yesText:"Queue checkpoint recovery",noText:"Keep paused",options:ConfirmationDialogOptions);if(confirmed!=true)return;busy=true;var incidentId=lobby.NeedsAttention.IncidentId;var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/lifecycle",new MatchLifecycleRequest("retry-after-update",IncidentId:incidentId));busy=false;if(result.Payload?.Ok==true){lobby=result.Payload.Data;notice="Recovery is queued and will continue in the background. This page updates automatically.";}else error=result.Payload?.Error?.Message??"The recovery attempt stayed safely paused.";await Refresh();}
 private async Task ConfirmManagedOperation(){var kind=confirmOperation;confirmOperation=null;if(kind is null)return;busy=true;error=null;notice=null;if(kind is "end_parked" or "end_error"){var ended=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/lifecycle",new MatchLifecycleRequest("end"));if(ended.Payload?.Ok==true){lobby=ended.Payload.Data;notice="Campaign ended. Its history and analytics remain in the archive.";}else error=ended.Payload?.Error?.Message??"The campaign could not be ended.";}else{var proposed=await Api.PostAsync<GovernanceProposal>($"api/lobbies/{MatchId}/governance",new CreateGovernanceProposalRequest(kind,"{}",180));if(proposed.Payload?.Ok==true)notice=proposed.Payload.Data?.Status=="approved"?"No human vote is required. The platform is waiting for the next safe checkpoint.":"The player vote is open. The operation starts only if it is approved.";else error=proposed.Payload?.Error?.Message??"The managed operation could not be requested.";}busy=false;await Refresh();}
 private void EditSeat(LobbySeatSummary seat,string? controller=null){editingSeat=seat;editController=controller??seat.ControllerKind;editAgentId=seat.AgentId??catalog?.Agents.FirstOrDefault()?.Id??"";editPlayerHandle=seat.ControllerKind=="human"?seat.PlayerHandle??"":"";editJoinMode=seat.JoinMode??"browser";editFactionId=seat.RequestedFactionId??FactionCatalog.Random;editPersonalityId=seat.RequestedPersonalityId;}
 private void CloseSeatEditor()=>editingSeat=null;
 private void EditFactionChanged(string value){editFactionId=value;if(value==FactionCatalog.Random&&editPersonalityId is not("none" or "standard" or "random"))editPersonalityId="standard";}
 private bool FactionReservedByAnotherSeat(string factionId)=>lobby?.Seats.Any(seat=>seat.SeatIndex!=editingSeat?.SeatIndex&&seat.ControllerKind!="open"&&string.Equals(seat.RequestedFactionId,factionId,StringComparison.OrdinalIgnoreCase))==true;
 private IReadOnlyList<PersonalityCatalogItem> EditPersonalityOptions=>editFactionId==FactionCatalog.Random?(personalities?.PersonalityModes??[]).Where(item=>item.Id is "none" or "standard" or "random").ToArray():(personalities?.BuiltInCards??[]).Where(item=>item.FactionId==editFactionId).Concat((personalities?.PersonalityModes??[]).Where(item=>item.Id is "random" or "none")).ToArray();
 private static string PersonalityLabel(PersonalityCatalogItem item)=>item.Id=="standard"&&!item.DisplayName.StartsWith("Standard",StringComparison.OrdinalIgnoreCase)?$"Standard — {item.DisplayName}":item.DisplayName;
 private async Task SaveSeat(){if(editingSeat is null)return;busy=true;error=null;var request=new UpdateLobbySeatRequest(editController,string.IsNullOrWhiteSpace(editAgentId)?null:editAgentId,string.IsNullOrWhiteSpace(editPlayerHandle)?null:editPlayerHandle,editJoinMode,editFactionId,editPersonalityId);var result=await Api.PutAsync<LobbyDetails>($"api/lobbies/{MatchId}/seats/{editingSeat.SeatIndex}",request);busy=false;if(result.Payload?.Ok==true){lobby=result.Payload.Data;editingSeat=null;}else error=result.Payload?.Error?.Message??"The seat could not be updated.";}
 private static string SeatIcon(string kind)=>kind switch{"agent"=>Icons.Material.Filled.SmartToy,"human"=>Icons.Material.Filled.Person,"native"=>Icons.Material.Filled.Computer,"open"=>Icons.Material.Filled.Add,_=>Icons.Material.Filled.QuestionMark};
 private static string SeatName(LobbySeatSummary seat)=>seat.ControllerKind switch{"open"=>"Open seat","agent"=>seat.PlayerHandle??"AI player","native"=>seat.PlayerHandle??"Native bot",_=>seat.PlayerHandle??"Human player"};
 private static string SeatDetail(LobbySeatSummary seat)=>seat.ControllerKind switch{"open"=>"Available to join","agent"=>AgentSeatDetail(seat),"native"=>$"Game-controlled opponent · {FactionLabel(seat)}",_=>FactionLabel(seat)};
 private static string FactionLabel(LobbySeatSummary seat)=>seat.FactionName??FactionCatalog.Find(seat.ResolvedFactionKey??seat.RequestedFactionId)?.FactionName??"Random faction";
 private static string AgentSeatDetail(LobbySeatSummary seat){var faction=seat.FactionName??FactionCatalog.Find(seat.ResolvedFactionKey??seat.RequestedFactionId)?.FactionName??"Random faction";var personality=seat.PersonalityName??BuiltInPersonalityCatalog.FindMode(seat.RequestedPersonalityId)?.DisplayName??"Standard";return $"{faction} · {personality}";}
 private static bool IsCapabilityGap(CapabilityGapIncident incident)=>incident.IncidentKind.StartsWith("capability_gap:",StringComparison.Ordinal);
 private static string YesNo(bool value)=>value?"Enabled":"Disabled";
 private static string FormatCountdown(int seconds)=>$"{seconds/60}:{seconds%60:00}";
 private static string StagingCountdown(DateTimeOffset expiresAt){var seconds=Math.Max(0,(int)Math.Ceiling((expiresAt-DateTimeOffset.UtcNow).TotalSeconds));return $"0:{seconds:00}";}
 private static string Humanize(string value)=>string.Concat(value.Select((character,index)=>index>0&&char.IsUpper(character)?$" {character}":character.ToString()));
 private static string StatusLabel(string status)=>status switch{"waiting"=>"WAITING FOR PLAYERS","running"=>"IN PROGRESS","parked"=>"PARKED","completed"=>"COMPLETED","provisioning" or "starting"=>"STARTING","lobby"=>"WAITING FOR NATIVE PLAYERS","recovering"=>"RESUMING",_=>status.ToUpperInvariant()};
 private static string HeaderKicker(string status)=>status switch{"waiting"=>"STAGING LOBBY","running"=>"LIVE CAMPAIGN","parked"=>"PARKED CAMPAIGN","completed"=>"CAMPAIGN ARCHIVE","provisioning" or "starting" or "lobby"=>"LAUNCHING CAMPAIGN","recovering"=>"RECOVERING CAMPAIGN",_=>"CAMPAIGN"};
 private static string HeaderDescription(string status,bool needsAttention)=>needsAttention?"Autonomous play is stopped and a durable operator incident requires review. Recovery is offered only when a coherent, bridge-verified checkpoint exists.":status switch{"waiting"=>"Review the seven faction seats, invite players, and start when everyone is ready.","running"=>"The campaign is live. AI-only matches continue unattended until you park or end them here.","parked"=>"The campaign is safely stored. Resume is available when its native state and AI memory share a verified checkpoint.","completed"=>"This campaign is finished. Its historical settings, events, outcomes, and analytics remain available for review.","provisioning" or "starting"=>"Docker is preparing the native game, managed seats, streams, and semantic agent connections.","recovering"=>"The platform is restoring the last verified checkpoint and reconnecting every managed seat.",_=>"Manage this campaign and its players."};
 private static DialogOptions ConfirmationDialogOptions=>new(){CloseButton=true,BackdropClick=false,MaxWidth=MaxWidth.Small,FullWidth=true};
 public async ValueTask DisposeAsync(){refreshCancellation?.Cancel();refreshCancellation?.Dispose();refreshCancellation=null;refreshTimer?.Dispose();refreshTimer=null;if(hub is not null)await hub.DisposeAsync();}
}
