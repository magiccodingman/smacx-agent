@page "/lobbies/{MatchId}"
@implements IAsyncDisposable
@inject Services.PortalApiClient Api
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.SignalR.Client
<PageTitle>@(lobby?.DisplayName ?? "Lobby") · SMACX Agent</PageTitle>
@if (loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary"/> }
else if (lobby is null) { <div class="empty-state surface-panel"><h2>Lobby unavailable</h2><p>@error</p><MudButton Href="lobbies">Back to lobbies</MudButton></div> }
else
{
 <PageHeader Kicker="LAN LOBBY" Title="@lobby.DisplayName" Description="@($"Match {lobby.MatchId}")"><div class="lobby-header-actions"><span class="lobby-state @lobby.Status">@lobby.Status</span>@if(lobby.CanManage&&lobby.Status=="waiting"){<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="busy" OnClick="Start">Provision match</MudButton>}@if(lobby.CanManage&&lobby.Status=="running"){<MudButton Variant="Variant.Outlined" Disabled="busy" OnClick="Checkpoint">Checkpoint</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="busy" OnClick="Park">Park</MudButton>}@if(lobby.CanManage&&(lobby.Status=="parked"||lobby.Status=="error")){<MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="Recover">Recover</MudButton>}</div></PageHeader>
 <div class="lobby-detail-grid"><section class="surface-panel seats-panel"><div class="panel-heading"><div><span class="panel-kicker">SEAT ASSIGNMENTS</span><h2>Players</h2></div><span class="unranked-chip">UNRANKED</span></div><div class="seat-list">@foreach(var seat in lobby.Seats){<div class="seat-row @seat.ControllerKind"><span class="seat-number">@(seat.SeatIndex+1)</span><span class="seat-avatar"><MudIcon Icon="@SeatIcon(seat.ControllerKind)"/></span><span class="seat-name"><strong>@SeatName(seat)</strong><small>@SeatDetail(seat)</small></span>@if(seat.CanJoin){<MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="busy" OnClick="() => Join(seat.SeatIndex)">Join</MudButton>}else if(seat.CanControl&&seat.InstanceId is not null){<MudButton Href="@($"/play/{lobby.MatchId}/{seat.SeatIndex}")" Target="_blank" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SportsEsports">Play</MudButton>}else if(seat.CanSpectate&&seat.InstanceId is not null){<MudButton Href="@($"/spectate/{lobby.MatchId}?seat={seat.SeatIndex}")" Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility">Watch</MudButton>}<span class="seat-status">@seat.Status</span></div>}</div>@if(lobby.Seats.Any(seat=>seat.CanSpectate)){<MudButton Href="@($"/spectate/{lobby.MatchId}")" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.GridView" Class="mt-3">Open observation deck</MudButton>}</section>
 <aside class="lobby-side"><section class="surface-panel match-rules"><span class="panel-kicker">MATCH POLICY</span><h2>Session details</h2><dl><div><dt>Ruleset</dt><dd>@lobby.RulesetId</dd></div><div><dt>Mode</dt><dd>@lobby.Mode</dd></div><div><dt>Turn / year</dt><dd>@(lobby.CurrentTurn?.ToString()??"—") / @(lobby.CurrentYear?.ToString()??"—")</dd></div><div><dt>Managed only</dt><dd>@YesNo(lobby.ManagedClientsOnly)</dd></div><div><dt>Anonymous spectators</dt><dd>@YesNo(lobby.AllowAnonymousSpectators)</dd></div><div><dt>Graphiti memory</dt><dd>@YesNo(lobby.GraphitiEnabled)</dd></div><div><dt>Personality</dt><dd>None</dd></div></dl>@if(lobby.NativeJoin is not null){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3"><strong>Native clients may join now</strong><br/>TCP/IP host: <code>@lobby.NativeJoin.HostAddress</code><br/>Session: <code>@lobby.NativeJoin.SessionName</code>@foreach(var player in lobby.NativeJoin.Players){<br/><span>Seat @(player.SeatIndex+1): use handle <code>@player.PlayerName</code>@if(player.ExpectedFactionId is not null){<text> · faction @player.ExpectedFactionId</text>}</span>}</MudAlert>}<MudExpansionPanels Elevation="0" Class="mt-3"><MudExpansionPanel Text="Native game settings">@foreach(var setting in lobby.Settings){<div class="setting-row"><span>@Humanize(setting.Key)</span><strong>@setting.Value</strong></div>}</MudExpansionPanel></MudExpansionPanels></section>
 <section class="surface-panel chat-panel"><div class="panel-heading"><div><span class="panel-kicker">LOBBY COMMS</span><h2>Chat</h2></div><span class="live-dot">LIVE</span></div><div class="chat-log">@if(messages.Count==0){<span class="chat-empty">No messages yet.</span>}@foreach(var message in messages){<div class="chat-message"><strong>@message.SenderHandle</strong><span>@message.CreatedAt.ToLocalTime().ToString("t")</span>@if(message.DeliveredToGame){<span class="native-delivered">IN GAME</span>}@if(message.RecipientFactionId>0){<span class="native-delivered">PRIVATE → F@message.RecipientFactionId</span>}<p>@message.Content</p></div>}</div><AuthorizeView><Authorized><MudSelect T="int" @bind-Value="recipientFactionId" Label="Recipient" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="int" Value="0">Everyone</MudSelectItem>@foreach(var seat in lobby.Seats.Where(s=>s.FactionId is not null).DistinctBy(s=>s.FactionId)){<MudSelectItem T="int" Value="@seat.FactionId!.Value">@(seat.PlayerHandle??seat.FactionName??$"Faction {seat.FactionId}")</MudSelectItem>}</MudSelect><div class="chat-compose"><MudTextField @bind-Value="draft" Placeholder="Message the lobby…" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" OnKeyDown="ChatKey"/><MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" OnClick="Send" Disabled="@string.IsNullOrWhiteSpace(draft)"/></div></Authorized><NotAuthorized><div class="chat-signin">Sign in to speak in the lobby.</div></NotAuthorized></AuthorizeView></section></aside></div>
 @if(!string.IsNullOrEmpty(error)){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>}
}
@code {
 [Parameter] public string MatchId {get;set;}=""; private LobbyDetails? lobby; private List<LobbyMessage> messages=[]; private string draft=""; private int recipientFactionId; private string? error; private bool loading=true; private bool busy; private HubConnection? hub;
 protected override async Task OnInitializedAsync(){await Refresh();try{hub=new HubConnectionBuilder().WithUrl(Navigation.ToAbsoluteUri("hubs/lobby")).WithAutomaticReconnect().Build();hub.On<LobbyMessage>("LobbyMessage",m=>InvokeAsync(()=>{messages.Add(m);StateHasChanged();}));hub.On<string>("LobbyChanged",_=>InvokeAsync(Refresh));await hub.StartAsync();await hub.InvokeAsync("JoinLobby",MatchId);}catch(Exception){hub=null;}loading=false;}
 private async Task Refresh(){try{lobby=(await Api.GetAsync<LobbyDetails>($"api/lobbies/{MatchId}"))?.Data;messages=((await Api.GetAsync<IReadOnlyList<LobbyMessage>>($"api/lobbies/{MatchId}/messages"))?.Data??[]).ToList();}catch(HttpRequestException){error="The lobby could not be loaded.";}StateHasChanged();}
 private async Task Start(){busy=true;error=null;var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/start",new{});busy=false;if(result.Payload?.Ok==true)lobby=result.Payload.Data;else error=result.Payload?.Error?.Message??"The match could not be provisioned.";}
 private async Task Join(int seatIndex){busy=true;error=null;var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/join",new JoinLobbyRequest(seatIndex,"browser"));busy=false;if(result.Payload?.Ok==true)lobby=result.Payload.Data;else error=result.Payload?.Error?.Message??"The seat could not be claimed.";}
 private async Task Lifecycle(string action){busy=true;error=null;var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/lifecycle",new MatchLifecycleRequest(action));busy=false;if(result.Payload?.Ok==true)lobby=result.Payload.Data;else error=result.Payload?.Error?.Message??$"The {action} operation failed.";}
 private Task Checkpoint()=>Lifecycle("checkpoint");
 private Task Park()=>Lifecycle("park");
 private Task Recover()=>Lifecycle("recover");
 private async Task Send(){var text=draft.Trim();if(text.Length==0)return;draft="";var result=await Api.PostAsync<LobbyMessage>($"api/lobbies/{MatchId}/messages",new SendLobbyMessageRequest(text,recipientFactionId));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message??"Message failed.";}
 private async Task ChatKey(KeyboardEventArgs args){if(args.Key=="Enter"&&!args.ShiftKey)await Send();}
 private static string SeatIcon(string kind)=>kind switch{"agent"=>Icons.Material.Filled.SmartToy,"human"=>Icons.Material.Filled.Person,"native"=>Icons.Material.Filled.Computer,"open"=>Icons.Material.Filled.Add,_=>Icons.Material.Filled.QuestionMark};
 private static string SeatName(LobbySeatSummary seat)=>seat.ControllerKind switch{"open"=>"Open seat","agent"=>seat.PlayerHandle??"AI player","native"=>seat.PlayerHandle??"Native bot",_=>seat.PlayerHandle??"Human player"};
 private static string SeatDetail(LobbySeatSummary seat)=>seat.ControllerKind switch{"open"=>"Available to join","agent"=>seat.FactionName??"Faction: random","native"=>"Game-controlled opponent",_=>seat.FactionName??"Faction: random"};
 private static string YesNo(bool value)=>value?"Enabled":"Disabled";
 private static string Humanize(string value)=>string.Concat(value.Select((character,index)=>index>0&&char.IsUpper(character)?$" {character}":character.ToString()));
 public async ValueTask DisposeAsync(){if(hub is not null)await hub.DisposeAsync();}
}
