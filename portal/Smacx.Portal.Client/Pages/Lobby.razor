@page "/lobbies/{MatchId}"
@implements IAsyncDisposable
@inject Services.PortalApiClient Api
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.SignalR.Client
<PageTitle>@(lobby?.DisplayName ?? "Lobby") · SMACX Agent</PageTitle>
@if (loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary"/> }
else if (lobby is null) { <div class="empty-state surface-panel"><h2>Lobby unavailable</h2><p>@error</p><MudButton Href="lobbies">Back to lobbies</MudButton></div> }
else
{
 <PageHeader Kicker="@HeaderKicker(lobby.Status)" Title="@lobby.DisplayName" Description="@HeaderDescription(lobby.Status)"><div class="lobby-header-actions"><span class="lobby-state @lobby.Status">@StatusLabel(lobby.Status)</span>@if(lobby.CanManage&&lobby.Status=="waiting"){<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="busy" OnClick="Start">Start match</MudButton>}@if(lobby.CanManage&&lobby.Status=="running"){<MudButton Variant="Variant.Outlined" Disabled="busy" OnClick="Checkpoint">Save checkpoint</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="busy" OnClick="@(()=>AskManagedOperation("park_match"))">Park for later</MudButton><MudButton Variant="Variant.Text" Color="Color.Error" Disabled="busy" OnClick="@(()=>AskManagedOperation("end_match"))">End campaign</MudButton>}@if(lobby.CanManage&&(lobby.Status=="parked"||lobby.Status=="error")){<MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="Recover">Resume campaign</MudButton>}@if(lobby.CanManage&&lobby.Status=="parked"){<MudButton Variant="Variant.Text" Color="Color.Error" Disabled="busy" OnClick="@(()=>AskManagedOperation("end_parked"))">End permanently</MudButton>}</div></PageHeader>
 @if(lobby.Status=="waiting"&&lobby.Seats.Count(seat=>seat.ControllerKind=="open") is var openCount&&openCount>0){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4"><strong>@openCount open @(openCount==1?"seat":"seats")</strong><br/>When the owner starts, every still-open faction becomes a stock computer player. Human and AI assignments remain unchanged.</MudAlert>}
 @if(lobby.Presence?.State is "idle_grace_period" or "awaiting_first_connection" or "checkpoint_pending")
 {
  <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
   <strong>@lobby.Presence.Summary</strong>
   @if(lobby.Presence.SecondsUntilParking is > 0){<text><br/>Safe parking begins in @FormatCountdown(lobby.Presence.SecondsUntilParking.Value) unless a browser player reconnects.</text>}
  </MudAlert>
 }
 <div class="lobby-detail-grid"><section class="surface-panel seats-panel"><div class="panel-heading"><div><span class="panel-kicker">SEAT ASSIGNMENTS</span><h2>Players</h2></div><span class="unranked-chip">UNRANKED</span></div><div class="seat-list">@foreach(var seat in lobby.Seats){<div class="seat-row @seat.ControllerKind"><span class="seat-number">@(seat.SeatIndex+1)</span><span class="seat-avatar"><MudIcon Icon="@SeatIcon(seat.ControllerKind)"/></span><span class="seat-name"><strong>@SeatName(seat)</strong><small>@SeatDetail(seat)</small></span>@if(lobby.CanManage&&lobby.Status=="waiting"){<MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Edit" OnClick="() => EditSeat(seat)">Configure</MudButton>}@if(seat.CanJoin){<MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="busy" OnClick="() => Join(seat.SeatIndex)">Join</MudButton>}else if(seat.CanControl&&seat.InstanceId is not null){<MudButton Href="@($"/play/{lobby.MatchId}/{seat.SeatIndex}")" Target="_blank" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SportsEsports">Play</MudButton>}else if(seat.CanSpectate&&seat.InstanceId is not null){<MudButton Href="@($"/spectate/{lobby.MatchId}?seat={seat.SeatIndex}")" Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility">Watch</MudButton>}<span class="seat-status">@seat.Status</span></div>}</div>
 @if(editingSeat is not null){<div class="staging-seat-editor"><div class="panel-heading"><div><span class="panel-kicker">CONFIGURE SEAT @(editingSeat.SeatIndex+1)</span><h3>@SeatName(editingSeat)</h3></div><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseSeatEditor"/></div><MudSelect T="string" @bind-Value="editController" Label="Seat type" Variant="Variant.Outlined"><MudSelectItem Value="@("open")">Open for someone to join</MudSelectItem><MudSelectItem Value="@("human")">Reserved human player</MudSelectItem><MudSelectItem Value="@("agent")">AI player</MudSelectItem><MudSelectItem Value="@("native")">Stock computer player</MudSelectItem></MudSelect>@if(editController=="agent"){<MudSelect T="string" @bind-Value="editAgentId" Label="AI profile" Variant="Variant.Outlined">@foreach(var profile in catalog?.Agents??[]){<MudSelectItem Value="@profile.Id">@profile.DisplayName</MudSelectItem>}</MudSelect><div class="field-pair"><MudSelect T="string" Value="@editFactionId" ValueChanged="EditFactionChanged" Label="Faction" Variant="Variant.Outlined"><MudSelectItem Value="@FactionCatalog.Random">Random at start</MudSelectItem>@foreach(var faction in personalities?.Factions??[]){<MudSelectItem Value="@faction.Id">@faction.FactionName · @faction.LeaderName</MudSelectItem>}</MudSelect><MudSelect T="string" @bind-Value="editPersonalityId" Label="Personality" Variant="Variant.Outlined">@foreach(var option in EditPersonalityOptions){<MudSelectItem Value="@option.Id">@PersonalityLabel(option)</MudSelectItem>}</MudSelect></div>}else if(editController=="human"){<MudTextField @bind-Value="editPlayerHandle" Label="Public display name" HelperText="Leave blank to use your own account." Variant="Variant.Outlined"/><MudSelect T="string" @bind-Value="editJoinMode" Label="Play using" Variant="Variant.Outlined"><MudSelectItem Value="@("browser")">This browser</MudSelectItem><MudSelectItem Value="@("native")">A separate game client</MudSelectItem></MudSelect>}<div class="staging-editor-actions"><MudButton Variant="Variant.Text" OnClick="CloseSeatEditor">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="SaveSeat">Save seat</MudButton></div></div>}
 @if(lobby.Seats.Any(seat=>seat.CanSpectate)){<MudButton Href="@($"/spectate/{lobby.MatchId}")" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.GridView" Class="mt-3">Open observation deck</MudButton>}</section>
 <aside class="lobby-side"><section class="surface-panel match-rules"><span class="panel-kicker">MATCH POLICY</span><h2>Session details</h2><dl><div><dt>Ruleset</dt><dd>@lobby.RulesetId</dd></div><div><dt>Mode</dt><dd>@lobby.Mode</dd></div><div><dt>Turn / year</dt><dd>@(lobby.CurrentTurn?.ToString()??"—") / @(lobby.CurrentYear?.ToString()??"—")</dd></div><div><dt>Managed only</dt><dd>@YesNo(lobby.ManagedClientsOnly)</dd></div><div><dt>Anonymous spectators</dt><dd>@YesNo(lobby.AllowAnonymousSpectators)</dd></div><div><dt>Graphiti memory</dt><dd>@YesNo(lobby.GraphitiEnabled)</dd></div></dl>@if(lobby.NativeJoin is not null){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3"><strong>Native clients may join now</strong><br/>TCP/IP host: <code>@lobby.NativeJoin.HostAddress</code><br/>Session: <code>@lobby.NativeJoin.SessionName</code>@foreach(var player in lobby.NativeJoin.Players){<br/><span>Seat @(player.SeatIndex+1): use public display name <code>@player.PlayerName</code>@if(player.ExpectedFactionId is not null){<text> · faction @player.ExpectedFactionId</text>}</span>}</MudAlert>}<MudExpansionPanels Elevation="0" Class="mt-3"><MudExpansionPanel Text="Native game settings">@foreach(var setting in lobby.Settings){<div class="setting-row"><span>@Humanize(setting.Key)</span><strong>@setting.Value</strong></div>}</MudExpansionPanel></MudExpansionPanels></section>
 <section class="surface-panel chat-panel"><div class="panel-heading"><div><span class="panel-kicker">LOBBY COMMS</span><h2>Chat</h2></div><span class="live-dot">@(lobby.Status=="completed"?"ARCHIVE":"LIVE")</span></div><p class="section-copy">@(lobby.Status=="completed"?"The campaign's public and private message history is retained for review.":"Lobby members can coordinate here. Messages from a browser-controlled faction also cross into the native game; observer messages remain in the lobby.")</p><div class="chat-log">@if(messages.Count==0){<span class="chat-empty">No messages yet.</span>}@foreach(var message in messages){<div class="chat-message"><strong>@message.SenderHandle</strong><span>@message.CreatedAt.ToLocalTime().ToString("t")</span>@if(message.DeliveredToGame){<span class="native-delivered">IN GAME</span>}else if(lobby.Status=="running"){<span class="portal-only">LOBBY ONLY</span>}@if(message.RecipientFactionId>0){<span class="native-delivered">PRIVATE → F@message.RecipientFactionId</span>}<p>@message.Content</p></div>}</div>@if(lobby.Status!="completed"){<AuthorizeView><Authorized><MudSelect T="int" @bind-Value="recipientFactionId" Label="Recipient" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="int" Value="0">Everyone</MudSelectItem>@foreach(var seat in lobby.Seats.Where(s=>s.FactionId is not null).DistinctBy(s=>s.FactionId)){<MudSelectItem T="int" Value="@seat.FactionId!.Value">@(seat.PlayerHandle??seat.FactionName??$"Faction {seat.FactionId}")</MudSelectItem>}</MudSelect><div class="chat-compose"><MudTextField @bind-Value="draft" Placeholder="Message the lobby…" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" OnKeyDown="ChatKey"/><MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" OnClick="Send" Disabled="@string.IsNullOrWhiteSpace(draft)"/></div></Authorized><NotAuthorized><div class="chat-signin">Sign in to speak in the lobby.</div></NotAuthorized></AuthorizeView>}</section></aside></div>
 @if(!string.IsNullOrEmpty(notice)){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">@notice</MudAlert>}
 @if(!string.IsNullOrEmpty(error)){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>}
 @if(lobby.NeedsAttention is not null&&dismissedIncidentId!=lobby.NeedsAttention.IncidentId){<CapabilityGapDialog Incident="lobby.NeedsAttention" MatchId="@MatchId" Dismissed="DismissIncident"/>}
 @if(confirmOperation is not null){<div class="platform-scrim"></div><div class="confirm-card"><h2>@(confirmOperation.StartsWith("end",StringComparison.Ordinal)?"End this campaign?":"Park this campaign for later?")</h2><p>@OperationConfirmation</p><div><MudButton OnClick="@(()=>confirmOperation=null)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="@(confirmOperation.StartsWith("end",StringComparison.Ordinal)?Color.Error:Color.Warning)" Disabled="busy" OnClick="ConfirmManagedOperation">@(confirmOperation.StartsWith("end",StringComparison.Ordinal)?"End campaign":"Park safely")</MudButton></div></div>}
}
@code {
 [Parameter] public string MatchId {get;set;}=""; private LobbyDetails? lobby; private LobbyCatalog? catalog; private FactionPersonalityCatalog? personalities; private LobbySeatSummary? editingSeat; private List<LobbyMessage> messages=[]; private string draft="",editController="open",editAgentId="",editPlayerHandle="",editJoinMode="browser",editFactionId=FactionCatalog.Random,editPersonalityId="standard"; private int recipientFactionId; private string? error,notice,confirmOperation,dismissedIncidentId; private bool loading=true; private bool busy; private HubConnection? hub;private PeriodicTimer? refreshTimer;private CancellationTokenSource? refreshCancellation;
 protected override async Task OnInitializedAsync(){await Refresh();catalog=(await Api.GetAsync<LobbyCatalog>("api/catalog/lobby"))?.Data;personalities=(await Api.GetAsync<FactionPersonalityCatalog>("api/catalog/factions-personalities"))?.Data;editAgentId=catalog?.Agents.FirstOrDefault()?.Id??"";try{hub=new HubConnectionBuilder().WithUrl(Navigation.ToAbsoluteUri("hubs/lobby")).WithAutomaticReconnect().Build();hub.On<LobbyMessage>("LobbyMessage",m=>InvokeAsync(()=>{messages.Add(m);StateHasChanged();}));hub.On<string>("LobbyChanged",_=>InvokeAsync(Refresh));hub.On<GovernanceProposal>("GovernanceChanged",_=>InvokeAsync(Refresh));await hub.StartAsync();await hub.InvokeAsync("JoinLobby",MatchId);}catch(Exception){hub=null;}refreshCancellation=new();refreshTimer=new(TimeSpan.FromSeconds(5));_=RefreshPresence(refreshCancellation.Token);loading=false;}
 private async Task RefreshPresence(CancellationToken cancellationToken){try{while(refreshTimer is not null&&await refreshTimer.WaitForNextTickAsync(cancellationToken)){try{var latest=(await Api.GetAsync<LobbyDetails>($"api/lobbies/{MatchId}",cancellationToken))?.Data;if(latest is not null)lobby=latest;await InvokeAsync(StateHasChanged);}catch(Exception)when(!cancellationToken.IsCancellationRequested){}}}catch(OperationCanceledException)when(cancellationToken.IsCancellationRequested){}}
 private async Task Refresh(){try{lobby=(await Api.GetAsync<LobbyDetails>($"api/lobbies/{MatchId}"))?.Data;messages=((await Api.GetAsync<IReadOnlyList<LobbyMessage>>($"api/lobbies/{MatchId}/messages"))?.Data??[]).ToList();}catch(HttpRequestException){error="The lobby could not be loaded.";}StateHasChanged();}
 private async Task Start(){busy=true;error=null;var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/start",new{});busy=false;if(result.Payload?.Ok==true)lobby=result.Payload.Data;else error=result.Payload?.Error?.Message??"The match could not be provisioned.";}
 private async Task Join(int seatIndex){busy=true;error=null;var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/join",new JoinLobbyRequest(seatIndex,"browser"));busy=false;if(result.Payload?.Ok==true)lobby=result.Payload.Data;else error=result.Payload?.Error?.Message??"The seat could not be claimed.";}
 private async Task Lifecycle(string action){busy=true;error=null;var result=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/lifecycle",new MatchLifecycleRequest(action));busy=false;if(result.Payload?.Ok==true)lobby=result.Payload.Data;else error=result.Payload?.Error?.Message??$"The {action} operation failed.";}
 private Task Checkpoint()=>Lifecycle("checkpoint");
 private Task Recover()=>Lifecycle("recover");
 private string OperationConfirmation=>confirmOperation switch{"end_match"=>"The platform will wait for a verified checkpoint, stop every managed AI and game worker, then place the campaign in completed history. It cannot be resumed afterward.","end_parked"=>"This safely parked campaign will be marked complete. Its history and analytics remain, but Resume will no longer be available.",_=>"The platform will wait for a verified checkpoint, stop every managed AI and game worker, and keep the campaign ready to resume later."};
 private void AskManagedOperation(string kind){confirmOperation=kind;error=null;notice=null;}
 private void DismissIncident(){dismissedIncidentId=lobby?.NeedsAttention?.IncidentId;}
 private async Task ConfirmManagedOperation(){var kind=confirmOperation;confirmOperation=null;if(kind is null)return;busy=true;error=null;notice=null;if(kind=="end_parked"){var ended=await Api.PostAsync<LobbyDetails>($"api/lobbies/{MatchId}/lifecycle",new MatchLifecycleRequest("end"));if(ended.Payload?.Ok==true){lobby=ended.Payload.Data;notice="Campaign ended. Its history and analytics remain in the archive.";}else error=ended.Payload?.Error?.Message??"The campaign could not be ended.";}else{var proposed=await Api.PostAsync<GovernanceProposal>($"api/lobbies/{MatchId}/governance",new CreateGovernanceProposalRequest(kind,"{}",180));if(proposed.Payload?.Ok==true)notice=proposed.Payload.Data?.Status=="approved"?"No human vote is required. The platform is waiting for the next safe checkpoint.":"The player vote is open. The operation starts only if it is approved.";else error=proposed.Payload?.Error?.Message??"The managed operation could not be requested.";}busy=false;await Refresh();}
 private async Task Send(){var text=draft.Trim();if(text.Length==0)return;draft="";var result=await Api.PostAsync<LobbyMessage>($"api/lobbies/{MatchId}/messages",new SendLobbyMessageRequest(text,recipientFactionId));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message??"Message failed.";}
 private async Task ChatKey(KeyboardEventArgs args){if(args.Key=="Enter"&&!args.ShiftKey)await Send();}
 private void EditSeat(LobbySeatSummary seat){editingSeat=seat;editController=seat.ControllerKind;editAgentId=seat.AgentId??catalog?.Agents.FirstOrDefault()?.Id??"";editPlayerHandle=seat.ControllerKind=="human"?seat.PlayerHandle??"":"";editJoinMode=seat.JoinMode??"browser";editFactionId=seat.RequestedFactionId??FactionCatalog.Random;editPersonalityId=seat.RequestedPersonalityId;}
 private void CloseSeatEditor()=>editingSeat=null;
 private void EditFactionChanged(string value){editFactionId=value;if(value==FactionCatalog.Random&&editPersonalityId is not("none" or "standard" or "random"))editPersonalityId="standard";}
 private IReadOnlyList<PersonalityCatalogItem> EditPersonalityOptions=>editFactionId==FactionCatalog.Random?(personalities?.PersonalityModes??[]).Where(item=>item.Id is "none" or "standard" or "random").ToArray():(personalities?.BuiltInCards??[]).Where(item=>item.FactionId==editFactionId).Concat((personalities?.PersonalityModes??[]).Where(item=>item.Id is "random" or "none")).ToArray();
 private static string PersonalityLabel(PersonalityCatalogItem item)=>item.Id=="standard"&&!item.DisplayName.StartsWith("Standard",StringComparison.OrdinalIgnoreCase)?$"Standard — {item.DisplayName}":item.DisplayName;
 private async Task SaveSeat(){if(editingSeat is null)return;busy=true;error=null;var request=new UpdateLobbySeatRequest(editController,string.IsNullOrWhiteSpace(editAgentId)?null:editAgentId,string.IsNullOrWhiteSpace(editPlayerHandle)?null:editPlayerHandle,editJoinMode,editFactionId,editPersonalityId);var result=await Api.PutAsync<LobbyDetails>($"api/lobbies/{MatchId}/seats/{editingSeat.SeatIndex}",request);busy=false;if(result.Payload?.Ok==true){lobby=result.Payload.Data;editingSeat=null;}else error=result.Payload?.Error?.Message??"The seat could not be updated.";}
 private static string SeatIcon(string kind)=>kind switch{"agent"=>Icons.Material.Filled.SmartToy,"human"=>Icons.Material.Filled.Person,"native"=>Icons.Material.Filled.Computer,"open"=>Icons.Material.Filled.Add,_=>Icons.Material.Filled.QuestionMark};
 private static string SeatName(LobbySeatSummary seat)=>seat.ControllerKind switch{"open"=>"Open seat","agent"=>seat.PlayerHandle??"AI player","native"=>seat.PlayerHandle??"Native bot",_=>seat.PlayerHandle??"Human player"};
 private static string SeatDetail(LobbySeatSummary seat)=>seat.ControllerKind switch{"open"=>"Available to join","agent"=>AgentSeatDetail(seat),"native"=>"Game-controlled opponent",_=>seat.FactionName??"Faction: random"};
 private static string AgentSeatDetail(LobbySeatSummary seat){var faction=seat.FactionName??FactionCatalog.Find(seat.ResolvedFactionKey??seat.RequestedFactionId)?.FactionName??"Random faction";var personality=seat.PersonalityName??BuiltInPersonalityCatalog.FindMode(seat.RequestedPersonalityId)?.DisplayName??"Standard";return $"{faction} · {personality}";}
 private static string YesNo(bool value)=>value?"Enabled":"Disabled";
 private static string FormatCountdown(int seconds)=>$"{seconds/60}:{seconds%60:00}";
 private static string Humanize(string value)=>string.Concat(value.Select((character,index)=>index>0&&char.IsUpper(character)?$" {character}":character.ToString()));
 private static string StatusLabel(string status)=>status switch{"waiting"=>"WAITING FOR PLAYERS","running"=>"IN PROGRESS","parked"=>"PARKED","completed"=>"COMPLETED","provisioning"=>"STARTING","recovering"=>"RESUMING",_=>status.ToUpperInvariant()};
 private static string HeaderKicker(string status)=>status switch{"waiting"=>"STAGING LOBBY","running"=>"LIVE CAMPAIGN","parked"=>"PARKED CAMPAIGN","completed"=>"CAMPAIGN ARCHIVE","provisioning"=>"LAUNCHING CAMPAIGN","recovering"=>"RECOVERING CAMPAIGN",_=>"CAMPAIGN"};
 private static string HeaderDescription(string status)=>status switch{"waiting"=>"Review the seven faction seats, invite players, and start when everyone is ready.","running"=>"The campaign is live. AI-only matches continue unattended until you park or end them here.","parked"=>"The campaign is safely stored and ready to resume with the same players, models, factions, memory, and checkpoint.","completed"=>"This campaign is finished. Its historical settings, events, outcomes, and analytics remain available for review.","provisioning"=>"Docker is preparing the native game, managed seats, streams, and semantic agent connections.","recovering"=>"The platform is restoring the last verified checkpoint and reconnecting every managed seat.",_=>"Manage this campaign and its players."};
 public async ValueTask DisposeAsync(){refreshCancellation?.Cancel();refreshCancellation?.Dispose();refreshTimer?.Dispose();if(hub is not null)await hub.DisposeAsync();}
}
