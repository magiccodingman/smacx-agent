@page "/analytics"
@attribute [Authorize]
@inject Services.PortalApiClient Api
<PageTitle>Analytics · SMACX Agent</PageTitle>
<PageHeader Kicker="AFTER-ACTION INTELLIGENCE" Title="Match analytics" Description="Compare outcomes, non-errored turn timing, model usage, and recovery evidence without counting empty lobbies as human games."><MudButton Href="api/reports/analytics.csv" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download">Export CSV</MudButton></PageHeader>
@if(loading){<MudProgressLinear Indeterminate="true" Color="Color.Primary"/>}
else if(summary is not null){
<div class="metric-grid"><MetricCard Label="COMPLETED" Value="@summary.CompletedMatches" Detail="Recorded matches" Icon="@Icons.Material.Filled.Flag"/><MetricCard Label="MEDIAN TURN" Value="@(summary.MedianTurnSeconds is null?"—":$"{summary.MedianTurnSeconds:0.0}s")" Detail="Non-errored decisions" Icon="@Icons.Material.Filled.Timer" Tone="gold"/><MetricCard Label="MODEL TOKENS" Value="@(summary.PromptTokens+summary.CompletionTokens)" Detail="Hermes input + output" Icon="@Icons.Material.Filled.DataUsage" Tone="violet"/><MetricCard Label="API CALLS" Value="@summary.ApiCalls" Detail="Provider requests" Icon="@Icons.Material.Filled.Api" Tone="blue"/></div>
<section class="surface-panel admin-list-panel"><div class="panel-heading"><div><span class="panel-kicker">MODEL COMPARISON</span><h2>AI profiles</h2></div></div>@if(summary.Profiles.Count==0){<div class="empty-state compact"><MudIcon Icon="@Icons.Material.Filled.QueryStats"/><strong>No measured turns yet</strong><span>Metrics begin when an AI profile plays a managed match.</span></div>}@foreach(var row in summary.Profiles){<div class="analytics-row"><div><strong>@row.ProfileName</strong><small>@row.Model · @row.ReasoningEffort reasoning · @row.GenerationPreset · @row.ApiCalls calls</small></div><span>@row.Matches matches</span><span>@(row.ClassifiedOutcomes==0?"No classified outcomes":$"{row.Wins}/{row.ClassifiedOutcomes} wins · {row.WinRate:P0}")</span><span>@(row.MedianTurnSeconds?.ToString("0.0")??"—")s median</span><span>@(row.PromptTokens+row.CompletionTokens) tokens · @row.CacheReadTokens cached · @row.ReasoningTokens reasoning</span></div>}</section>
@if(embedding is not null){
<section class="surface-panel admin-list-panel mt-4">
 <div class="panel-heading"><div><span class="panel-kicker">EMBEDDING OBSERVATORY</span><h2>Knowledge and memory embeddings</h2></div><span class="live-dot">@(LatestQuality?.Passed==true?"AUDIT PASSED":"NEEDS REVIEW")</span></div>
 <p class="section-copy">Purpose-aware, content-free telemetry for the shared wiki and Graphiti embedding space. Effective throughput includes the complete measured operation; external token counts are marked estimated when a provider omits usage.</p>
 <div class="metric-grid">
  <MetricCard Label="EMBED CALLS" Value="@EmbeddingCalls" Detail="Across recorded purposes" Icon="@Icons.Material.Filled.Hub"/>
  <MetricCard Label="SOURCE TOKENS" Value="@EmbeddingTokens" Detail="Exact or explicitly estimated" Icon="@Icons.Material.Filled.DataObject" Tone="violet"/>
  <MetricCard Label="LAST CANARY" Value="@(LatestQuality is null?"—":$"{LatestQuality.DurationMilliseconds:0.0}ms")" Detail="End-to-end semantic audit" Icon="@Icons.Material.Filled.Speed" Tone="gold"/>
  <MetricCard Label="ERRORS" Value="@EmbeddingErrors" Detail="Inference and pipeline failures" Icon="@Icons.Material.Filled.HealthAndSafety" Tone="blue"/>
 </div>
 <div class="analytics-row"><div><strong>@embedding.Configuration.ModelId</strong><small>@embedding.Configuration.Mode · @embedding.Configuration.Dimensions dimensions · @embedding.Configuration.SharedModelInstances shared local instance(s)</small></div><span>Embedding space<br/><code>@ShortSpace</code></span><span>Inputs are not retained</span><span>Vectors are not retained</span></div>
 @if(embedding.Purposes.Count==0){<div class="empty-state compact"><MudIcon Icon="@Icons.Material.Filled.MonitorHeart"/><strong>No embedding work recorded yet</strong><span>The first wiki refresh, search, Graphiti operation, or quality canary will appear here.</span></div>}
 @foreach(var row in embedding.Purposes.OrderBy(item=>item.Purpose)){
  <div class="analytics-row"><div><strong>@PurposeName(row.Purpose)</strong><small>@row.ModelId · @TokenKind(row.TokenCountKind)</small></div><span>@row.Calls calls<br/>@row.Inputs @(IsCorpusSync(row.Purpose)?"changed docs":"inputs")</span><span>@row.InputTokens tokens<br/>@(IsCorpusSync(row.Purpose)?"SemanticKnowledge sync":$"{row.Vectors} vectors")</span><span>@row.AverageDurationMilliseconds.ToString("0.0")ms avg<br/>@row.MaximumDurationMilliseconds.ToString("0.0")ms max</span><span>@row.EffectiveTokensPerSecond.ToString("0") effective tok/s<br/>@row.Errors errors</span></div>
 }
 @if(LatestQuality is not null){<div class="quality-audit-card"><div><span class="panel-kicker">LATEST QUALITY CANARY</span><h3>@(LatestQuality.Passed?"Embedding space passed":"Embedding space needs review")</h3><small>@LatestQuality.CreatedAt.ToLocalTime().ToString("g") · @LatestQuality.DurationMilliseconds.ToString("0.0")ms · retrieved @LatestQuality.SearchTopTitle</small></div><div class="quality-checks">@foreach(var check in LatestQuality.Checks){<MudChip T="string" Size="Size.Small" Color="@(check.Value?Color.Success:Color.Error)" Variant="Variant.Outlined">@CheckName(check.Key)</MudChip>}</div><div class="quality-values"><span>Related @LatestQuality.RelatedSimilarity.ToString("0.000")</span><span>Unrelated @LatestQuality.UnrelatedSimilarity.ToString("0.000")</span><span>Margin @LatestQuality.SemanticMargin.ToString("0.000")</span><span>Repeat @LatestQuality.RepeatSimilarity.ToString("0.0000")</span></div></div>}
 <p class="section-copy">Privacy boundary: no prompt text, wiki prose, vectors, provider credentials, chat, or model reasoning is stored in this audit.</p>
</section>}
<AuthorizeView Roles="Administrator"><section class="surface-panel form-panel mt-4"><span class="panel-kicker">SANITIZED REPORT LAB</span><h2>Read-only SQL</h2><p class="section-copy">Query an isolated copy containing only <code>matches</code>, <code>turn_metrics</code>, <code>ai_profiles</code>, and <code>ai_outcomes</code>. Identity and secret tables are never attached.</p><MudTextField @bind-Value="sql" Lines="3" Variant="Variant.Outlined"/><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunQuery">Run query</MudButton>@if(queryResult is not null){<div class="query-table"><table><thead><tr>@foreach(var column in queryResult.Columns){<th>@column</th>}</tr></thead><tbody>@foreach(var row in queryResult.Rows){<tr>@foreach(var value in row){<td>@(value?.ToString()??"NULL")</td>}</tr>}</tbody></table>@if(queryResult.Truncated){<small>Results truncated to 1,000 rows.</small>}</div>}</section></AuthorizeView>}
@if(!string.IsNullOrEmpty(error)){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>}
@code{
 private AnalyticsSummary? summary;private EmbeddingAuditSummary? embedding;private bool loading=true;private string sql="SELECT status, count(*) AS matches FROM matches GROUP BY status ORDER BY matches DESC";private AnalyticsQueryResult? queryResult;private string? error;
 private long EmbeddingCalls=>embedding?.Purposes.Sum(item=>item.Calls)??0;private long EmbeddingTokens=>embedding?.Purposes.Sum(item=>item.InputTokens)??0;private long EmbeddingErrors=>embedding?.Purposes.Sum(item=>item.Errors)??0;private EmbeddingQualityAudit? LatestQuality=>embedding?.QualityAudits.FirstOrDefault();private string ShortSpace=>embedding?.Configuration.SpaceId is {Length:>16} value?$"{value[..12]}…":embedding?.Configuration.SpaceId??"—";
 protected override async Task OnInitializedAsync(){var analyticsTask=Api.GetAsync<AnalyticsSummary>("api/reports/analytics");var embeddingTask=Api.GetAsync<EmbeddingAuditSummary>("api/reports/embedding-audit");await Task.WhenAll(analyticsTask,embeddingTask);summary=(await analyticsTask)?.Data;embedding=(await embeddingTask)?.Data;loading=false;}
 private async Task RunQuery(){var result=await Api.PostAsync<AnalyticsQueryResult>("api/reports/query",new AnalyticsQueryRequest(sql));if(result.Payload?.Ok==true)queryResult=result.Payload.Data;else error=result.Payload?.Error?.Message;}
 private static string PurposeName(string value)=>value switch{"wiki_initial_build"=>"Wiki · initial build","wiki_refresh"=>"Wiki · refresh","wiki_search"=>"Wiki · semantic search","graphiti_projection"=>"Graphiti · memory projection","graphiti_recall"=>"Graphiti · memory recall","quality_canary"=>"Quality · semantic canary",_=>value.Replace('_',' ')};
 private static string TokenKind(string value)=>value switch{"local_tokenizer"=>"exact local tokens","local_tokenizer_source"=>"exact source tokens","provider_reported"=>"provider-reported tokens","character_estimate"=>"estimated tokens",_=>value.Replace('_',' ')};
 private static string CheckName(string value)=>value.Replace('_',' ');
 private static bool IsCorpusSync(string purpose)=>purpose is "wiki_initial_build" or "wiki_refresh";
}
