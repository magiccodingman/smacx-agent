@page "/analytics"
@attribute [Authorize]
@inject Services.PortalApiClient Api
<PageTitle>Analytics · SMACX Agent</PageTitle>
<PageHeader Kicker="AFTER-ACTION INTELLIGENCE" Title="Match analytics" Description="Compare outcomes, non-errored turn timing, model usage, and recovery evidence without counting empty lobbies as human games."><MudButton Href="api/reports/analytics.csv" Target="_blank" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download">Export CSV</MudButton></PageHeader>
@if(loading){<MudProgressLinear Indeterminate="true" Color="Color.Primary"/>}
else if(summary is not null){
<div class="metric-grid"><MetricCard Label="COMPLETED" Value="@summary.CompletedMatches" Detail="Recorded matches" Icon="@Icons.Material.Filled.Flag"/><MetricCard Label="MEDIAN TURN" Value="@(summary.MedianTurnSeconds is null?"—":$"{summary.MedianTurnSeconds:0.0}s")" Detail="Non-errored decisions" Icon="@Icons.Material.Filled.Timer" Tone="gold"/><MetricCard Label="MODEL TOKENS" Value="@(summary.PromptTokens+summary.CompletionTokens)" Detail="Hermes input + output" Icon="@Icons.Material.Filled.DataUsage" Tone="violet"/><MetricCard Label="API CALLS" Value="@summary.ApiCalls" Detail="Provider requests" Icon="@Icons.Material.Filled.Api" Tone="blue"/></div>
<section class="surface-panel admin-list-panel"><div class="panel-heading"><div><span class="panel-kicker">MODEL COMPARISON</span><h2>Profile versions</h2></div></div>@if(summary.Profiles.Count==0){<div class="empty-state compact"><MudIcon Icon="@Icons.Material.Filled.QueryStats"/><strong>No measured turns yet</strong><span>Metrics begin when versioned AI profiles play managed matches.</span></div>}@foreach(var row in summary.Profiles){<div class="analytics-row"><div><strong>@row.ProfileName</strong><small>@row.Model · @row.ReasoningEffort · @row.ApiCalls calls</small></div><span>@row.Matches matches</span><span>@(row.ClassifiedOutcomes==0?"No classified outcomes":$"{row.Wins}/{row.ClassifiedOutcomes} wins · {row.WinRate:P0}")</span><span>@(row.MedianTurnSeconds?.ToString("0.0")??"—")s median</span><span>@(row.PromptTokens+row.CompletionTokens) tokens · @row.CacheReadTokens cached · @row.ReasoningTokens reasoning</span></div>}</section>
<AuthorizeView Roles="Administrator"><section class="surface-panel form-panel mt-4"><span class="panel-kicker">SANITIZED REPORT LAB</span><h2>Read-only SQL</h2><p class="section-copy">Query an isolated copy containing only <code>matches</code>, <code>turn_metrics</code>, <code>ai_profiles</code>, and <code>ai_outcomes</code>. Identity and secret tables are never attached.</p><MudTextField @bind-Value="sql" Lines="3" Variant="Variant.Outlined"/><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunQuery">Run query</MudButton>@if(queryResult is not null){<div class="query-table"><table><thead><tr>@foreach(var column in queryResult.Columns){<th>@column</th>}</tr></thead><tbody>@foreach(var row in queryResult.Rows){<tr>@foreach(var value in row){<td>@(value?.ToString()??"NULL")</td>}</tr>}</tbody></table>@if(queryResult.Truncated){<small>Results truncated to 1,000 rows.</small>}</div>}</section></AuthorizeView>}
@if(!string.IsNullOrEmpty(error)){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>}
@code{private AnalyticsSummary? summary;private bool loading=true;private string sql="SELECT status, count(*) AS matches FROM matches GROUP BY status ORDER BY matches DESC";private AnalyticsQueryResult? queryResult;private string? error;protected override async Task OnInitializedAsync(){summary=(await Api.GetAsync<AnalyticsSummary>("api/reports/analytics"))?.Data;loading=false;}private async Task RunQuery(){var result=await Api.PostAsync<AnalyticsQueryResult>("api/reports/query",new AnalyticsQueryRequest(sql));if(result.Payload?.Ok==true)queryResult=result.Payload.Data;else error=result.Payload?.Error?.Message;}}
