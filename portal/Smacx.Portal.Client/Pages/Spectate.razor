@page "/spectate"
@page "/spectate/{MatchId}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject Services.PortalApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
<PageTitle>Spectate · SMACX Agent</PageTitle>

@if (string.IsNullOrWhiteSpace(MatchId))
{
    <PageHeader Kicker="OBSERVATION DECK" Title="Live matches" Description="Authenticated non-players may watch opted-in human games and every AI-only simulation without sending input. A campaign participant can never spectate another seat." />
    @if (loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary"/> }
    else if (!lobbies.Any(item => item.CanSpectate))
    {
        <div class="empty-state surface-panel"><div class="empty-orbit"><MudIcon Icon="@Icons.Material.Filled.Visibility"/></div><h2>No observation feeds</h2><p>Live AI-only simulations and human games that permit signed-in spectators appear here unless you are one of their players.</p></div>
    }
    else
    {
        <div class="lobby-grid">@foreach(var item in lobbies.Where(item=>item.CanSpectate)){<a class="surface-panel lobby-card" href="@($"spectate/{item.MatchId}")"><span class="panel-kicker">LIVE FEED</span><h2>@item.DisplayName</h2><p>@item.SeatCount occupied seats</p><span class="lobby-state @item.Status">@item.Status</span></a>}</div>
    }
}
else if (loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary"/> }
else if (lobby is null)
{
    <div class="empty-state surface-panel"><h2>Observation unavailable</h2><p>@error</p><MudButton Href="spectate">Back to observation deck</MudButton></div>
}
else
{
    <PageHeader Kicker="OBSERVATION DECK" Title="@lobby.DisplayName" Description="Switch between isolated seat perspectives. This view cannot send game input." />
    @if(lobby.NeedsAttention is not null&&lobby.Status!="recovering"){<CapabilityGapDialog Incident="lobby.NeedsAttention" MatchId="@(MatchId ?? string.Empty)" RecoveryHref="@($"/lobbies/{MatchId}")" />}
    @if(lobby.Status=="recovering"&&lobby.Maintenance is not null){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" Icon="@Icons.Material.Filled.SettingsSuggest"><strong>@lobby.Maintenance.Summary</strong><br/>@lobby.Maintenance.CompletedSteps / @lobby.Maintenance.TotalSteps · the observation feed reconnects automatically when the restored worker is ready.<MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2"/></MudAlert>}
    <StreamSecurityNotice />
    <div @ref="shell" class="stream-shell surface-panel spectator-shell">
        <div class="stream-toolbar">
            <MudButton OnClick="ReturnToLobby" StartIcon="@Icons.Material.Filled.ArrowBack">Lobby</MudButton>
            @foreach (var seat in WatchableSeats)
            {
                <MudButton Variant="@(seat.SeatIndex==selectedSeat?Variant.Filled:Variant.Text)" Color="Color.Primary" OnClick="@(()=>Select(seat.SeatIndex))" StartIcon="@SeatIcon(seat.ControllerKind)">@SeatName(seat)</MudButton>
            }
            <MudSpacer />
            @if (ActivitySeat is not null) { <MudButton OnClick="@(()=>activityOpen=!activityOpen)" StartIcon="@Icons.Material.Filled.SmartToy" Variant="@(activityOpen?Variant.Filled:Variant.Text)" Color="Color.Primary">AI activity</MudButton> }
            <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" OnClick="ToggleFullscreen" aria-label="Toggle spectator fullscreen" />
        </div>
        <div class="spectator-content">
        <div class="spectator-video">
        @if (Selected is null)
        {
            <div class="stream-empty"><MudIcon Icon="@Icons.Material.Filled.VisibilityOff"/><p>No managed seat is available to watch.</p></div>
        }
        else
        {
            <iframe @key="StreamFrameKey" class="game-stream" src="@StreamUrl(Selected)" title="@($"{SeatName(Selected)} game stream")" allow="autoplay" referrerpolicy="same-origin"></iframe>
        }
        @if(lobby.Status != "running") { <div class="spectator-session-status">Session: @lobby.Status · <a href="@($"/lobbies/{MatchId}")">Return to lobby</a></div> }
        </div>
        @if(ActivitySeat is not null) { <AiActivityPanel @key="ActivitySeat.SeatIndex" MatchId="@(MatchId ?? string.Empty)" SeatIndex="@ActivitySeat.SeatIndex" SeatName="@SeatName(ActivitySeat)" Visible="@activityOpen" OnClose="@(()=>activityOpen=false)" /> }
        </div>
    </div>
}

@code {
    [Parameter] public string? MatchId { get; set; }
    [SupplyParameterFromQuery(Name="seat")] public int? RequestedSeat { get; set; }
    private bool loading=true; private string? error; private LobbyDetails? lobby; private List<PublicLobbySummary> lobbies=[]; private int selectedSeat; private PeriodicTimer? refreshTimer; private CancellationTokenSource? refreshCancellation; private Task? refreshTask;
    private IEnumerable<LobbySeatSummary> WatchableSeats => lobby?.Seats.Where(seat=>seat.CanSpectate&&seat.InstanceId is not null)??[];
    private LobbySeatSummary? Selected => WatchableSeats.FirstOrDefault(seat=>seat.SeatIndex==selectedSeat)??WatchableSeats.FirstOrDefault();
    private LobbySeatSummary? ActivitySeat => lobby?.Seats.FirstOrDefault(s=>s.SeatIndex==selectedSeat && s.ControllerKind=="agent");
    private bool activityOpen;
    private ElementReference shell;
    private IJSObjectReference? activityModule;
    private async Task ToggleFullscreen(){activityModule??=await JS.InvokeAsync<IJSObjectReference>("import","./js/ai-activity.js");await activityModule.InvokeVoidAsync("toggleFullscreen",shell);}
    private async Task ReturnToLobby(){activityModule??=await JS.InvokeAsync<IJSObjectReference>("import","./js/ai-activity.js");await activityModule.InvokeVoidAsync("leaveFullscreen");Navigation.NavigateTo($"lobbies/{MatchId}");}
    private string StreamFrameKey => $"{Selected?.InstanceId}:{lobby?.RuntimeGeneration ?? 0}";
    protected override async Task OnParametersSetAsync(){await StopRefreshAsync();loading=true;error=null;try{if(string.IsNullOrWhiteSpace(MatchId)){lobbies=((await Api.GetAsync<IReadOnlyList<PublicLobbySummary>>("api/lobbies"))?.Data??[]).ToList();}else{lobby=(await Api.GetAsync<LobbyDetails>($"api/lobbies/{MatchId}"))?.Data;selectedSeat=RequestedSeat??lobby?.Seats.FirstOrDefault(seat=>seat.CanSpectate)?.SeatIndex??0;var cancellation=new CancellationTokenSource();var timer=new PeriodicTimer(TimeSpan.FromSeconds(5));refreshCancellation=cancellation;refreshTimer=timer;refreshTask=RefreshMatch(timer,cancellation.Token);}}catch(HttpRequestException){error="The stream directory could not be loaded.";}loading=false;}
    private async Task RefreshMatch(PeriodicTimer timer,CancellationToken token){try{while(await timer.WaitForNextTickAsync(token)){try{var latest=(await Api.GetAsync<LobbyDetails>($"api/lobbies/{MatchId}",token))?.Data;if(latest is not null)lobby=latest;await InvokeAsync(StateHasChanged);}catch(Exception)when(!token.IsCancellationRequested){}}}catch(OperationCanceledException)when(token.IsCancellationRequested){}catch(ObjectDisposedException){}}
    private async Task StopRefreshAsync(){var cancellation=Interlocked.Exchange(ref refreshCancellation,null);var timer=Interlocked.Exchange(ref refreshTimer,null);var task=Interlocked.Exchange(ref refreshTask,null);if(cancellation is not null){try{cancellation.Cancel();}catch(ObjectDisposedException){}}timer?.Dispose();if(task is not null){try{await task;}catch(OperationCanceledException){}catch(ObjectDisposedException){}}cancellation?.Dispose();}
    private void Select(int seat){selectedSeat=seat;}
    private static string SeatName(LobbySeatSummary seat)=>seat.PlayerHandle??(seat.ControllerKind=="agent"?"AI player":$"Seat {seat.SeatIndex+1}");
    private static string SeatIcon(string kind)=>kind=="agent"?Icons.Material.Filled.SmartToy:Icons.Material.Filled.Person;
    private static string StreamUrl(LobbySeatSummary seat)=> $"/stream/{seat.InstanceId}/?view=1";
    public async ValueTask DisposeAsync(){await StopRefreshAsync();var module=Interlocked.Exchange(ref activityModule,null);if(module is not null){try{await module.DisposeAsync();}catch(JSDisconnectedException){}catch(ObjectDisposedException){}}}
}
