@page "/lobbies/new"
@attribute [Authorize]
@inject Services.PortalApiClient Api
@inject NavigationManager Navigation
<PageTitle>New lobby · SMACX Agent</PageTitle>
<PageHeader Kicker="MISSION CONFIGURATION" Title="Create a match" Description="Configure the game’s native rules, seats, browser access, and agent memory from one durable lobby." />
@if(loading){<MudProgressLinear Indeterminate="true" Color="Color.Primary"/>}
else{
<div class="form-grid">
 <section class="surface-panel form-panel"><h2>Match identity</h2><p class="section-copy">Visible in the private LAN directory.</p><MudTextField @bind-Value="name" Label="Lobby name" Variant="Variant.Outlined" Immediate="true"/><MudTextField Value="@("Alien Crossfire")" Label="Game" Variant="Variant.Outlined" Disabled="true"/><MudSelect T="string" @bind-Value="mode" Label="Start mode" Variant="Variant.Outlined"><MudSelectItem Value="@("standard")">New standard game</MudSelectItem><MudSelectItem Value="@("scenario")">Scenario</MudSelectItem></MudSelect>@if(mode=="scenario"){<MudSelect T="string" @bind-Value="scenarioId" Label="Scenario" Variant="Variant.Outlined">@foreach(var scenario in scenarios){<MudSelectItem Value="@scenario.Id">@scenario.DisplayName</MudSelectItem>}</MudSelect>@if(scenarios.Count==0){<span class="field-help">No safe .SC files were found in this installation.</span>}}</section>
 <section class="surface-panel form-panel"><h2>Planet & difficulty</h2><p class="section-copy">Exact native setup values—not a visual menu macro.</p><div class="field-pair"><MudSelect T="string" @bind-Value="worldSize" Label="Planet size" Variant="Variant.Outlined">@foreach(var value in worldSizes){<MudSelectItem Value="@value.Id">@value.Name</MudSelectItem>}</MudSelect><MudSelect T="string" @bind-Value="difficulty" Label="Difficulty" Variant="Variant.Outlined">@foreach(var value in difficulties){<MudSelectItem Value="@value.Id">@value.Name</MudSelectItem>}</MudSelect></div><MudSelect T="int" @bind-Value="timeControl" Label="Multiplayer turn clock" Variant="Variant.Outlined"><MudSelectItem Value="0">None</MudSelectItem><MudSelectItem Value="1">Tight</MudSelectItem><MudSelectItem Value="2">Standard</MudSelectItem><MudSelectItem Value="3">Moderate</MudSelectItem><MudSelectItem Value="4">Loose</MudSelectItem></MudSelect><div class="native-setting-grid"><MudSelect T="int" @bind-Value="ocean" Label="Ocean" Variant="Variant.Outlined">@TraitItems()</MudSelect><MudSelect T="int" @bind-Value="erosion" Label="Erosive forces" Variant="Variant.Outlined">@TraitItems()</MudSelect><MudSelect T="int" @bind-Value="nativeLife" Label="Native life" Variant="Variant.Outlined">@TraitItems()</MudSelect><MudSelect T="int" @bind-Value="clouds" Label="Cloud cover" Variant="Variant.Outlined">@TraitItems()</MudSelect></div></section>
 <section class="surface-panel form-panel"><h2>Seats</h2><p class="section-copy">One browser human can launch a solo game. Two or more human/AI seats become a managed DirectPlay LAN match; every remaining faction is game-controlled.</p><MudSelect T="string" @bind-Value="hostController" Label="Managed host" Variant="Variant.Outlined"><MudSelectItem Value="@("human")">Human owner</MudSelectItem><MudSelectItem Value="@("agent")">First AI profile</MudSelectItem></MudSelect>@if(hostController=="agent"){<MudSwitch @bind-Value="ownerPlays" Color="Color.Primary">Reserve a human seat for me</MudSwitch>}<MudSelect T="string" @bind-Value="humanJoinMode" Label="Human client mode" Variant="Variant.Outlined"><MudSelectItem Value="@("browser")">Browser managed</MudSelectItem><MudSelectItem Value="@("native")">Direct game client</MudSelectItem></MudSelect><MudSelect T="string" @bind-SelectedValues="agentIds" MultiSelection="true" Label="AI profiles" Variant="Variant.Outlined">@foreach(var agent in catalog?.Agents??[]){<MudSelectItem Value="@agent.Id">@agent.DisplayName</MudSelectItem>}</MudSelect><MudTextField @bind-Value="humanHandles" Label="Invited player handles" HelperText="Comma-separated; case-insensitive accounts claim these seats." Variant="Variant.Outlined" Immediate="true"/><MudNumericField T="int" @bind-Value="nativeBotCount" Label="Reserved native bots" Min="0" Max="6" Variant="Variant.Outlined"/><span class="field-help">The Planet & difficulty choice is the native match difficulty. Any unclaimed faction is also handed to the stock game AI when the lobby starts.</span></section>
 <section class="surface-panel form-panel"><h2>Runtime</h2><p class="section-copy">An administrator validates these once. Browser seats use isolated workers; direct players use their local client.</p><MudSelect T="string" Value="@sourceId" ValueChanged="SourceChanged" Label="Game installation" Variant="Variant.Outlined">@foreach(var source in catalog?.GameSources??[]){<MudSelectItem Value="@source.Id">@source.DisplayName</MudSelectItem>}</MudSelect><MudSelect T="string" @bind-Value="runtimeId" Label="Wine / Proton runtime" Variant="Variant.Outlined">@foreach(var runtime in catalog?.Runtimes??[]){<MudSelectItem Value="@runtime.Id">@runtime.DisplayName</MudSelectItem>}</MudSelect>@if(catalog?.ControlConnected==false){<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Control is offline. The lobby can be drafted but not launched.</MudAlert>}</section>
 <section class="surface-panel form-panel"><h2>Victory & game rules</h2><p class="section-copy">Defaults preserve ordinary Alien Crossfire play. Expand only when customizing.</p><MudSwitch @bind-Value="doOrDie" Color="Color.Primary">Do or die / no cooperative victory</MudSwitch><MudExpansionPanels Elevation="0" Class="rule-panels"><MudExpansionPanel Text="Victory conditions"><div class="rule-grid">@RuleSwitch("Transcendence","victory_transcendence")@RuleSwitch("Conquest","victory_conquest")@RuleSwitch("Diplomatic","victory_diplomatic")@RuleSwitch("Economic","victory_economic")@RuleSwitch("Cooperative","victory_cooperative")</div></MudExpansionPanel><MudExpansionPanel Text="Advanced rules"><div class="rule-grid">@RuleSwitch("Look first","look_first")@RuleSwitch("Tech stagnation","tech_stagnation")@RuleSwitch("Spoils of war","spoils_of_war")@RuleSwitch("Blind research","blind_research")@RuleSwitch("Intense rivalry","intense_rivalry")@RuleSwitch("Unity survey","unity_survey")@RuleSwitch("Unity scattering","unity_scattering")@RuleSwitch("Random events","random_events")@RuleSwitch("Time warp","time_warp")@RuleSwitch("Ironman","ironman")</div></MudExpansionPanel></MudExpansionPanels></section>
 <section class="surface-panel form-panel"><h2>Access, memory & policy</h2><p class="section-copy">Trusted-LAN defaults with explicit observation controls.</p><MudSwitch @bind-Value="anonymousSpectators" Color="Color.Primary">Allow anonymous spectators</MudSwitch><span class="field-help">Off by default. Administrators can always cross-seat spectate.</span><MudSwitch @bind-Value="managedOnly" Color="Color.Primary">Managed clients only</MudSwitch><MudSwitch @bind-Value="graphiti" Color="Color.Primary">Enable optional Graphiti projection</MudSwitch><MudSelect T="string" Value="@("none")" Label="Personality card" Variant="Variant.Outlined" Disabled="true"><MudSelectItem Value="@("none")">None</MudSelectItem></MudSelect><MudAlert Severity="Severity.Info" Variant="Variant.Outlined">This release records every match as unranked. Ranked policy has schema bones only.</MudAlert></section>
</div>
@if(!string.IsNullOrEmpty(error)){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>}
<div class="form-actions"><MudButton Href="lobbies" Variant="Variant.Text">Cancel</MudButton><MudButton Variant="Variant.Outlined" Disabled="busy" OnClick="()=>Create(false)">Save waiting lobby</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.RocketLaunch" Disabled="busy" OnClick="()=>Create(true)">Create & launch</MudButton></div>}
@code{
 private LobbyCatalog? catalog;private IReadOnlyList<ScenarioCatalogItem> scenarios=[];private string name="New mission",gameProfile="alien-crossfire",mode="standard",worldSize="small",difficulty="talent",hostController="human",humanJoinMode="browser",humanHandles="",sourceId="",runtimeId="",scenarioId="";private IReadOnlyCollection<string> agentIds=[];private bool ownerPlays=true,doOrDie,anonymousSpectators,managedOnly,graphiti=true,loading=true,busy;private int nativeBotCount,timeControl=2,ocean=1,erosion=1,nativeLife=1,clouds=1;private string? error;
 private readonly (string Id,string Name)[] worldSizes=[("tiny","Tiny"),("small","Small"),("standard","Standard"),("large","Large"),("huge","Huge")];private readonly (string Id,string Name)[] difficulties=[("citizen","Citizen"),("specialist","Specialist"),("talent","Talent"),("librarian","Librarian"),("thinker","Thinker"),("transcend","Transcend")];private readonly Dictionary<string,bool> rules=new(){{"victory_transcendence",true},{"victory_conquest",true},{"victory_diplomatic",true},{"victory_economic",true},{"victory_cooperative",true},{"look_first",false},{"tech_stagnation",false},{"spoils_of_war",true},{"blind_research",true},{"intense_rivalry",false},{"unity_survey",false},{"unity_scattering",false},{"random_events",true},{"time_warp",false},{"ironman",false}};
 protected override async Task OnInitializedAsync(){catalog=(await Api.GetAsync<LobbyCatalog>("api/catalog/lobby"))?.Data;sourceId=catalog?.GameSources.FirstOrDefault()?.Id??"";runtimeId=catalog?.Runtimes.FirstOrDefault()?.Id??"";await LoadScenarios();loading=false;}
 private async Task SourceChanged(string value){sourceId=value;await LoadScenarios();}
 private async Task LoadScenarios(){if(string.IsNullOrEmpty(sourceId)){scenarios=[];return;}try{scenarios=(await Api.GetAsync<IReadOnlyList<ScenarioCatalogItem>>($"api/catalog/scenarios/{sourceId}"))?.Data??[];scenarioId=scenarios.FirstOrDefault()?.Id??"";}catch{scenarios=[];}}
 private async Task Create(bool start){busy=true;error=null;rules["victory_cooperative"]=!doOrDie&&rules["victory_cooperative"];var humans=humanHandles.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);var request=new CreateLobbyRequest(name,sourceId,runtimeId,gameProfile,mode,worldSize,difficulty,true,doOrDie,anonymousSpectators,managedOnly,graphiti,"none",agentIds.ToArray(),humans,hostController,ownerPlays,nativeBotCount,difficulty,start,"unranked",humanJoinMode,timeControl,ocean,erosion,nativeLife,clouds,new Dictionary<string,bool>(rules),mode=="scenario"?scenarioId:null,null);var result=await Api.PostAsync<LobbyDetails>("api/lobbies",request);busy=false;if(result.Payload?.Ok==true)Navigation.NavigateTo($"lobbies/{result.Payload.Data!.MatchId}");else error=result.Payload?.Error?.Message??"Lobby creation failed.";}
 private RenderFragment TraitItems()=>builder=>{var labels=new[]{"Low","Average","High"};for(var i=0;i<3;i++){var sequence=i;var label=labels[i];builder.OpenComponent<MudSelectItem<int>>(sequence);builder.AddAttribute(sequence+10,"Value",i);builder.AddAttribute(sequence+20,"ChildContent",(RenderFragment)(content=>content.AddContent(0,label)));builder.CloseComponent();}};
 private RenderFragment RuleSwitch(string label,string key)=>builder=>{builder.OpenComponent<MudSwitch<bool>>(0);builder.AddAttribute(1,"Value",rules[key]);builder.AddAttribute(2,"ValueChanged",EventCallback.Factory.Create<bool>(this,value=>rules[key]=value));builder.AddAttribute(3,"Color",Color.Primary);builder.AddAttribute(4,"ChildContent",(RenderFragment)(content=>content.AddContent(0,label)));builder.CloseComponent();};
}
