@page "/lobbies/new"
@attribute [Authorize]
@inject Services.PortalApiClient Api
@inject NavigationManager Navigation

<PageTitle>New lobby · SMACX Agent</PageTitle>
<PageHeader Kicker="MISSION CONFIGURATION"
            Title="Create a match"
            Description="Configure the native game, decide who plays, then either save a waiting lobby or launch it immediately." />

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="form-grid">
        <section class="surface-panel form-panel">
            <h2>Match identity</h2>
            <p class="section-copy">This name appears in the private LAN lobby directory.</p>
            <MudTextField @bind-Value="name" Label="Lobby name" Variant="Variant.Outlined" Immediate="true" />
            <MudTextField Value="@("Alien Crossfire")" Label="Game" Variant="Variant.Outlined" Disabled="true" />
            <MudSelect T="string" @bind-Value="mode" Label="Start mode" Variant="Variant.Outlined">
                <MudSelectItem Value="@("standard")">New standard game</MudSelectItem>
                <MudSelectItem Value="@("scenario")">Installed scenario</MudSelectItem>
            </MudSelect>
            @if (mode == "scenario")
            {
                <MudSelect T="string" @bind-Value="scenarioId" Label="Scenario" Variant="Variant.Outlined">
                    @foreach (var scenario in scenarios)
                    {
                        <MudSelectItem Value="@scenario.Id">@scenario.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                @if (scenarios.Count == 0)
                {
                    <span class="field-help flush">No safe .SC scenarios were found in the selected installation.</span>
                }
            }
        </section>

        <section class="surface-panel form-panel">
            <h2>Planet & difficulty</h2>
            <p class="section-copy">These are exact native setup values, not visual menu automation.</p>
            <div class="field-pair">
                <MudSelect T="string" @bind-Value="worldSize" Label="Planet size" Variant="Variant.Outlined">
                    @foreach (var value in worldSizes)
                    {
                        <MudSelectItem Value="@value.Id">@value.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="difficulty" Label="Difficulty" Variant="Variant.Outlined">
                    @foreach (var value in difficulties)
                    {
                        <MudSelectItem Value="@value.Id">@value.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudSelect T="int" @bind-Value="timeControl" Label="Multiplayer turn clock" Variant="Variant.Outlined">
                <MudSelectItem Value="0">None</MudSelectItem>
                <MudSelectItem Value="1">Tight</MudSelectItem>
                <MudSelectItem Value="2">Standard</MudSelectItem>
                <MudSelectItem Value="3">Moderate</MudSelectItem>
                <MudSelectItem Value="4">Loose</MudSelectItem>
            </MudSelect>
            <div class="native-setting-grid">
                <MudSelect T="int" @bind-Value="ocean" Label="Ocean" Variant="Variant.Outlined">@TraitItems()</MudSelect>
                <MudSelect T="int" @bind-Value="erosion" Label="Erosive forces" Variant="Variant.Outlined">@TraitItems()</MudSelect>
                <MudSelect T="int" @bind-Value="nativeLife" Label="Native life" Variant="Variant.Outlined">@TraitItems()</MudSelect>
                <MudSelect T="int" @bind-Value="clouds" Label="Cloud cover" Variant="Variant.Outlined">@TraitItems()</MudSelect>
            </div>
        </section>

        <section class="surface-panel form-panel">
            <h2>Players & host</h2>
            <p class="section-copy">An AI host is the recommended managed path. It launches first and owns the native network session.</p>
            <MudSelect T="string" @bind-Value="hostController" Label="Who hosts the native game?" Variant="Variant.Outlined">
                <MudSelectItem Value="@("agent")">First selected AI profile (recommended)</MudSelectItem>
                <MudSelectItem Value="@("human")">My managed human seat (advanced)</MudSelectItem>
            </MudSelect>
            <span class="field-help flush">Human hosting remains available for compatibility, but agent hosting gives the supervisor the cleanest recovery and reconnect path.</span>

            @if (hostController == "agent")
            {
                <MudSwitch @bind-Value="ownerPlays" Color="Color.Primary">Add me as a human player</MudSwitch>
            }

            @if (catalog?.Agents.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="setup-callout">
                    <strong>No AI player profiles exist yet.</strong><br />
                    An agent-hosted lobby needs an administrator to connect a model endpoint and create a profile first.
                    <AuthorizeView Roles="Administrator">
                        <div class="setup-callout-actions">
                            <MudButton Href="admin/providers" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">
                                Configure AI profiles
                            </MudButton>
                        </div>
                    </AuthorizeView>
                </MudAlert>
            }
            else
            {
                <MudSelect T="string" @bind-SelectedValues="agentIds" MultiSelection="true"
                           Label="AI player profiles" Variant="Variant.Outlined"
                           ToStringFunc="AgentDisplayName" Strict="true">
                    @foreach (var agent in catalog?.Agents ?? [])
                    {
                        <MudSelectItem Value="@agent.Id">@agent.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <span class="field-help flush">Each selected profile becomes one independent AI player. The first selected profile hosts when AI hosting is chosen.</span>
            }

            <MudSelect T="string" @bind-Value="humanJoinMode" Label="Human player mode" Variant="Variant.Outlined">
                <MudSelectItem Value="@("browser")">Play in browser (recommended)</MudSelectItem>
                <MudSelectItem Value="@("native")">Join from a separate game client</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="humanHandles" Label="Reserve seats for player handles (optional)"
                          HelperText="Comma-separated. This reserves seats; it does not send a notification. Existing or future accounts claim them case-insensitively."
                          Variant="Variant.Outlined" Immediate="true" />
            <MudNumericField T="int" @bind-Value="nativeBotCount" Label="Reserve stock computer opponents (optional)"
                             Min="0" Max="6" Variant="Variant.Outlined" />
            <span class="field-help flush">Reserve bots only to prevent those seats being claimed while a lobby waits. Any seat still open when the game launches also becomes a stock game-controlled faction.</span>
            <span class="field-help flush">@AssignedSeatCount of 7 seats are currently reserved. Unreserved seats remain joinable until launch.</span>
            @if (!HasValidSeatCount)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Reduce the selected AI players, human handles, or reserved stock opponents to seven total seats.</MudAlert>
            }
        </section>

        <section class="surface-panel form-panel">
            <h2>Game runtime</h2>
            <p class="section-copy">The validated installation and compatibility runtime are selected automatically.</p>
            @if (catalog?.GameSources.Count == 0 || catalog?.Runtimes.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    A validated game installation and Proton runtime are required before this lobby can be saved or launched.
                </MudAlert>
            }
            else if (catalog?.GameSources.Count == 1 && catalog.Runtimes.Count == 1)
            {
                <div class="runtime-summary">
                    <MudIcon Icon="@Icons.Material.Filled.Verified" />
                    <div>
                        <strong>@catalog.GameSources[0].DisplayName</strong>
                        <span>@catalog.Runtimes[0].DisplayName · automatically selected</span>
                    </div>
                </div>
            }
            else
            {
                <MudExpansionPanels Elevation="0" Class="rule-panels">
                    <MudExpansionPanel Text="Advanced: choose installation and runtime">
                        <MudSelect T="string" Value="@sourceId" ValueChanged="SourceChanged"
                                   Label="Game installation" Variant="Variant.Outlined">
                            @foreach (var source in catalog?.GameSources ?? [])
                            {
                                <MudSelectItem Value="@source.Id">@source.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="runtimeId" Label="Wine / Proton runtime" Variant="Variant.Outlined">
                            @foreach (var runtime in catalog?.Runtimes ?? [])
                            {
                                <MudSelectItem Value="@runtime.Id">@runtime.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                        <span class="field-help flush">Multiple choices appear only for different validated game installs, mods, patches, or Proton versions.</span>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
            @if (catalog?.ControlConnected == false)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                    Game control is offline. Existing configuration remains visible, but launching is unavailable.
                </MudAlert>
            }
        </section>

        <section class="surface-panel form-panel">
            <h2>Victory & game rules</h2>
            <p class="section-copy">Defaults preserve ordinary Alien Crossfire play. Expand only when customizing.</p>
            <MudSwitch @bind-Value="doOrDie" Color="Color.Primary">Do or die / no cooperative victory</MudSwitch>
            <MudExpansionPanels Elevation="0" Class="rule-panels">
                <MudExpansionPanel Text="Victory conditions">
                    <div class="rule-grid">
                        @RuleSwitch("Transcendence", "victory_transcendence")
                        @RuleSwitch("Conquest", "victory_conquest")
                        @RuleSwitch("Diplomatic", "victory_diplomatic")
                        @RuleSwitch("Economic", "victory_economic")
                        @RuleSwitch("Cooperative", "victory_cooperative")
                    </div>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Advanced rules">
                    <div class="rule-grid">
                        @RuleSwitch("Look first", "look_first")
                        @RuleSwitch("Tech stagnation", "tech_stagnation")
                        @RuleSwitch("Spoils of war", "spoils_of_war")
                        @RuleSwitch("Blind research", "blind_research")
                        @RuleSwitch("Intense rivalry", "intense_rivalry")
                        @RuleSwitch("Unity survey", "unity_survey")
                        @RuleSwitch("Unity scattering", "unity_scattering")
                        @RuleSwitch("Random events", "random_events")
                        @RuleSwitch("Time warp", "time_warp")
                        @RuleSwitch("Ironman", "ironman")
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </section>

        <section class="surface-panel form-panel">
            <h2>Access, memory & policy</h2>
            <p class="section-copy">Trusted-LAN defaults with explicit observation and memory controls.</p>
            <div class="policy-option">
                <MudSwitch @bind-Value="anonymousSpectators" Color="Color.Primary">Allow anonymous spectators</MudSwitch>
                <span class="field-help">Anyone who can reach this LAN portal may watch without signing in. Off by default; administrators can always cross-seat spectate.</span>
            </div>
            <div class="policy-option">
                <MudSwitch @bind-Value="managedOnly" Color="Color.Primary">Managed browser players only</MudSwitch>
                <span class="field-help">Blocks separate native game clients. Every human seat must use a portal-managed browser worker, giving the most consistent binaries, reconnects, and spectator isolation.</span>
            </div>
            <div class="policy-option">
                <MudSwitch @bind-Value="graphiti" Color="Color.Primary">Enable optional Graphiti projection</MudSwitch>
                <span class="field-help">Projects selected match memories into Graphiti for relationship recall. SQLite remains authoritative, and disabling this does not disable normal match notes or state.</span>
            </div>
            <div class="policy-option">
                <MudSelect T="string" Value="@("none")" Label="Personality card" Variant="Variant.Outlined" Disabled="true">
                    <MudSelectItem Value="@("none")">None</MudSelectItem>
                </MudSelect>
                <span class="field-help">Personality-card storage is ready, but authored cards are intentionally deferred. No personality layer is added in this release.</span>
            </div>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                All current matches are unranked. Ranked policy has schema support only and is not selectable yet.
            </MudAlert>
        </section>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>
    }

    <div class="launch-explainer">
        <div class="launch-choice">
            <strong>Save without starting</strong>
            <span>Creates a waiting lobby in the portal. No game process starts and nothing is advertised by the native game yet.</span>
        </div>
        <div class="launch-choice">
            <strong>Launch game now</strong>
            <span>Creates the lobby, provisions the selected players, starts the native game, and begins advertising the joinable session immediately.</span>
        </div>
    </div>
    <div class="form-actions">
        <MudButton Href="lobbies" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined" Disabled="@(busy || !CanSaveLobby)" OnClick="() => Create(false)">
            Save without starting
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.RocketLaunch"
                   Disabled="@(busy || !CanLaunch)" OnClick="() => Create(true)">
            Launch game now
        </MudButton>
    </div>
}

@code {
    private LobbyCatalog? catalog;
    private IReadOnlyList<ScenarioCatalogItem> scenarios = [];
    private string name = "New mission";
    private string gameProfile = "alien-crossfire";
    private string mode = "standard";
    private string worldSize = "small";
    private string difficulty = "talent";
    private string hostController = "agent";
    private string humanJoinMode = "browser";
    private string humanHandles = "";
    private string sourceId = "";
    private string runtimeId = "";
    private string scenarioId = "";
    private IReadOnlyCollection<string> agentIds = [];
    private bool ownerPlays = true;
    private bool doOrDie;
    private bool anonymousSpectators;
    private bool managedOnly;
    private bool graphiti = true;
    private bool loading = true;
    private bool busy;
    private int nativeBotCount;
    private int timeControl = 2;
    private int ocean = 1;
    private int erosion = 1;
    private int nativeLife = 1;
    private int clouds = 1;
    private string? error;

    private bool HasRequiredPlayers => hostController != "agent" || agentIds.Count > 0;
    private bool HasRequiredRuntime => !string.IsNullOrWhiteSpace(sourceId) && !string.IsNullOrWhiteSpace(runtimeId);
    private bool HasRequiredScenario => mode != "scenario" || !string.IsNullOrWhiteSpace(scenarioId);
    private string[] ReservedHumanHandles => humanHandles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    private int AssignedSeatCount => (hostController == "human" || ownerPlays ? 1 : 0) + agentIds.Count + ReservedHumanHandles.Length + nativeBotCount;
    private bool HasValidSeatCount => AssignedSeatCount is >= 1 and <= 7;
    private bool CanSaveLobby => !string.IsNullOrWhiteSpace(name) && HasRequiredPlayers && HasRequiredRuntime && HasRequiredScenario && HasValidSeatCount;
    private bool CanLaunch => CanSaveLobby && catalog?.ControlConnected == true;

    private readonly (string Id, string Name)[] worldSizes =
        [("tiny", "Tiny"), ("small", "Small"), ("standard", "Standard"), ("large", "Large"), ("huge", "Huge")];
    private readonly (string Id, string Name)[] difficulties =
        [("citizen", "Citizen"), ("specialist", "Specialist"), ("talent", "Talent"), ("librarian", "Librarian"), ("thinker", "Thinker"), ("transcend", "Transcend")];
    private readonly Dictionary<string, bool> rules = new()
    {
        ["victory_transcendence"] = true,
        ["victory_conquest"] = true,
        ["victory_diplomatic"] = true,
        ["victory_economic"] = true,
        ["victory_cooperative"] = true,
        ["look_first"] = false,
        ["tech_stagnation"] = false,
        ["spoils_of_war"] = true,
        ["blind_research"] = true,
        ["intense_rivalry"] = false,
        ["unity_survey"] = false,
        ["unity_scattering"] = false,
        ["random_events"] = true,
        ["time_warp"] = false,
        ["ironman"] = false,
    };

    protected override async Task OnInitializedAsync()
    {
        catalog = (await Api.GetAsync<LobbyCatalog>("api/catalog/lobby"))?.Data;
        sourceId = catalog?.GameSources.FirstOrDefault()?.Id ?? "";
        runtimeId = catalog?.Runtimes.FirstOrDefault()?.Id ?? "";
        if (catalog?.Agents.Count == 1)
        {
            agentIds = [catalog.Agents[0].Id];
        }
        await LoadScenarios();
        loading = false;
    }

    private async Task SourceChanged(string value)
    {
        sourceId = value;
        await LoadScenarios();
    }

    private string AgentDisplayName(string? agentId)
    {
        if (string.IsNullOrWhiteSpace(agentId))
        {
            return string.Empty;
        }
        return catalog?.Agents.FirstOrDefault(item => item.Id == agentId)?.DisplayName
            ?? "Unavailable AI profile";
    }

    private async Task LoadScenarios()
    {
        if (string.IsNullOrEmpty(sourceId))
        {
            scenarios = [];
            return;
        }
        try
        {
            scenarios = (await Api.GetAsync<IReadOnlyList<ScenarioCatalogItem>>($"api/catalog/scenarios/{sourceId}"))?.Data ?? [];
            scenarioId = scenarios.FirstOrDefault()?.Id ?? "";
        }
        catch
        {
            scenarios = [];
        }
    }

    private async Task Create(bool start)
    {
        if (!CanSaveLobby || start && !CanLaunch)
        {
            error = hostController == "agent" && agentIds.Count == 0
                ? "Choose at least one AI player profile, or configure one in Administration → Models & AI profiles."
                : "Complete the required player, game, scenario, and runtime choices before continuing.";
            return;
        }

        busy = true;
        error = null;
        rules["victory_cooperative"] = !doOrDie && rules["victory_cooperative"];
        var humans = ReservedHumanHandles;
        var request = new CreateLobbyRequest(
            name, sourceId, runtimeId, gameProfile, mode, worldSize, difficulty,
            true, doOrDie, anonymousSpectators, managedOnly, graphiti, "none",
            agentIds.ToArray(), humans, hostController, ownerPlays, nativeBotCount,
            difficulty, start, "unranked", humanJoinMode, timeControl, ocean, erosion,
            nativeLife, clouds, new Dictionary<string, bool>(rules),
            mode == "scenario" ? scenarioId : null, null);
        var result = await Api.PostAsync<LobbyDetails>("api/lobbies", request);
        busy = false;
        if (result.Payload?.Ok == true)
        {
            Navigation.NavigateTo($"lobbies/{result.Payload.Data!.MatchId}");
        }
        else
        {
            error = result.Payload?.Error?.Message ?? "Lobby creation failed.";
        }
    }

    private RenderFragment TraitItems() => builder =>
    {
        var labels = new[] { "Low", "Average", "High" };
        for (var index = 0; index < labels.Length; index++)
        {
            var sequence = index;
            var value = index;
            var label = labels[index];
            builder.OpenComponent<MudSelectItem<int>>(sequence);
            builder.AddAttribute(sequence + 10, "Value", value);
            builder.AddAttribute(sequence + 20, "ChildContent",
                (RenderFragment)(content => content.AddContent(0, label)));
            builder.CloseComponent();
        }
    };

    private RenderFragment RuleSwitch(string label, string key) => builder =>
    {
        builder.OpenComponent<MudSwitch<bool>>(0);
        builder.AddAttribute(1, "Value", rules[key]);
        builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<bool>(this, value => rules[key] = value));
        builder.AddAttribute(3, "Color", Color.Primary);
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(content => content.AddContent(0, label)));
        builder.CloseComponent();
    };
}
