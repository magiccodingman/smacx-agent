@page "/lobbies"
@implements IAsyncDisposable
@inject Services.PortalApiClient Api
@using Microsoft.AspNetCore.SignalR.Client
<PageTitle>Lobbies · SMACX Agent</PageTitle>
<PageHeader Kicker="MATCH DIRECTORY" Title="Lobbies" Description="Join, resume, or watch matches visible on this private control center."><MudButton Href="lobbies/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New lobby</MudButton></PageHeader>
<div class="filter-row"><MudTextField T="string" @bind-Value="filter" Immediate="true" Placeholder="Search lobby" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Class="search-field"/><MudChip T="string" Variant="@(statusFilter == "all" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => statusFilter = "all")">All</MudChip><MudChip T="string" Variant="@(statusFilter == "waiting" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => statusFilter = "waiting")">Waiting</MudChip><MudChip T="string" Variant="@(statusFilter == "running" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => statusFilter = "running")">In progress</MudChip></div>
@if (loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
else if (Visible.Count == 0) { <div class="empty-state surface-panel"><div class="empty-orbit"><MudIcon Icon="@Icons.Material.Filled.Groups"/></div><h2>No lobbies are advertising</h2><p>Create the first match on this host, or return when another room opens.</p><MudButton Href="lobbies/new" Variant="Variant.Outlined" Color="Color.Primary">Create lobby</MudButton></div> }
else { <div class="lobby-grid">@foreach (var lobby in Visible) { <a class="surface-panel lobby-card" href="@($"lobbies/{lobby.MatchId}")"><div class="lobby-card-top"><span class="lobby-state @lobby.Status">@lobby.Status</span>@if(lobby.CanSpectate){<MudIcon Icon="@Icons.Material.Filled.Visibility" Title="Observation available"/>}</div><h2>@lobby.DisplayName</h2><div class="lobby-meta"><span><MudIcon Icon="@Icons.Material.Filled.Group"/> @lobby.SeatCount occupied · @lobby.OpenSeatCount open</span><span><MudIcon Icon="@Icons.Material.Filled.Schedule"/> @(lobby.WaitingExpiresAt is null?lobby.UpdatedAt.ToLocalTime().ToString("g"):$"closes {lobby.WaitingExpiresAt.Value.ToLocalTime():t}")</span></div></a> }</div> }
@code {
    private IReadOnlyList<PublicLobbySummary> lobbies=[]; private string filter="", statusFilter="all"; private bool loading=true; private HubConnection? hub; private PeriodicTimer? timer; private CancellationTokenSource? refreshCancellation;
    private IReadOnlyList<PublicLobbySummary> Visible => lobbies.Where(item=>(string.IsNullOrWhiteSpace(filter)||item.DisplayName.Contains(filter,StringComparison.OrdinalIgnoreCase))&&(statusFilter=="all"||(statusFilter=="waiting"&&item.Status=="waiting")||(statusFilter=="running"&&item.Status is "running" or "provisioning"))).ToArray();
    protected override async Task OnInitializedAsync(){await Refresh();loading=false;try{hub=new HubConnectionBuilder().WithUrl(new Uri(Api.BaseAddress,"hubs/lobby")).WithAutomaticReconnect().Build();hub.On<string>("LobbyDirectoryChanged",_=>InvokeAsync(Refresh));await hub.StartAsync();await hub.InvokeAsync("JoinDirectory");}catch{hub=null;}refreshCancellation=new();timer=new(TimeSpan.FromSeconds(12));_=Poll(refreshCancellation.Token);}
    private async Task Refresh(){try{lobbies=(await Api.GetAsync<IReadOnlyList<PublicLobbySummary>>("api/lobbies"))?.Data??[];StateHasChanged();}catch{} }
    private async Task Poll(CancellationToken cancellationToken){try{while(timer is not null&&await timer.WaitForNextTickAsync(cancellationToken))await InvokeAsync(Refresh);}catch(OperationCanceledException){} }
    public async ValueTask DisposeAsync(){refreshCancellation?.Cancel();timer?.Dispose();if(hub is not null)await hub.DisposeAsync();refreshCancellation?.Dispose();}
}
