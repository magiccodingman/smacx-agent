@page "/lobbies"
@implements IAsyncDisposable
@inject Services.PortalApiClient Api
@using Microsoft.AspNetCore.SignalR.Client
<PageTitle>Lobbies · SMACX Agent</PageTitle>
<PageHeader Kicker="MATCH DIRECTORY" Title="Lobbies" Description="Join, resume, or watch matches visible on this private control center."><MudButton Href="lobbies/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New lobby</MudButton></PageHeader>
<div class="filter-row"><MudTextField T="string" @bind-Value="filter" Immediate="true" Placeholder="Search lobby" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Class="search-field"/><MudChip T="string" Variant="@(statusFilter == "active" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => statusFilter = "active")">Active</MudChip><MudChip T="string" Variant="@(statusFilter == "waiting" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => statusFilter = "waiting")">Waiting</MudChip><MudChip T="string" Variant="@(statusFilter == "running" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => statusFilter = "running")">In progress</MudChip><MudChip T="string" Variant="@(statusFilter == "completed" ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => statusFilter = "completed")">Completed</MudChip></div>
@if (loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
else if (Visible.Count == 0) { <div class="empty-state surface-panel"><div class="empty-orbit"><MudIcon Icon="@Icons.Material.Filled.Groups"/></div><h2>No matching campaigns</h2><p>Try another filter or create a new lobby.</p><MudButton Href="lobbies/new" Variant="Variant.Outlined" Color="Color.Primary">Create lobby</MudButton></div> }
else { <div class="lobby-grid">@foreach (var lobby in Visible) { <a class="surface-panel lobby-card" href="@($"lobbies/{lobby.MatchId}")"><div class="lobby-card-top"><span class="lobby-state @lobby.Status">@lobby.Status</span>@if(lobby.CanSpectate){<MudIcon Icon="@Icons.Material.Filled.Visibility" Title="Observation available"/>}</div><h2>@lobby.DisplayName</h2><div class="lobby-meta"><span><MudIcon Icon="@Icons.Material.Filled.Group"/> @lobby.SeatCount occupied · @lobby.OpenSeatCount open</span><span><MudIcon Icon="@Icons.Material.Filled.Schedule"/> @(lobby.WaitingExpiresAt is null?lobby.UpdatedAt.ToLocalTime().ToString("g"):$"closes {lobby.WaitingExpiresAt.Value.ToLocalTime():t}")</span></div></a> }</div> }
@code {
    private IReadOnlyList<PublicLobbySummary> lobbies=[]; private string filter="", statusFilter="active"; private bool loading=true; private HubConnection? hub; private PeriodicTimer? timer; private CancellationTokenSource? refreshCancellation; private Task? pollTask;
    private IReadOnlyList<PublicLobbySummary> Visible => lobbies.Where(item=>(string.IsNullOrWhiteSpace(filter)||item.DisplayName.Contains(filter,StringComparison.OrdinalIgnoreCase))&&((statusFilter=="active"&&item.Status is not ("completed" or "closed" or "ended" or "deleted"))||(statusFilter=="completed"&&item.Status is "completed" or "closed" or "ended")||(statusFilter=="waiting"&&item.Status=="waiting")||(statusFilter=="running"&&item.Status is "running" or "provisioning"))).ToArray();
    protected override async Task OnInitializedAsync(){await Refresh();loading=false;try{hub=new HubConnectionBuilder().WithUrl(new Uri(Api.BaseAddress,"hubs/lobby")).WithAutomaticReconnect().Build();hub.On<string>("LobbyDirectoryChanged",_=>InvokeAsync(Refresh));await hub.StartAsync();await hub.InvokeAsync("JoinDirectory");}catch{hub=null;}var cancellation=new CancellationTokenSource();var refreshTimer=new PeriodicTimer(TimeSpan.FromSeconds(12));refreshCancellation=cancellation;timer=refreshTimer;pollTask=Poll(refreshTimer,cancellation.Token);}
    private async Task Refresh(){try{lobbies=(await Api.GetAsync<IReadOnlyList<PublicLobbySummary>>("api/lobbies"))?.Data??[];StateHasChanged();}catch{} }
    private async Task Poll(PeriodicTimer refreshTimer,CancellationToken cancellationToken){try{while(await refreshTimer.WaitForNextTickAsync(cancellationToken))await InvokeAsync(Refresh);}catch(OperationCanceledException)when(cancellationToken.IsCancellationRequested){}catch(ObjectDisposedException){} }
    public async ValueTask DisposeAsync(){var cancellation=Interlocked.Exchange(ref refreshCancellation,null);var refreshTimer=Interlocked.Exchange(ref timer,null);var task=Interlocked.Exchange(ref pollTask,null);if(cancellation is not null){try{cancellation.Cancel();}catch(ObjectDisposedException){}}refreshTimer?.Dispose();if(task is not null){try{await task;}catch(OperationCanceledException){}catch(ObjectDisposedException){}}cancellation?.Dispose();var connection=Interlocked.Exchange(ref hub,null);if(connection is not null)await connection.DisposeAsync();}
}
