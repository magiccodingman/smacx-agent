@page "/reset-password"
@inject Services.PortalApiClient Api
@inject NavigationManager Navigation

<PageTitle>Reset password · SMACX Agent</PageTitle>
<div class="auth-stage">
    <section class="auth-card">
        <div class="auth-sigil">↻</div>
        <span class="panel-kicker">ACCOUNT RECOVERY</span>
        <h1>Choose a new password</h1>
        <p>Enter the short-lived reset ticket supplied by a local administrator.</p>
        <MudTextField @bind-Value="username" Label="Username" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="token" Label="Reset ticket" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="password" Label="New password" InputType="InputType.Password"
                      Variant="Variant.Outlined" Immediate="true" HelperText="@PasswordHelp" />
        <MudTextField @bind-Value="confirmation" Label="Confirm password" InputType="InputType.Password"
                      Variant="Variant.Outlined" Immediate="true" />
        <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Large" Disabled="busy" OnClick="Complete">
            Reset and sign in
        </MudButton>
        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@error</MudAlert>
        }
    </section>
</div>

@code {
    private string username = "";
    private string token = "";
    private string password = "";
    private string confirmation = "";
    private string? error;
    private bool busy;
    private int passwordMinimumLength = 8;
    private string PasswordHelp =>
        $"At least {passwordMinimumLength} characters with upper, lower, and a number.";

    protected override async Task OnInitializedAsync()
    {
        passwordMinimumLength = (await Api.GetAsync<PortalSetupState>("api/auth/setup"))
            ?.Data?.PasswordMinimumLength ?? 8;
    }

    private async Task Complete()
    {
        busy = true;
        error = null;
        var result = await Api.PostAsync<PortalSession>("api/auth/reset/complete",
            new CompletePasswordResetRequest(username, token, password, confirmation));
        busy = false;
        if (result.Payload?.Ok == true) Navigation.NavigateTo("/", true);
        else error = result.Payload?.Error?.Message ?? "Password reset failed.";
    }
}
