@page "/admin/providers"
@attribute [Authorize(Roles = "Administrator")]
@inject Services.PortalApiClient Api
@inject IJSRuntime Js
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>AI providers · SMACX Agent</PageTitle>
<PageHeader Kicker="AGENT INFRASTRUCTURE"
            Title="Models & AI profiles"
            Description="First connect an OpenAI-compatible model endpoint. Then turn one discovered model into a selectable AI player profile." />

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (providerEditorOpen || profileEditorOpen)
    {
    <div class="editor-modal-backdrop" role="presentation">
      <div class="editor-modal-card" role="dialog" aria-modal="true">
      @if (providerEditorOpen)
      {
        <section class="surface-panel form-panel" id="endpoint-editor">
            <span class="panel-kicker">STEP 1</span>
            <h2>@(IsEditingProvider ? "Edit model endpoint" : "Connect a model endpoint")</h2>
            <p class="section-copy">
                @(IsEditingProvider
                    ? "Update this endpoint without exposing its stored API key. Saving also refreshes its available models."
                    : "Saving the endpoint discovers its available models. It does not create a playable AI profile yet.")
            </p>
            <MudTextField @bind-Value="providerName" Label="Display name" Variant="Variant.Outlined"
                          HelperText="Use a unique label for each model endpoint."
                          InputId="smacx-provider-label" autocomplete="off" name="smacx_provider_label"
                          data-form-type="other" data-1p-ignore="true" data-lpignore="true" />
            <MudTextField @bind-Value="providerUrl" Label="OpenAI-compatible base URL"
                          Placeholder="http://model-host:8000/v1"
                          HelperText="Enter a URL reachable from the Docker containers. No model-server address is shipped as a default."
                          Variant="Variant.Outlined" Immediate="true"
                          InputId="smacx-provider-endpoint" autocomplete="off" name="smacx_provider_endpoint"
                          InputMode="InputMode.url" autocapitalize="none" spellcheck="false"
                          data-form-type="other" data-1p-ignore="true" data-lpignore="true" />
            <MudTextField @bind-Value="providerKey" Label="API key (optional)"
                          HelperText="@ProviderKeyHelp"
                          InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true"
                          Disabled="removeProviderKey"
                          InputId="smacx-provider-token" autocomplete="new-password" name="smacx_provider_api_token"
                          autocapitalize="none" spellcheck="false"
                          data-form-type="other" data-1p-ignore="true" data-lpignore="true" />
            @if (IsEditingProvider && editingProviderHasKey)
            {
                <MudCheckBox @bind-Value="removeProviderKey" Label="Remove the currently stored API key" Color="Color.Warning" />
            }
            <div class="form-actions endpoint-editor-actions">
                <MudButton Variant="Variant.Text" Disabled="busy" OnClick="CloseProviderEditor">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSaveProvider)"
                           OnClick="SaveProvider" StartIcon="@Icons.Material.Filled.Hub">
                    @(IsEditingProvider ? "Save changes & discover models" : "Save endpoint & discover models")
                </MudButton>
            </div>
        </section>
      }
      @if (profileEditorOpen)
      {
        <section class="surface-panel form-panel">
            <span class="panel-kicker">STEP 2</span>
            <h2>@(editingProfileId is null ? "Create an AI player profile" : $"Edit {profileName}")</h2>
            <p class="section-copy">This named profile appears in the lobby’s AI-player picker and owns its analytics history. Editing it keeps that identity intact.</p>

            @if (Providers.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="setup-callout">
                    Complete step 1 before creating an AI player profile.
                </MudAlert>
            }
            else
            {
                <MudTextField @bind-Value="profileName" Label="Profile name" Variant="Variant.Outlined" Immediate="true"
                              HelperText="Names are unique across active and inactive profiles because this identity owns its complete analytics history." />
                <MudSelect T="string" Value="@selectedProvider" Label="Model endpoint"
                           Variant="Variant.Outlined" ValueChanged="ProviderChanged">
                    @foreach (var provider in Providers)
                    {
                        <MudSelectItem Value="@Id(provider)">@Text(provider, "display_name")</MudSelectItem>
                    }
                </MudSelect>

                @if (Models.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="setup-callout">
                        This endpoint has no discovered models yet. Make sure it is online, then discover again.
                        <div class="setup-callout-actions">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       Disabled="busy" OnClick="() => Discover(selectedProvider)">
                                Discover models
                            </MudButton>
                        </div>
                    </MudAlert>
                }
                else
                {
                    <MudSelect T="string" Value="@selectedModel" ValueChanged="ModelChanged" Label="Model" Variant="Variant.Outlined">
                        @foreach (var model in Models)
                        {
                            <MudSelectItem Value="@Id(model, "model_id")">@Text(model, "display_name")</MudSelectItem>
                        }
                    </MudSelect>
                }

                <MudNumericField T="int?" @bind-Value="contextLength" Label="Gameplay context budget (optional)"
                                 Placeholder="Automatic" Variant="Variant.Outlined" Min="65536"
                                 Max="@SelectedModelContextMaximum" Clearable="true" />
                <span class="field-help flush">@ContextHelp</span>

                <MudSelect T="string" Value="@generationPreset" ValueChanged="GenerationPresetChanged"
                           Label="Start from template" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("provider-default")">Provider defaults · widest compatibility</MudSelectItem>
                    @if (IsQwen38)
                    {
                        <MudSelectItem T="string" Value="@("qwen38-instant")">Qwen3.8 Instant · thinking disabled</MudSelectItem>
                        <MudSelectItem T="string" Value="@("qwen38-low")">Qwen3.8 Low · efficient reasoning</MudSelectItem>
                        <MudSelectItem T="string" Value="@("qwen38-medium")">Qwen3.8 Medium · balanced reasoning</MudSelectItem>
                        <MudSelectItem T="string" Value="@("qwen38-high")">Qwen3.8 High · provider-dependent</MudSelectItem>
                        <MudSelectItem T="string" Value="@("qwen38-xhigh")">Qwen3.8 XHigh · deepest reasoning</MudSelectItem>
                    }
                    <MudSelectItem T="string" Value="@("custom")">Blank custom template</MudSelectItem>
                </MudSelect>
                <span class="field-help flush">@GenerationHelp</span>

                <MudExpansionPanels Class="generation-panel">
                    <MudExpansionPanel Text="Sampling, output & provider request parameters" Expanded="true">
                            <div class="template-reset-row">
                                <div class="generation-summary">@GenerationSummary</div>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt"
                                           OnClick="ResetTemplateDefaults">Reset template defaults</MudButton>
                            </div>
                            <div class="field-pair generation-fields">
                                <MudNumericField T="double?" @bind-Value="temperature" Label="Temperature" Variant="Variant.Outlined" Min="0" Max="2" />
                                <MudNumericField T="double?" @bind-Value="topP" Label="Top P" Variant="Variant.Outlined" Min="0" Max="1" />
                                <MudNumericField T="int?" @bind-Value="topK" Label="Top K" Variant="Variant.Outlined" Min="0" Max="100000" />
                                <MudNumericField T="double?" @bind-Value="minP" Label="Min P" Variant="Variant.Outlined" Min="0" Max="1" />
                                <MudNumericField T="double?" @bind-Value="presencePenalty" Label="Presence penalty" Variant="Variant.Outlined" Min="-2" Max="2" />
                                <MudNumericField T="double?" @bind-Value="frequencyPenalty" Label="Frequency penalty" Variant="Variant.Outlined" Min="-2" Max="2" />
                                <MudNumericField T="double?" @bind-Value="repetitionPenalty" Label="Repetition penalty" Variant="Variant.Outlined" Min="0.01" Max="2" />
                                <MudNumericField T="int?" @bind-Value="maxOutputTokens" Label="Maximum output tokens (optional)" Variant="Variant.Outlined" Min="1" Max="262144" />
                                <MudNumericField T="int?" @bind-Value="seed" Label="Seed (optional)" Variant="Variant.Outlined" />
                            </div>
                            <div class="custom-parameter-editor">
                                <div class="panel-heading"><div><strong>Additional request parameters</strong><small>These are sent as JSON alongside the common controls. Values may be true, 20, "text", arrays, or objects.</small></div><MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddExtraParameter">Add parameter</MudButton></div>
                                @foreach (var parameter in extraParameters)
                                {
                                    <div class="custom-parameter-row">
                                        <MudTextField @bind-Value="parameter.Key" Label="Key" Variant="Variant.Outlined" Immediate="true" />
                                        <MudTextField @bind-Value="parameter.Value" Label="JSON value" Variant="Variant.Outlined" Immediate="true" />
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => RemoveExtraParameter(parameter))" aria-label="Remove parameter" />
                                    </div>
                                }
                            </div>
                            <MudSelect T="string" @bind-Value="reasoning" Label="Reasoning effort" Variant="Variant.Outlined"
                                       HelperText="Gameplay passes this intent through Hermes; direct services such as Graphiti send it as the endpoint's top-level reasoning_effort field. Model support varies.">
                                @foreach (var value in reasoningValues)
                                {
                                    <MudSelectItem Value="@value">@value</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="reasoningContinuity"
                                       Label="Active tool-chain reasoning" Variant="Variant.Outlined"
                                       HelperText="Automatic retains current-episode reasoning only when chat_template_kwargs enables thinking. Completed earlier reasoning is always removed from managed requests.">
                                <MudSelectItem T="string" Value="@("automatic")">Automatic · recommended</MudSelectItem>
                                <MudSelectItem T="string" Value="@("current_episode")">Retain current tool episode</MudSelectItem>
                                <MudSelectItem T="string" Value="@("off")">Do not replay reasoning</MudSelectItem>
                            </MudSelect>
                            @if (!string.IsNullOrWhiteSpace(ReasoningCompatibilityWarning))
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">@ReasoningCompatibilityWarning</MudAlert>
                            }
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                                Saving proves these settings are stored. A successful acceptance test proves the endpoint accepted the request—not that it honored every parameter semantically.
                            </MudAlert>
                            <span class="field-help flush">Blank common fields are omitted. Unsupported extensions may be rejected or silently ignored by an OpenAI-compatible server.</span>
                    </MudExpansionPanel>
                </MudExpansionPanels>
                <MudTextField @bind-Value="profileNotes" Label="Operator note (optional)" Lines="2" Variant="Variant.Outlined" />
                <span class="field-help flush">Faction and personality are chosen independently for each AI seat when a lobby is created; they are not properties of the reusable model profile.</span>
                <div class="profile-portability">
                    <div>
                        <strong>Portable profile template</strong>
                        <span>Import or export model settings without copying endpoint IDs, API keys, agent IDs, or match history.</span>
                    </div>
                    <div class="endpoint-actions">
                        <label class="mud-button-root mud-button mud-button-text mud-button-text-primary mud-button-text-size-small profile-import-button">
                            <span class="mud-button-label">Import JSON</span>
                            <InputFile OnChange="ImportProfileTemplate" accept="application/json,.json" />
                        </label>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Download" OnClick="ExportProfileTemplate">
                            Export JSON
                        </MudButton>
                    </div>
                </div>
                <div class="form-actions"><MudButton Variant="Variant.Text" OnClick="CloseProfileEditor" Disabled="busy">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanCreateProfile)"
                           OnClick="CreateProfile" StartIcon="@Icons.Material.Filled.SmartToy">
                    @(editingProfileId is null ? "Create playable AI profile" : "Update")
                </MudButton></div>
            }
        </section>
      }
      </div>
    </div>
    }

    <section class="surface-panel admin-list-panel mt-4">
        <div class="panel-heading">
            <div><span class="panel-kicker">CONFIGURED ENDPOINTS</span><h2>Model endpoints</h2></div>
            <div class="endpoint-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenProviderEditor">New endpoint</MudButton><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Reload" aria-label="Refresh endpoints" /></div>
        </div>
        @if (Providers.Count == 0)
        {
            <div class="empty-state compact">
                <MudIcon Icon="@Icons.Material.Filled.Hub" />
                <strong>No endpoints configured</strong>
                <span>Add a local, LAN, or hosted OpenAI-compatible endpoint in step 1.</span>
            </div>
        }
        @foreach (var provider in Providers)
        {
            <div class="admin-list-row">
                <div><strong>@Text(provider, "display_name")</strong><small>@Text(provider, "base_url")</small></div>
                <span class="status-badge">@Text(provider, "status")</span>
                <span>@(provider.TryGetProperty("has_api_key", out var keyed) && keyed.GetBoolean() ? "managed key" : "no key")</span>
                <div class="endpoint-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="busy" OnClick="() => Discover(Id(provider))">Discover</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="busy"
                               StartIcon="@Icons.Material.Filled.Edit" OnClick="() => EditProvider(provider)">Edit</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="busy"
                               StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="() => BeginRemoveProvider(provider)">Remove</MudButton>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(pendingDeleteId))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="endpoint-remove-confirmation">
                <strong>Remove @pendingDeleteName?</strong>
                <div>This permanently removes the endpoint and its managed API key. Endpoints referenced by AI profiles or historical harness configuration are protected and cannot be removed.</div>
                <div class="setup-callout-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="busy" OnClick="CancelRemoveProvider">Cancel</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" Disabled="busy"
                               StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="RemoveProvider">Remove unused endpoint</MudButton>
                </div>
            </MudAlert>
        }
    </section>

    <section class="surface-panel admin-list-panel mt-4 semantic-embedding-panel">
        <div class="panel-heading">
            <div>
                <span class="panel-kicker">SHARED SEMANTIC SERVICE</span>
                <h2>Text embeddings</h2>
                <p class="section-copy">One embedding space powers both the Datalinks rules library and optional Graphiti memory. The built-in CPU model is recommended and loaded only once.</p>
            </div>
        </div>
        <div class="embedding-settings-grid">
            <MudSelect T="string" @bind-Value="embeddingMode" Label="Embedding runtime" Variant="Variant.Outlined">
                <MudSelectItem Value="@("local")">Built-in CPU model · recommended</MudSelectItem>
                <MudSelectItem Value="@("external")">External OpenAI-compatible endpoint</MudSelectItem>
                <MudSelectItem Value="@("disabled")">Disabled · disables semantic rules and Graphiti</MudSelectItem>
            </MudSelect>
            @if (embeddingMode == "external")
            {
                <MudSelect T="string" Value="@embeddingProviderId" ValueChanged="EmbeddingProviderChanged" Label="Embedding endpoint" Variant="Variant.Outlined">
                    @foreach (var provider in Providers)
                    {
                        <MudSelectItem Value="@Id(provider)">@Text(provider, "display_name")</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="embeddingModelId" Label="Embedding model" Variant="Variant.Outlined">
                    @foreach (var model in EmbeddingModels)
                    {
                        <MudSelectItem Value="@Id(model, "model_id")">@Text(model, "display_name")</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int?" @bind-Value="embeddingDimensions" Label="Vector dimensions" Min="1" Max="65536" Variant="Variant.Outlined" HelperText="Must exactly match the selected embedding model." />
                <MudTextField @bind-Value="embeddingSpaceId" Label="Embedding space ID" Variant="Variant.Outlined" HelperText="Change this when model weights or vector semantics change so the corpus is rebuilt safely." />
            }
        </div>
        <div class="form-actions embedding-actions">
            <span class="field-help flush">Switching embedding spaces safely rebuilds the rules index and Graphiti projection. Docker startup configuration is not required.</span>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEmbeddings" Disabled="@(!CanSaveEmbeddings || busy)">Save embedding runtime</MudButton>
        </div>
    </section>

    <section class="surface-panel admin-list-panel mt-4">
        <div class="panel-heading">
            <div><span class="panel-kicker">LOBBY-READY CONFIGURATION</span><h2>AI player profiles</h2></div>
            <div class="endpoint-actions">
                <MudSwitch @bind-Value="showInactiveProfiles" Color="Color.Primary">Show inactive</MudSwitch>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="@(Providers.Count==0)" OnClick="OpenProfileEditor">New AI profile</MudButton>
            </div>
        </div>
        @if (profiles.Count == 0)
        {
            <div class="empty-state compact">
                <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                <strong>No playable profiles yet</strong>
                <span>Discover a model, then complete step 2. A model endpoint alone cannot occupy a lobby seat.</span>
            </div>
        }
        else if (!VisibleProfiles.Any())
        {
            <div class="empty-state compact">
                <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" />
                <strong>No active profiles</strong>
                <span>Turn on Show inactive to review or reactivate a previous AI identity and its connected analytics.</span>
            </div>
        }
        @foreach (var profile in VisibleProfiles)
        {
            <div class="admin-list-row">
                <div>
                    <strong>@profile.DisplayName</strong>
                    <small>@profile.ModelId · @profile.ReasoningEffort reasoning · @GenerationLabel(profile.Generation) · @GameplayContext(profile.ContextLength) gameplay context</small>
                    <small>@AcceptanceDescription(profile.Acceptance)</small>
                </div>
                <span class="status-badge">@(profile.Active ? "active" : "inactive")</span>
                <span class="status-badge @AcceptanceClass(profile.Acceptance)">@AcceptanceLabel(profile.Acceptance)</span>
                <div class="endpoint-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="busy"
                               StartIcon="@Icons.Material.Filled.Science"
                               OnClick="() => TestProviderAcceptance(profile)">Test provider acceptance</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Edit" OnClick="() => EditProfile(profile)">Edit</MudButton>
                    @if (profile.Active)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="() => SetProfileActive(profile.ProfileId, false)">Deactivate</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => SetProfileActive(profile.ProfileId, true)">Reactivate</MudButton>
                    }
                </div>
            </div>
        }
    </section>
}

@if (!string.IsNullOrEmpty(notice))
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-4">@notice</MudAlert>
}
@if (!string.IsNullOrEmpty(error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>
}

@code {
    private AdminSnapshot? snapshot;
    private List<AiProfile> profiles = [];
    private bool loading = true;
    private bool busy;
    private bool providerEditorOpen;
    private bool profileEditorOpen;
    private string? error;
    private string? notice;
    private string providerName = "Local model server";
    private string providerUrl = "";
    private string providerKey = "";
    private string? editingProviderId;
    private bool editingProviderHasKey;
    private bool removeProviderKey;
    private string? pendingDeleteId;
    private string? pendingDeleteName;
    private string embeddingMode = "local";
    private string? embeddingProviderId;
    private string? embeddingModelId;
    private string? embeddingSpaceId;
    private int? embeddingDimensions;
    private string profileName = "SMACX player";
    private string? editingProfileId;
    private bool showInactiveProfiles;
    private string selectedProvider = "";
    private string selectedModel = "";
    private string reasoning = "low";
    private string reasoningContinuity = "automatic";
    private string generationPreset = "provider-default";
    private string profileNotes = "";
    private int? contextLength;
    private double? temperature;
    private double? topP;
    private int? topK;
    private double? minP;
    private double? presencePenalty;
    private double? frequencyPenalty;
    private double? repetitionPenalty;
    private int? maxOutputTokens;
    private int? seed;
    private readonly List<ExtraParameterDraft> extraParameters = [];

    private readonly string[] reasoningValues = ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"];
    private List<JsonElement> Providers => snapshot is null ? [] : snapshot.Providers.EnumerateArray().ToList();
    private IEnumerable<AiProfile> VisibleProfiles => profiles.Where(profile => profile.Active || showInactiveProfiles);
    private IEnumerable<JsonElement> EmbeddingModels => string.IsNullOrWhiteSpace(embeddingProviderId)
        ? []
        : Providers.Where(item => Id(item) == embeddingProviderId)
            .SelectMany(item => item.TryGetProperty("models", out var models) ? models.EnumerateArray() : [])
            .ToArray();
    private bool CanSaveEmbeddings => embeddingMode != "external" ||
        (!string.IsNullOrWhiteSpace(embeddingProviderId) &&
         !string.IsNullOrWhiteSpace(embeddingModelId) &&
         embeddingDimensions > 0 && !string.IsNullOrWhiteSpace(embeddingSpaceId));
    private List<JsonElement> Models => Providers.FirstOrDefault(provider => Id(provider) == selectedProvider) is var provider
        && provider.ValueKind == JsonValueKind.Object
        && provider.TryGetProperty("models", out var models)
            ? models.EnumerateArray().ToList()
            : [];
    private bool CanSaveProvider => !busy
        && !string.IsNullOrWhiteSpace(providerName)
        && Uri.TryCreate(providerUrl, UriKind.Absolute, out var uri)
        && uri.Scheme is "http" or "https";
    private bool IsEditingProvider => !string.IsNullOrWhiteSpace(editingProviderId);
    private string ProviderKeyHelp => IsEditingProvider && editingProviderHasKey
        ? "Leave blank to keep the stored key, enter a replacement, or select Remove below. The current key is never returned to the browser."
        : "Leave blank when authentication is not required. Stored in the control vault and never returned; password managers are asked to ignore this field.";
    private bool CanCreateProfile => !busy
        && !string.IsNullOrWhiteSpace(profileName)
        && !string.IsNullOrWhiteSpace(selectedProvider)
        && !string.IsNullOrWhiteSpace(selectedModel);
    private bool IsQwen38 => selectedModel.Contains("qwen3.8", StringComparison.OrdinalIgnoreCase);
    private int? SelectedModelContextMaximum
    {
        get
        {
            var provider = Providers.FirstOrDefault(item => Id(item) == selectedProvider);
            if (provider.ValueKind == JsonValueKind.Object &&
                provider.TryGetProperty("context_length_override", out var configured) &&
                configured.ValueKind == JsonValueKind.Number)
                return configured.GetInt32();
            var model = Models.FirstOrDefault(item => Id(item, "model_id") == selectedModel);
            return model.ValueKind == JsonValueKind.Object &&
                model.TryGetProperty("context_length", out var advertised) &&
                advertised.ValueKind == JsonValueKind.Number
                    ? advertised.GetInt32()
                    : null;
        }
    }
    private string ContextHelp => SelectedModelContextMaximum is { } maximum
        ? $"Automatic is recommended and will use the model's advertised {maximum:N0}-token context. A manual value must be between 65,536 and {maximum:N0}."
        : "Automatic is recommended and uses the context advertised by the endpoint. Enter at least 65,536 only when you intentionally want a smaller working context.";
    private string GenerationHelp => generationPreset switch
    {
        "qwen38-instant" => "Qwen3.8 non-thinking starting values. preserve_thinking is explicitly false.",
        "qwen38-low" => "Qwen3.8 thinking starting values with Hermes low reasoning and preserve_thinking explicitly false.",
        "qwen38-medium" => "Qwen3.8 thinking starting values with Hermes medium reasoning and preserve_thinking explicitly false.",
        "qwen38-high" => "A provider-dependent High variant. Qwen documents low, medium, and xhigh; test this endpoint before relying on high.",
        "qwen38-xhigh" => "Qwen3.8 thinking starting values with Hermes xhigh reasoning and preserve_thinking explicitly false.",
        "custom" => "A blank editable starting point. Only populated values are sent.",
        _ => "Starts blank for widest compatibility. You may still add explicit overrides below.",
    };
    private string GenerationSummary => "The values shown below are authoritative. Templates never lock or silently restore fields.";
    private string? ReasoningCompatibilityWarning
    {
        get
        {
            var template = extraParameters.FirstOrDefault(item => item.Key == "chat_template_kwargs");
            if (template is null) return null;
            try
            {
                using var document = JsonDocument.Parse(template.Value);
                if (!document.RootElement.TryGetProperty("enable_thinking", out var enabled) ||
                    enabled.ValueKind is not (JsonValueKind.True or JsonValueKind.False)) return null;
                if (enabled.GetBoolean() && reasoning == "none")
                    return "Thinking is enabled but reasoning effort is omitted. Qwen3.8 may fall back to its endpoint default (xhigh on the reference configuration). Choose an explicit effort or disable thinking.";
                if (!enabled.GetBoolean() && reasoning != "none")
                    return "Thinking is disabled in chat_template_kwargs, so the selected reasoning effort is not expected to change model behavior.";
                if (enabled.GetBoolean() && IsQwen38 && reasoning is not ("low" or "medium" or "xhigh"))
                    return "Qwen3.8 documents low, medium, and xhigh. This effort is provider-dependent; verify it before using the profile.";
            }
            catch (JsonException) { return null; }
            return null;
        }
    }

    protected override async Task OnInitializedAsync() => await Reload();

    private Task Reload() => Reload(null);

    private async Task Reload(string? preferredProvider)
    {
        loading = true;
        error = null;
        try
        {
            snapshot = (await Api.GetAsync<AdminSnapshot>("api/admin/snapshot"))?.Data;
            profiles = ((await Api.GetAsync<IReadOnlyList<AiProfile>>("api/admin/ai-profiles"))?.Data ?? []).ToList();
            if (snapshot is not null && snapshot.Graphiti.TryGetProperty("embeddings", out var embeddings) && embeddings.ValueKind == JsonValueKind.Object)
            {
                embeddingMode = Text(embeddings, "mode");
                if (string.IsNullOrWhiteSpace(embeddingMode)) embeddingMode = "local";
                embeddingProviderId = TextOrNull(embeddings, "provider_id");
                embeddingModelId = TextOrNull(embeddings, "model_id");
                embeddingDimensions = embeddings.TryGetProperty("dimensions", out var dimensions) && dimensions.TryGetInt32(out var number) && number > 0 ? number : null;
                embeddingSpaceId = TextOrNull(embeddings, "space_id");
            }
            var candidate = preferredProvider ?? selectedProvider;
            selectedProvider = Providers.Any(provider => Id(provider) == candidate)
                ? candidate
                : Providers.FirstOrDefault().ValueKind == JsonValueKind.Object
                    ? Id(Providers[0])
                    : "";
            ProviderChanged(selectedProvider);
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveProvider()
    {
        if (!CanSaveProvider)
        {
            error = "Enter a display name and an absolute HTTP or HTTPS model endpoint URL.";
            return;
        }
        busy = true;
        error = null;
        notice = null;
        try
        {
            var providerId = editingProviderId;
            var apiKey = removeProviderKey
                ? ""
                : string.IsNullOrEmpty(providerKey) ? null : providerKey;
            var result = await Api.PostAsync<JsonElement>("api/admin/providers",
                new ProviderConfigurationRequest(providerName, providerUrl, apiKey, providerId));
            if (result.Payload?.Ok != true)
            {
                error = result.Payload?.Error?.Message ?? "The endpoint could not be saved.";
            }
            else
            {
                var id = Id(result.Payload.Data);
                var discovered = await Api.PostAsync<JsonElement>($"api/admin/providers/{id}/discover", new { });
                if (discovered.Payload?.Ok != true)
                {
                    error = discovered.Payload?.Error?.Message;
                }
                await Reload(id);
                notice = Models.Count > 0
                    ? $"Endpoint {(providerId is null ? "saved" : "updated")} and {Models.Count} model{(Models.Count == 1 ? "" : "s")} discovered. Complete step 2 to make an AI player."
                    : $"Endpoint {(providerId is null ? "saved" : "updated")}, but it did not advertise any models yet.";
                ResetProviderForm();
                providerEditorOpen = false;
            }
        }
        catch (HttpRequestException)
        {
            error = "The portal could not reach its server. Check the service and try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private void EditProvider(JsonElement provider)
    {
        providerEditorOpen = true;
        profileEditorOpen = false;
        editingProviderId = Id(provider);
        providerName = Text(provider, "display_name");
        providerUrl = Text(provider, "base_url");
        providerKey = "";
        editingProviderHasKey = provider.TryGetProperty("has_api_key", out var keyed) && keyed.GetBoolean();
        removeProviderKey = false;
        pendingDeleteId = null;
        pendingDeleteName = null;
        error = null;
        notice = null;
    }

    private void ResetProviderForm()
    {
        editingProviderId = null;
        editingProviderHasKey = false;
        removeProviderKey = false;
        providerName = "Local model server";
        providerUrl = "";
        providerKey = "";
    }

    private void OpenProviderEditor()
    {
        ResetProviderForm(); providerEditorOpen = true; profileEditorOpen = false;
        error = null; notice = null;
    }

    private void CloseProviderEditor()
    {
        providerEditorOpen = false; ResetProviderForm(); error = null;
    }

    private void OpenProfileEditor()
    {
        ResetProfileForm(); profileEditorOpen = true; providerEditorOpen = false;
        error = null; notice = null;
    }

    private void CloseProfileEditor()
    {
        profileEditorOpen = false; ResetProfileForm(); error = null;
    }

    private void BeginRemoveProvider(JsonElement provider)
    {
        pendingDeleteId = Id(provider);
        pendingDeleteName = Text(provider, "display_name");
        error = null;
        notice = null;
    }

    private void CancelRemoveProvider()
    {
        pendingDeleteId = null;
        pendingDeleteName = null;
    }

    private async Task RemoveProvider()
    {
        if (string.IsNullOrWhiteSpace(pendingDeleteId)) return;
        var providerId = pendingDeleteId;
        var providerNameToRemove = pendingDeleteName ?? "endpoint";
        busy = true;
        error = null;
        notice = null;
        try
        {
            var result = await Api.PostAsync<JsonElement>($"api/admin/providers/{providerId}/delete", new { });
            if (result.Payload?.Ok != true)
            {
                error = result.Payload?.Error?.Message ?? "The endpoint could not be removed.";
                return;
            }
            if (editingProviderId == providerId) ResetProviderForm();
            CancelRemoveProvider();
            await Reload();
            notice = $"{providerNameToRemove} was removed.";
        }
        catch (HttpRequestException)
        {
            error = "The portal could not reach its server. Check the service and try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Discover(string id)
    {
        if (string.IsNullOrWhiteSpace(id)) return;
        busy = true;
        error = null;
        notice = null;
        var result = await Api.PostAsync<JsonElement>($"api/admin/providers/{id}/discover", new { });
        if (result.Payload?.Ok != true) error = result.Payload?.Error?.Message;
        await Reload(id);
        if (result.Payload?.Ok == true)
            notice = Models.Count > 0 ? $"Discovered {Models.Count} model{(Models.Count == 1 ? "" : "s")}." : "The endpoint is saved, but no models were returned.";
        busy = false;
    }

    private Task EmbeddingProviderChanged(string value)
    {
        embeddingProviderId = value;
        var models = EmbeddingModels.ToArray();
        embeddingModelId = models.Length == 1 ? Id(models[0], "model_id") : null;
        return Task.CompletedTask;
    }

    private async Task SaveEmbeddings()
    {
        busy = true;
        error = null;
        notice = null;
        var result = await Api.PostAsync<JsonElement>("api/admin/embeddings",
            new EmbeddingConfigurationRequest(embeddingMode, embeddingProviderId, embeddingModelId,
                embeddingDimensions, embeddingSpaceId));
        if (result.Payload?.Ok == true)
            notice = "Embedding runtime saved. Semantic services will rebuild safely if the embedding space changed.";
        else
            error = result.Payload?.Error?.Message ?? "The embedding runtime could not be saved.";
        await Reload(selectedProvider);
        busy = false;
    }

    private async Task CreateProfile()
    {
        if (!CanCreateProfile)
        {
            error = "Choose a discovered model and enter a profile name.";
            return;
        }
        busy = true;
        error = null;
        notice = null;
        ModelGenerationSettings generation;
        try { generation = BuildGeneration(); }
        catch (InvalidOperationException exception) { error = exception.Message; busy = false; return; }
        var result = await Api.PostAsync<AiProfile>("api/admin/ai-profiles",
            new AiProfileRequest(profileName, selectedProvider, selectedModel, reasoning, contextLength,
                string.IsNullOrWhiteSpace(profileNotes) ? null : profileNotes,
                ProfileId: editingProfileId,
                Generation: generation));
        if (result.Payload?.Ok != true)
        {
            error = result.Payload?.Error?.Message;
        }
        else
        {
            var savedProfile = result.Payload.Data!;
            ResetProfileForm(resetFields: false);
            await Reload(selectedProvider);
            notice = $"{savedProfile.DisplayName} was stored and is available in new lobbies. Test provider acceptance before relying on custom parameters.";
            profileEditorOpen = false;
        }
        busy = false;
    }

    private async Task ExportProfileTemplate()
    {
        ModelGenerationSettings generation;
        try { generation = BuildGeneration(); }
        catch (InvalidOperationException exception) { error = exception.Message; return; }
        var template = new PortableProfileTemplate(
            1, profileName.Trim(), selectedModel, reasoning, contextLength,
            string.IsNullOrWhiteSpace(profileNotes) ? null : profileNotes.Trim(), generation);
        var json = JsonSerializer.Serialize(template, new JsonSerializerOptions(JsonSerializerDefaults.Web)
        {
            WriteIndented = true,
        });
        var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/profile-portability.js");
        await module.InvokeVoidAsync("downloadJson", SafeFileName(profileName) + ".smacx-ai-profile.json", json);
        await module.DisposeAsync();
        notice = "Portable AI profile template downloaded. It contains no API key or installation-specific IDs.";
        error = null;
    }

    private async Task ImportProfileTemplate(InputFileChangeEventArgs args)
    {
        error = null;
        notice = null;
        try
        {
            await using var stream = args.File.OpenReadStream(256 * 1024);
            var template = await JsonSerializer.DeserializeAsync<PortableProfileTemplate>(stream,
                new JsonSerializerOptions(JsonSerializerDefaults.Web));
            if (template is null || template.SchemaVersion != 1)
                throw new InvalidOperationException("This is not a supported SMACX AI profile template.");
            if (string.IsNullOrWhiteSpace(template.DisplayName) || string.IsNullOrWhiteSpace(template.ModelId))
                throw new InvalidOperationException("The profile template must include a display name and model ID.");
            if (template.ContextLength is > 0 and < 65536)
                throw new InvalidOperationException("Imported gameplay context must be automatic or at least 65,536 tokens.");

            profileName = template.DisplayName.Trim();
            profileNotes = template.Notes ?? "";
            reasoning = template.ReasoningEffort;
            contextLength = template.ContextLength;
            ApplyGeneration(template.Generation ?? new ModelGenerationSettings());
            if (Models.Any(model => Id(model, "model_id") == template.ModelId))
            {
                selectedModel = template.ModelId;
                if (SelectedModelContextMaximum is { } maximum && contextLength > maximum)
                    contextLength = maximum;
                notice = $"Imported settings for {template.ModelId}. Review them, then create the profile.";
            }
            else
            {
                selectedModel = "";
                error = $"The selected endpoint does not advertise '{template.ModelId}'. Choose an endpoint that has that model, or select a compatible discovered model before creating the profile.";
            }
        }
        catch (JsonException)
        {
            error = "The selected file is not valid profile JSON.";
        }
        catch (InvalidOperationException exception)
        {
            error = exception.Message;
        }
        catch (IOException)
        {
            error = "The profile file could not be read or is larger than 256 KiB.";
        }
    }

    private async Task SetProfileActive(string id, bool active)
    {
        busy = true;
        error = null;
        notice = null;
        var action = active ? "reactivate" : "deactivate";
        var result = await Api.PostAsync<AiProfile>($"api/admin/ai-profiles/{id}/{action}", new { });
        if (result.Payload?.Ok != true) error = result.Payload?.Error?.Message;
        else notice = $"{result.Payload.Data!.DisplayName} is now {(active ? "active" : "inactive")}.";
        await Reload(selectedProvider);
        busy = false;
    }

    private async Task TestProviderAcceptance(AiProfile profile)
    {
        busy = true;
        error = null;
        notice = null;
        try
        {
            var result = await Api.PostAsync<GenerationAcceptanceStatus>(
                $"api/admin/ai-profiles/{profile.ProfileId}/test-provider-acceptance", new { });
            if (result.Payload?.Ok != true)
                error = result.Payload?.Error?.Message ?? "The provider acceptance test could not run.";
            else
                notice = result.Payload.Data!.Accepted == true
                    ? "The endpoint accepted the serialized profile request. Semantic application remains unverified."
                    : result.Payload.Data.Message;
            await Reload(selectedProvider);
        }
        catch (HttpRequestException)
        {
            error = "The portal could not reach its server. Check the service and try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private void ProviderChanged(string value)
    {
        selectedProvider = value;
        ModelChanged(Models.Count == 1 && Models[0].ValueKind == JsonValueKind.Object
            ? Id(Models[0], "model_id")
            : "");
    }

    private void ModelChanged(string value)
    {
        selectedModel = value;
        contextLength = null;
        reasoning = IsQwen38 ? "low" : "none";
        GenerationPresetChanged(IsQwen38 ? "qwen38-low" : "provider-default");
    }

    private void EditProfile(AiProfile profile)
    {
        profileEditorOpen = true;
        providerEditorOpen = false;
        editingProfileId = profile.ProfileId;
        profileName = profile.DisplayName;
        selectedProvider = profile.ProviderId;
        selectedModel = profile.ModelId;
        reasoning = profile.ReasoningEffort;
        contextLength = profile.ContextLength;
        profileNotes = profile.Notes ?? "";
        ApplyGeneration(profile.Generation);
        error = null;
        notice = null;
    }

    private void ResetProfileForm(bool resetFields = true)
    {
        editingProfileId = null;
        if (!resetFields) return;
        profileName = "SMACX player";
        profileNotes = "";
        contextLength = null;
        ProviderChanged(selectedProvider);
    }

    private void ApplyGeneration(ModelGenerationSettings generation)
    {
        generationPreset = generation.Preset;
        temperature = generation.Temperature;
        topP = generation.TopP;
        topK = generation.TopK;
        minP = generation.MinP;
        presencePenalty = generation.PresencePenalty;
        frequencyPenalty = generation.FrequencyPenalty;
        repetitionPenalty = generation.RepetitionPenalty;
        maxOutputTokens = generation.MaxOutputTokens;
        seed = generation.Seed;
        reasoningContinuity = generation.ReasoningContinuity;
        extraParameters.Clear();
        if (generation.ExtraParameters is not null)
            extraParameters.AddRange(generation.ExtraParameters.Select(item =>
                new ExtraParameterDraft(item.Key, item.Value.GetRawText())));
        if (generation.EnableThinking is not null || generation.PreserveThinking is not null)
        {
            var legacy = new Dictionary<string, bool>();
            if (generation.EnableThinking is not null) legacy["enable_thinking"] = generation.EnableThinking.Value;
            if (generation.PreserveThinking is not null) legacy["preserve_thinking"] = generation.PreserveThinking.Value;
            if (!extraParameters.Any(item => item.Key == "chat_template_kwargs"))
                extraParameters.Add(new("chat_template_kwargs", JsonSerializer.Serialize(legacy)));
        }
    }

    private void GenerationPresetChanged(string value)
    {
        generationPreset = value;
        ApplyTemplateDefaults(value);
    }

    private void ResetTemplateDefaults() => ApplyTemplateDefaults(generationPreset);

    private void ApplyTemplateDefaults(string value)
    {
        temperature = topP = minP = presencePenalty = frequencyPenalty = repetitionPenalty = null;
        topK = null;
        maxOutputTokens = seed = null;
        extraParameters.Clear();
        reasoningContinuity = "automatic";
        if (value is "qwen38-low" or "qwen38-medium" or "qwen38-high" or "qwen38-xhigh")
        {
            temperature = 1.0; topP = 0.95; topK = 20; minP = 0.0;
            presencePenalty = 0.0; repetitionPenalty = 1.0;
            reasoning = value[7..];
            maxOutputTokens = value switch
            {
                "qwen38-low" => 8192,
                "qwen38-medium" => 12288,
                "qwen38-high" => 16384,
                _ => 24576,
            };
            extraParameters.Add(new("chat_template_kwargs",
                "{\"enable_thinking\":true,\"preserve_thinking\":false}"));
        }
        else if (value == "qwen38-instant")
        {
            temperature = 0.7; topP = 0.80; topK = 20; minP = 0.0;
            presencePenalty = 1.5; repetitionPenalty = 1.0;
            maxOutputTokens = 2048;
            reasoning = "none";
            extraParameters.Add(new("chat_template_kwargs",
                "{\"enable_thinking\":false,\"preserve_thinking\":false}"));
        }
        else reasoning = "none";
    }

    private ModelGenerationSettings BuildGeneration()
    {
        Dictionary<string, JsonElement>? extras = new(StringComparer.Ordinal);
        foreach (var item in extraParameters.Where(item => !string.IsNullOrWhiteSpace(item.Key)))
        {
            var key = item.Key.Trim();
            if (extras.ContainsKey(key)) throw new InvalidOperationException($"Request parameter '{key}' appears more than once.");
            try { extras.Add(key, JsonDocument.Parse(item.Value).RootElement.Clone()); }
            catch (JsonException) { throw new InvalidOperationException($"{item.Key} must contain a valid JSON value."); }
        }
        if (extras.Count == 0) extras = null;
        return new ModelGenerationSettings(
            generationPreset, temperature, topP, topK, minP, presencePenalty,
            frequencyPenalty, repetitionPenalty, maxOutputTokens, seed,
            ExtraParameters: extras, ReasoningContinuity: reasoningContinuity);
    }

    private void AddExtraParameter() => extraParameters.Add(new("", "true"));
    private void RemoveExtraParameter(ExtraParameterDraft item) => extraParameters.Remove(item);

    private static string Id(JsonElement item, string name = "provider_id") =>
        item.ValueKind == JsonValueKind.Object && item.TryGetProperty(name, out var value)
            ? value.GetString() ?? ""
            : "";

    private static string Text(JsonElement item, string name) =>
        item.ValueKind == JsonValueKind.Object && item.TryGetProperty(name, out var value)
            ? value.ToString()
            : "";
    private static string? TextOrNull(JsonElement item, string name)
    {
        var value = Text(item, name);
        return string.IsNullOrWhiteSpace(value) || value == "null" ? null : value;
    }
    private static string GameplayContext(int? configured) => configured is { } value
        ? value.ToString("N0")
        : "automatic";
    private static string GenerationLabel(ModelGenerationSettings generation) => generation.Preset switch
    {
        "qwen38-instant" => "Qwen3.8 Instant template",
        "qwen38-low" => "Qwen3.8 Low template",
        "qwen38-medium" => "Qwen3.8 Medium template",
        "qwen38-high" => "Qwen3.8 High template (provider-dependent)",
        "qwen38-xhigh" => "Qwen3.8 XHigh template",
        "custom" => "custom sampling",
        _ => "provider sampling defaults",
    };
    private static string AcceptanceLabel(GenerationAcceptanceStatus? status) => status?.State switch
    {
        "accepted" => "request accepted",
        "rejected" => "request rejected",
        "stale" => "test stale",
        _ => "not tested",
    };
    private static string AcceptanceClass(GenerationAcceptanceStatus? status) => status?.State switch
    {
        "accepted" => "status-positive",
        "rejected" => "status-negative",
        "stale" => "status-warning",
        _ => "status-neutral",
    };
    private static string AcceptanceDescription(GenerationAcceptanceStatus? status) => status?.State switch
    {
        "accepted" => $"Provider accepted the serialized request {status.TestedAt?.ToLocalTime():g}; parameter behavior is not semantically verified.",
        "rejected" => status.Message,
        "stale" => status.Message,
        _ => "Settings are stored. Provider acceptance and semantic behavior have not been tested.",
    };
    private static string SafeFileName(string value)
    {
        var safe = string.Concat(value.Trim().Select(character =>
            char.IsLetterOrDigit(character) || character is '-' or '_' ? character : '-'));
        return string.IsNullOrWhiteSpace(safe) ? "smacx-player" : safe.Trim('-');
    }
    private sealed record PortableProfileTemplate(
        int SchemaVersion, string DisplayName, string ModelId,
        string ReasoningEffort, int? ContextLength, string? Notes,
        ModelGenerationSettings? Generation);
    private sealed class ExtraParameterDraft(string key, string value)
    {
        public string Key { get; set; } = key;
        public string Value { get; set; } = value;
    }
}
