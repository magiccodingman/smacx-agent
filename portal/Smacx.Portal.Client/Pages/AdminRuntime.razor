@page "/admin/runtime"
@attribute [Authorize(Roles = "Administrator")]
@inject Services.PortalApiClient Api
@using System.Text.Json

<PageTitle>Game runtime · SMACX Agent</PageTitle>
<PageHeader Kicker="NATIVE RUNTIME" Title="Game installation & workers" Description="Validate user-owned Alien Crossfire files, import a managed Proton runtime, and inspect isolated game workers." />

<div class="form-grid">
 <section class="surface-panel form-panel"><h2>Validate game installation</h2><p class="section-copy">The directory remains on the host and is mounted read-only into workers. Game assets are never included in this project.</p><MudTextField @bind-Value="sourceName" Label="Display name" Variant="Variant.Outlined"/><MudTextField @bind-Value="sourcePath" Label="Absolute host directory" Variant="Variant.Outlined"/><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="ValidateSource" StartIcon="@Icons.Material.Filled.Verified">Validate</MudButton></section>
 <section class="surface-panel form-panel"><h2>Import Wine / Proton</h2><p class="section-copy">Import one runtime into an installation-owned Docker volume for repeatable workers.</p><MudTextField @bind-Value="runtimeName" Label="Display name" Variant="Variant.Outlined"/><MudTextField @bind-Value="runtimePath" Label="Absolute runtime directory" Variant="Variant.Outlined"/><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="ImportRuntime" StartIcon="@Icons.Material.Filled.Inventory2">Import runtime</MudButton></section>
</div>

@if(loading){<MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4"/>}
else if(snapshot is not null)
{
 <section class="surface-panel admin-list-panel mt-4"><div class="panel-heading"><div><span class="panel-kicker">VALIDATED ASSETS</span><h2>Installations</h2></div><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Reload" aria-label="Refresh runtime"/></div>@foreach(var item in snapshot.GameSources.EnumerateArray()){<div class="admin-list-row"><div><strong>@Text(item,"display_name")</strong><small>@Text(item,"host_path")</small></div><span class="status-badge">@Text(item,"status")</span><code>@Short(Text(item,"executable_sha256"))</code></div>}@foreach(var item in snapshot.Runtimes.EnumerateArray()){<div class="admin-list-row"><div><strong>@Text(item,"display_name")</strong><small>@Text(item,"runtime_kind") · managed volume</small></div><span class="status-badge">@Text(item,"status")</span><code>@Short(Text(item,"content_fingerprint"))</code></div>}</section>
 <section class="surface-panel admin-list-panel mt-4"><div class="panel-heading"><div><span class="panel-kicker">ISOLATED SESSIONS</span><h2>Workers</h2></div></div>@if(!snapshot.Workers.GetProperty("workers").EnumerateArray().Any()){<div class="empty-state compact"><MudIcon Icon="@Icons.Material.Filled.Dns"/><strong>No workers provisioned</strong><span>Workers appear after a match is materialized.</span></div>}@foreach(var item in snapshot.Workers.GetProperty("workers").EnumerateArray()){var network=item.TryGetProperty("network",out var networkValue)?networkValue:default;<div class="admin-list-row"><div><strong>@Text(item,"instance_id")</strong><small>@Text(item,"container_name")</small></div><span class="status-badge">@Text(item,"observed_status")</span><span>@Text(item,"match_id")</span><div><strong>@Text(network,"resolution_profile")</strong><small>H.264 · @Text(network,"stream_bitrate_kbps") kbps target</small></div></div>}</section>
}
@if(!string.IsNullOrEmpty(error)){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>}

@code {
 private AdminRuntimeSnapshot? snapshot; private bool loading=true,busy; private string? error; private string sourceName="Alien Crossfire",sourcePath="/game"; private string runtimeName="Managed Proton",runtimePath="";
 protected override async Task OnInitializedAsync()=>await Reload();
 private async Task Reload(){loading=true;try{snapshot=(await Api.GetAsync<AdminRuntimeSnapshot>("api/admin/runtime"))?.Data;}catch(Exception ex){error=ex.Message;}finally{loading=false;}}
 private async Task ValidateSource(){busy=true;var result=await Api.PostAsync<JsonElement>("api/admin/game-sources",new GameSourceRequest(sourceName,sourcePath));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message;await Reload();busy=false;}
 private async Task ImportRuntime(){busy=true;var result=await Api.PostAsync<JsonElement>("api/admin/runtimes",new RuntimeImportRequest(runtimeName,runtimePath));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message;await Reload();busy=false;}
 private static string Text(JsonElement item,string name)=>item.ValueKind==JsonValueKind.Object&&item.TryGetProperty(name,out var value)?value.ToString():""; private static string Short(string value)=>value.Length>14?value[..14]+"…":value;
}
