@page "/admin/operations"
@attribute [Authorize(Roles = "Administrator")]
@inject Services.PortalApiClient Api
@using System.Text.Json

<PageTitle>Operations · SMACX Agent</PageTitle>
<PageHeader Kicker="RELIABILITY DECK" Title="Operations & recovery" Description="Inspect supervision, control optional memory, create verified backups, and schedule unattended maintenance." />

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (snapshot is not null)
{
 <div class="metric-grid">
  <MetricCard Label="CONTROL" Value="@Text(snapshot.Operations, "status", "ready")" Detail="Supervisor state" Icon="@Icons.Material.Filled.MonitorHeart" />
  <MetricCard Label="GRAPHITI" Value="@GraphitiLabel" Detail="SQLite remains authoritative" Icon="@Icons.Material.Filled.AccountTree" Tone="violet" />
  <MetricCard Label="RULES" Value="@KnowledgeLabel" Detail="Local semantic mechanics" Icon="@Icons.Material.Filled.MenuBook" Tone="blue" />
  <MetricCard Label="SCHEDULES" Value="@Count(snapshot.Schedules).ToString()" Detail="Configured jobs" Icon="@Icons.Material.Filled.Schedule" Tone="gold" />
  <MetricCard Label="BACKUPS" Value="@Count(snapshot.Backups).ToString()" Detail="Recorded sets" Icon="@Icons.Material.Filled.Backup" Tone="blue" />
 </div>
 <div class="form-grid">
  <section class="surface-panel form-panel">
   <h2>Optional Graphiti memory</h2><p class="section-copy">Graphiti turns selected political and strategic events into a scoped temporal relationship graph. SQLite remains authoritative; routine moves and raw reasoning are never ingested.</p>
   <MudSelect T="string" @bind-Value="graphitiProfileId" Label="Extraction AI profile" Variant="Variant.Outlined" HelperText="A fast non-thinking profile is usually sufficient. This is independent of every gameplay seat.">
    @foreach(var profile in profiles.Where(item=>item.Active)){<MudSelectItem Value="@profile.ProfileVersionId">@profile.DisplayName v@(profile.Version) · @profile.ModelId</MudSelectItem>}
   </MudSelect>
   <MudSwitch T="bool" Value="@Bool(snapshot.Graphiti, "enabled")" ValueChanged="@(value => ToggleGraphiti(value))" Color="Color.Primary" Disabled="@(string.IsNullOrWhiteSpace(graphitiProfileId))">Enable installation-wide projector</MudSwitch>
   @if(string.IsNullOrWhiteSpace(graphitiProfileId)){<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Graphiti stays disabled until an extraction profile is selected. Gameplay memory continues normally in scoped SQLite.</MudAlert>}
   <span class="field-help">Writes are queued and processed away from gameplay. Relevant recall waits for bounded results and fails open if Graphiti is unavailable. Individual matches may opt out.</span>
   <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveGraphitiProfile" Disabled="@(busy||string.IsNullOrWhiteSpace(graphitiProfileId))">Save extraction profile</MudButton>
  </section>
  <section class="surface-panel form-panel">
   <h2>Shared semantic embeddings</h2><p class="section-copy">One embedding space powers the rules library and Graphiti. The built-in CPU model is recommended and loaded only once.</p>
   <MudSelect T="string" @bind-Value="embeddingMode" Label="Embedding runtime" Variant="Variant.Outlined">
    <MudSelectItem Value="@("local")">Built-in CPU model · recommended</MudSelectItem><MudSelectItem Value="@("external")">External OpenAI-compatible endpoint</MudSelectItem><MudSelectItem Value="@("disabled")">Disabled · also disables Graphiti and semantic rules</MudSelectItem>
   </MudSelect>
   @if(embeddingMode=="external")
   {
    <MudSelect T="string" Value="@embeddingProviderId" ValueChanged="EmbeddingProviderChanged" Label="Embedding endpoint" Variant="Variant.Outlined">
     @foreach(var provider in snapshot.Providers.EnumerateArray()){<MudSelectItem Value="@Text(provider,"provider_id")">@Text(provider,"display_name")</MudSelectItem>}
    </MudSelect>
    <MudSelect T="string" @bind-Value="embeddingModelId" Label="Embedding model" Variant="Variant.Outlined">
     @foreach(var model in EmbeddingModels){<MudSelectItem Value="@Text(model,"model_id")">@Text(model,"display_name")</MudSelectItem>}
    </MudSelect>
    <MudNumericField T="int?" @bind-Value="embeddingDimensions" Label="Vector dimensions" Min="1" Max="65536" Variant="Variant.Outlined" HelperText="Must match the endpoint exactly."/>
    <MudTextField @bind-Value="embeddingSpaceId" Label="Embedding space ID" Variant="Variant.Outlined" HelperText="Change this stable ID whenever model weights or vector semantics change; the corpus is then rebuilt safely."/>
   }
   <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEmbeddings" Disabled="@(!CanSaveEmbeddings||busy)">Save embedding runtime</MudButton>
   <span class="field-help">Changing embedding space triggers a clean knowledge-service restart and re-embedding. The local model normally needs no configuration.</span>
  </section>
  <section class="surface-panel form-panel"><h2>Backup now</h2><p class="section-copy">Create an integrity-manifested backup of control state, secrets, and optionally worker volumes.</p><MudSwitch @bind-Value="includeSecrets" Color="Color.Primary">Include managed secrets</MudSwitch><MudSwitch @bind-Value="includeWorkers" Color="Color.Primary">Include worker volumes</MudSwitch><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateBackup" Disabled="busy" StartIcon="@Icons.Material.Filled.Backup">Create backup</MudButton></section>
  <section class="surface-panel form-panel"><h2>Campaign save retention</h2><p class="section-copy">Running seats keep only compact native recovery history. Parked saves are zstd-compressed; completed campaigns retain one verified final save plus analytics.</p><MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@StorageSummary</MudAlert><MudNumericField T="int" @bind-Value="recentCheckpoints" Label="Recent checkpoints" Min="1" Max="250" Variant="Variant.Outlined"/><MudNumericField T="int" @bind-Value="milestoneInterval" Label="Milestone interval (0 disables)" Min="0" Max="10000" Variant="Variant.Outlined"/><MudSwitch @bind-Value="retainFullTurnHistory" Color="Color.Warning">Retain every native turn save</MudSwitch><span class="field-help">Full history is optional groundwork for future timeline tools; a native save alone is not a replay and does not rewind AI memory.</span><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveStoragePolicy" Disabled="busy">Save retention policy</MudButton></section>
  <section class="surface-panel form-panel"><h2>Maintenance schedule</h2><p class="section-copy">Schedules survive service restarts and are executed by the control supervisor.</p><MudTextField @bind-Value="scheduleName" Label="Display name" Variant="Variant.Outlined"/><MudSelect T="string" @bind-Value="operationKind" Label="Operation" Variant="Variant.Outlined"><MudSelectItem Value="@("backup")">Backup</MudSelectItem><MudSelectItem Value="@("checkpoint")">Checkpoint running match</MudSelectItem><MudSelectItem Value="@("health_check")">Health check</MudSelectItem></MudSelect><MudNumericField T="int" @bind-Value="intervalSeconds" Label="Interval (seconds)" Min="60" Variant="Variant.Outlined"/><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSchedule" Disabled="busy">Create schedule</MudButton></section>
  <section class="surface-panel form-panel"><h2>Recovery boundary</h2><p class="section-copy">Managed matches use bridge-verified save checkpoints. The operation remains safe if Graphiti or an AI endpoint is unavailable.</p><MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Use a running lobby’s Checkpoint button before planned downtime. Park stops its workers; Recover restarts every assigned seat from the verified save.</MudAlert></section>
 </div>
 <section class="surface-panel admin-list-panel mt-4">
  <div class="panel-heading"><div><span class="panel-kicker">BACKUP CATALOG</span><h2>Verified state</h2></div><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Reload" aria-label="Refresh operations" /></div>
  @if (Count(snapshot.Backups) == 0)
  {
   <div class="empty-state compact"><MudIcon Icon="@Icons.Material.Filled.Backup" /><strong>No backups yet</strong><span>Create the first backup above.</span></div>
  }
  @foreach (var item in snapshot.Backups.EnumerateArray())
  {
   var backupId = Text(item, "backup_id");
   <div class="admin-list-row"><div><strong>@backupId</strong><small>@Unix(item, "created_unix")</small></div><span>@Text(item, "status")</span><span>@Text(item, "size_bytes") bytes</span><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => Verify(backupId)">Verify</MudButton></div>
  }
 </section>
 <section class="surface-panel admin-list-panel mt-4">
  <div class="panel-heading"><div><span class="panel-kicker">UNATTENDED WORK</span><h2>Schedules</h2></div></div>
  @foreach (var item in snapshot.Schedules.EnumerateArray())
  {
   var scheduleId = Text(item, "schedule_id");
   var isActive = Text(item, "status") == "active";
   var action = isActive ? "pause" : "activate";
   <div class="admin-list-row"><div><strong>@Text(item, "display_name")</strong><small>@Text(item, "operation_kind") · every @Text(item, "interval_seconds")s</small></div><span class="status-badge">@Text(item, "status")</span><span>next @Unix(item, "next_run_unix")</span><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ScheduleAction(scheduleId, action)">@(isActive ? "Pause" : "Activate")</MudButton></div>
  }
 </section>
}
@if(!string.IsNullOrEmpty(message)){<MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-4">@message</MudAlert>}@if(!string.IsNullOrEmpty(error)){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@error</MudAlert>}

@code {
 private AdminSnapshot? snapshot; private List<AiProfileVersion> profiles=[]; private bool loading=true,busy,includeSecrets=true,includeWorkers=true,retainFullTurnHistory; private string? error,message,graphitiProfileId,embeddingProviderId,embeddingModelId,embeddingSpaceId; private string embeddingMode="local",scheduleName="Nightly control backup",operationKind="backup"; private int intervalSeconds=86400,recentCheckpoints=10,milestoneInterval=25; private int? embeddingDimensions;
 private string GraphitiLabel => snapshot is not null && Bool(snapshot.Graphiti, "enabled") ? "ON" : "OFF";
 private string KnowledgeLabel => snapshot is not null && Bool(snapshot.Knowledge,"ok") ? (snapshot.Knowledge.TryGetProperty("state",out var state)&&state.ValueKind==JsonValueKind.Object?Text(state,"state","ready"):"ready").ToUpperInvariant() : "DEGRADED";
 private string StorageSummary => snapshot is null ? "No completed archives yet." : $"Completed archive: {Int(snapshot.Storage,"completed_campaigns",0)} campaigns · {Int(snapshot.Storage,"completed_archive_saves",0)} final saves · {Bytes(snapshot.Storage,"completed_archive_bytes")}";
 protected override async Task OnInitializedAsync()=>await Reload();
 private IEnumerable<JsonElement> EmbeddingModels=>snapshot is null||string.IsNullOrWhiteSpace(embeddingProviderId)?[]:snapshot.Providers.EnumerateArray().Where(item=>Text(item,"provider_id")==embeddingProviderId).SelectMany(item=>item.GetProperty("models").EnumerateArray()).ToArray();
 private bool CanSaveEmbeddings=>embeddingMode!="external"||(!string.IsNullOrWhiteSpace(embeddingProviderId)&&!string.IsNullOrWhiteSpace(embeddingModelId)&&embeddingDimensions>0&&!string.IsNullOrWhiteSpace(embeddingSpaceId));
 private async Task Reload(){loading=true;try{snapshot=(await Api.GetAsync<AdminSnapshot>("api/admin/snapshot"))?.Data;profiles=(await Api.GetAsync<IReadOnlyList<AiProfileVersion>>("api/admin/ai-profiles"))?.Data?.ToList()??[];if(snapshot is not null){recentCheckpoints=Int(snapshot.Storage,"recent_checkpoints",10);milestoneInterval=Int(snapshot.Storage,"milestone_interval",25);retainFullTurnHistory=Bool(snapshot.Storage,"retain_full_turn_history");if(snapshot.Graphiti.TryGetProperty("profile",out var profile)&&profile.ValueKind==JsonValueKind.Object)graphitiProfileId=Text(profile,"profile_version_id","");if(snapshot.Graphiti.TryGetProperty("embeddings",out var embeddings)&&embeddings.ValueKind==JsonValueKind.Object){embeddingMode=Text(embeddings,"mode","local");embeddingProviderId=Text(embeddings,"provider_id","");embeddingModelId=Text(embeddings,"model_id","");embeddingDimensions=Int(embeddings,"dimensions",0) is var dimensions&&dimensions>0?dimensions:null;embeddingSpaceId=Text(embeddings,"space_id","");}}}catch(Exception ex){error=ex.Message;}finally{loading=false;}}
 private async Task ToggleGraphiti(bool enabled){busy=true;error=null;var result=await Api.PostAsync<JsonElement>("api/admin/graphiti",new GraphitiConfigurationRequest(enabled,graphitiProfileId));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message;await Reload();busy=false;}
 private async Task SaveGraphitiProfile(){await ToggleGraphiti(snapshot is not null&&Bool(snapshot.Graphiti,"enabled"));message=error is null?"Graphiti extraction profile saved.":null;}
 private Task EmbeddingProviderChanged(string value){embeddingProviderId=value;embeddingModelId=EmbeddingModels.Count()==1?Text(EmbeddingModels.First(),"model_id"):null;return Task.CompletedTask;}
 private async Task SaveEmbeddings(){busy=true;error=null;message=null;var result=await Api.PostAsync<JsonElement>("api/admin/embeddings",new EmbeddingConfigurationRequest(embeddingMode,embeddingProviderId,embeddingModelId,embeddingDimensions,embeddingSpaceId));if(result.Payload?.Ok==true)message="Embedding runtime saved. Semantic services will restart cleanly if the embedding space changed.";else error=result.Payload?.Error?.Message;await Reload();busy=false;}
 private async Task CreateBackup(){busy=true;var result=await Api.PostAsync<JsonElement>("api/admin/backups",new BackupRequest(includeSecrets,includeWorkers));if(result.Payload?.Ok==true)message="Backup created.";else error=result.Payload?.Error?.Message;await Reload();busy=false;}
 private async Task SaveStoragePolicy(){busy=true;error=null;message=null;var result=await Api.PostAsync<JsonElement>("api/admin/storage-policy",new StoragePolicyRequest(recentCheckpoints,milestoneInterval,retainFullTurnHistory));if(result.Payload?.Ok==true)message="Save retention policy updated.";else error=result.Payload?.Error?.Message;await Reload();busy=false;}
 private async Task Verify(string id){busy=true;var result=await Api.PostAsync<JsonElement>($"api/admin/backups/{id}/verify",new{});if(result.Payload?.Ok==true)message="Backup manifest verified.";else error=result.Payload?.Error?.Message;busy=false;}
 private async Task CreateSchedule(){busy=true;var result=await Api.PostAsync<JsonElement>("api/admin/schedules",new ScheduleRequest(scheduleName,operationKind,"installation",null,intervalSeconds));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message;await Reload();busy=false;}
 private async Task ScheduleAction(string id,string action){await Api.PostAsync<JsonElement>($"api/admin/schedules/{id}/{action}",new{});await Reload();}
 private static string Text(JsonElement item,string name,string fallback="—")=>item.ValueKind==JsonValueKind.Object&&item.TryGetProperty(name,out var value)&&value.ValueKind!=JsonValueKind.Null?value.ToString():fallback;
 private static bool Bool(JsonElement item,string name)=>item.ValueKind==JsonValueKind.Object&&item.TryGetProperty(name,out var value)&&value.ValueKind==JsonValueKind.True;
 private static int Int(JsonElement item,string name,int fallback)=>item.ValueKind==JsonValueKind.Object&&item.TryGetProperty(name,out var value)&&value.TryGetInt32(out var number)?number:fallback;
 private static string Bytes(JsonElement item,string name){if(item.ValueKind!=JsonValueKind.Object||!item.TryGetProperty(name,out var value)||!value.TryGetInt64(out var bytes))return "0 B";string[] units=["B","KB","MB","GB"];var amount=(double)bytes;var unit=0;while(amount>=1024&&unit<units.Length-1){amount/=1024;unit++;}return $"{amount:0.#} {units[unit]}";}
 private static int Count(JsonElement item)=>item.ValueKind==JsonValueKind.Array?item.GetArrayLength():0;
 private static string Unix(JsonElement item,string name){if(item.TryGetProperty(name,out var value)&&value.ValueKind==JsonValueKind.Number)return DateTimeOffset.FromUnixTimeMilliseconds((long)(value.GetDouble()*1000)).ToLocalTime().ToString("g");return "—";}
}
