@page "/play/{MatchId}/{SeatIndex:int}"
@implements IAsyncDisposable
@inject Services.PortalApiClient Api
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using System.Text.Json
<PageTitle>Play · SMACX Agent</PageTitle>
<NavigationLock ConfirmExternalNavigation="@navigationGuardEnabled"
                OnBeforeInternalNavigation="GuardNavigation" />

<div class="managed-game-shell" @ref="shell">
 @if(loading){<div class="game-wait"><MudProgressCircular Indeterminate="true" Color="Color.Primary"/><span>Connecting your managed seat…</span></div>}
 else if(seat is null){<div class="game-wait"><MudIcon Icon="@Icons.Material.Filled.ErrorOutline"/><strong>Player seat unavailable</strong><span>@error</span><MudButton Href="@($"lobbies/{MatchId}")">Return to lobby</MudButton></div>}
 else
 {
  <StreamSecurityNotice Overlay="true" />
  <div class="game-stage" style="@StageStyle"><iframe @key="StreamFrameKey" class="managed-game-frame" src="@StreamUrl" title="@($"{seat.PlayerHandle} managed game")" allow="autoplay; fullscreen" referrerpolicy="same-origin"></iframe></div>
  @if(!IsController){<div class="controller-viewer-card"><MudIcon Icon="@Icons.Material.Filled.Visibility"/><div><strong>This seat is open in another game view</strong><span>You can watch safely here, or deliberately move control to this tab.</span></div><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TakeControl">Take control here</MudButton></div>}
  @if(IsController&&ui?.RootMenuVisible==true){<div class="native-menu-rail" role="toolbar" aria-label="Managed game controls"><MudIconButton Icon="@Icons.Material.Filled.ExitToApp" OnClick="ConfirmLeave" aria-label="Exit game view"/><span class="rail-divider"></span><MudIconButton Icon="@(fullscreen?Icons.Material.Filled.FullscreenExit:Icons.Material.Filled.Fullscreen)" OnClick="ToggleFullscreen" aria-label="Toggle fullscreen"/><MudIconButton Icon="@Icons.Material.Filled.Tune" OnClick="OpenPanel" aria-label="Open game control center"/><span class="native-resolution-chip">@ui.NativeWidth × @ui.NativeHeight · @((ui.StreamBitrateKbps/1000d).ToString("0.#")) Mbps</span></div>}
  @if(panelOpen)
  {
   <div class="platform-scrim" @onclick="ClosePanel"></div>
   <aside class="platform-panel" aria-label="Game control center"><header><div><span class="panel-kicker">MANAGED PLAY</span><h2>Game control center</h2></div><MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="ClosePanel"/></header>
    <MudTabs Rounded="true" ApplyEffectsToContainer="true" Class="platform-tab-body">
     <MudTabPanel Text="Display" Icon="@Icons.Material.Filled.AspectRatio"><p class="section-copy">Browser fitting is instant and never pauses the match. A native profile change waits for a stable checkpoint and may require a player vote.</p><MudSwitch T="bool" Value="@automaticFit" ValueChanged="@((bool value)=>SetAutomatic(value))" Color="Color.Primary">Choose the best profile for this device</MudSwitch><MudSwitch T="bool" Value="@profileLocked" ValueChanged="@((bool value)=>SetLocked(value))" Color="Color.Primary">Keep my selected native profile on this device</MudSwitch><MudSelect T="string" Value="@selectedProfile" ValueChanged="@((string value)=>SelectProfile(value))" Label="Native framebuffer" Variant="Variant.Outlined" Disabled="@automaticFit">@foreach(var profile in ResolutionProfiles.All){<MudSelectItem T="string" Value="@profile.Id">@profile.Label</MudSelectItem>}</MudSelect><div class="display-actions"><MudButton Variant="Variant.Outlined" OnClick="FitNow">Fit browser now</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(selectedProfile==ui?.ResolutionProfileId||requestingResolution)" OnClick="RequestNativeResolution">Apply natively</MudButton>@if(cooldownBlocked&&PeerHumanCount>0){<MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(()=>ProposeOperation("waive_resolution_cooldown"))">Ask players to waive cooldown</MudButton>}</div>@if(!string.IsNullOrWhiteSpace(recommendation)){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@recommendation</MudAlert>}</MudTabPanel>
     <MudTabPanel Text="Chat" Icon="@Icons.Material.Filled.Forum"><p class="section-copy">Use global chat or private commlinks without fighting the original 1999 chat window. Only factions you have contacted appear for private chat. Group conversations require every invited member to accept.</p><MudSelect T="string" @bind-Value="conversation" Label="Conversation" Variant="Variant.Outlined"><MudSelectItem T="string" Value="global">Everyone</MudSelectItem>@foreach(var target in PrivateTargets){<MudSelectItem T="string" Value="@($"private:{target.FactionId}")">@target.DisplayName</MudSelectItem>}@foreach(var group in groups.Where(item=>item.Participants.FirstOrDefault(p=>p.Local)?.MembershipStatus=="accepted")){<MudSelectItem T="string" Value="@($"group:{group.ConversationId}")">@group.DisplayName</MudSelectItem>}</MudSelect><MudExpansionPanels Class="mt-2"><MudExpansionPanel Text="Create a private group"><MudTextField @bind-Value="newGroupName" Label="Group name" Variant="Variant.Outlined" MaxLength="48" Counter="48"/>@foreach(var target in PrivateTargets){<MudCheckBox T="bool" Value="@newGroupMembers.Contains(target.FactionId!.Value)" ValueChanged="@((bool value)=>ToggleGroupMember(target.FactionId!.Value,value))" Label="@target.DisplayName"/>}<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateGroup" Disabled="@(string.IsNullOrWhiteSpace(newGroupName)||newGroupMembers.Count==0)">Invite group</MudButton></MudExpansionPanel></MudExpansionPanels><div class="compact-chat-log" aria-live="polite" aria-relevant="additions">@foreach(var message in VisibleMessages){<div @key="message.Id"><strong>@message.SenderHandle</strong><small>@message.CreatedAt.ToLocalTime().ToString("t")</small><p>@message.Content</p></div>}</div><div class="chat-compose"><MudTextField @bind-Value="draft" Placeholder="Send a message…" Variant="Variant.Outlined" Immediate="true"/><MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" OnClick="SendChat" Disabled="@string.IsNullOrWhiteSpace(draft)"/></div>@foreach(var invitation in groups.Where(item=>item.Participants.FirstOrDefault(p=>p.Local)?.MembershipStatus=="invited")){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2"><strong>@invitation.DisplayName</strong> invited you to a private group.<div><MudButton Size="Size.Small" OnClick="@(()=>RespondGroup(invitation.ConversationId,"accepted"))">Accept</MudButton><MudButton Size="Size.Small" Color="Color.Error" OnClick="@(()=>RespondGroup(invitation.ConversationId,"rejected"))">Reject</MudButton></div></MudAlert>}</MudTabPanel>
     <MudTabPanel Text="Wiki" Icon="@Icons.Material.Filled.MenuBook"><p class="section-copy">Consult factual Datalinks without leaving your game. Search combines exact terminology with semantic retrieval.</p><KnowledgeBrowser Compact="true" /></MudTabPanel>
     <MudTabPanel Text="Votes" Icon="@Icons.Material.Filled.HowToVote">@if(!proposals.Any(item=>item.Status=="open")){<div class="panel-empty">No match votes are open.</div>}@foreach(var proposal in proposals.Where(item=>item.Status=="open")){<div class="vote-card"><strong>@proposal.Title</strong><p>@proposal.Description</p><small>@proposal.YesVotes yes · @proposal.NoVotes no · closes @proposal.ExpiresAt.ToLocalTime().ToString("t")</small>@if(proposal.CurrentUserEligible){<div><MudButton Size="Size.Small" Color="Color.Success" OnClick="@(()=>Vote(proposal.ProposalId,"yes"))">Yes</MudButton><MudButton Size="Size.Small" Color="Color.Error" OnClick="@(()=>Vote(proposal.ProposalId,"no"))">No</MudButton></div>}</div>}</MudTabPanel>
     <MudTabPanel Text="Session" Icon="@Icons.Material.Filled.Save"><p class="section-copy">Leaving this page disconnects only your browser. It does not retire your faction or discard the match. Disruptive recovery waits for a verified stable checkpoint.</p>@foreach(var missing in DisconnectedSeats){<div class="vote-card"><strong>@(missing.PlayerHandle??$"Seat {missing.SeatIndex+1}") is disconnected</strong><p>The faction remains reserved. Players can vote to let the native computer temporarily continue until its owner returns.</p><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>ProposeSeatOperation("continue_without_player",missing.SeatIndex))">Propose temporary computer control</MudButton></div>}@foreach(var delegated in DelegatedSeats){<div class="vote-card"><strong>@(delegated.PlayerHandle??$"Seat {delegated.SeatIndex+1}") is temporarily computer-controlled</strong><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>ProposeSeatOperation("reclaim_player_seat",delegated.SeatIndex))">Propose player reclaim</MudButton></div>}<MudExpansionPanels Class="mt-2"><MudExpansionPanel Text="Host and match controls"><p class="section-copy">The managed host is @(ManagedHost?.PlayerHandle??$"seat {(ManagedHost?.SeatIndex??0)+1}"). Transfers, parking, and ending all wait for player approval and a verified checkpoint.</p>@foreach(var candidate in HostCandidates){<MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(()=>ProposeSeatOperation("transfer_host",candidate.SeatIndex))">Transfer host to @(candidate.PlayerHandle??$"seat {candidate.SeatIndex+1}")</MudButton>}<div class="display-actions"><MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(()=>AskOperationConfirmation("park_match"))">Park match safely</MudButton><MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(()=>AskOperationConfirmation("end_match"))">End match safely</MudButton></div></MudExpansionPanel></MudExpansionPanels>@if(maintenance is not null&&maintenance.Status!="idle"){<MudAlert Severity="Severity.Info" Variant="Variant.Outlined"><strong>@maintenance.Summary</strong><br/>@maintenance.Phase · @maintenance.CompletedSteps / @maintenance.TotalSteps</MudAlert>}<MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.ExitToApp" OnClick="ConfirmLeave">Exit game view</MudButton></MudTabPanel>
    </MudTabs>@if(!string.IsNullOrWhiteSpace(error)){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">@error</MudAlert>}</aside>
  }
  @if(confirmLeave){<div class="platform-scrim"></div><div class="confirm-card"><h2>Exit this game view?</h2><p>Your browser controller will disconnect, but your faction remains reserved. Other players may continue. If this is the last connected human, the safe-parking countdown begins.</p><div><MudButton OnClick="CancelLeave">Stay in game</MudButton><MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="Leave">Exit to command deck</MudButton></div></div>}
  @if(confirmOperation is not null){<div class="platform-scrim"></div><div class="confirm-card"><h2>@(confirmOperation=="end_match"?"End this match?":"Park this match?")</h2><p>@(confirmOperation=="end_match"?"After approval, the platform will make a final stable checkpoint, stop every managed seat, and mark the campaign complete.":"After approval, the platform will checkpoint every managed seat and park the campaign for later recovery.")</p><div><MudButton OnClick="@(()=>confirmOperation=null)">Cancel</MudButton><MudButton Variant="Variant.Filled" Color="@(confirmOperation=="end_match"?Color.Error:Color.Warning)" OnClick="ConfirmManagedOperation">Open proposal</MudButton></div></div>}
  @if(maintenance is not null&&(maintenance.Status is "running" or "queued")&&maintenance.CompletedSteps<2){<div style="position:absolute;left:50%;bottom:max(1rem,env(safe-area-inset-bottom));transform:translateX(-50%);z-index:15;max-width:min(680px,calc(100% - 2rem));padding:.7rem 1rem;border:1px solid #65d5ad55;border-radius:12px;background:#04120ff0;color:#d9f5eb;text-align:center;pointer-events:none"><strong>@maintenance.Summary</strong><br/><small>Keep playing normally; the change will begin only after the game reaches a safe checkpoint.</small></div>}
  @if(maintenance is not null&&maintenance.Status=="running"&&maintenance.CompletedSteps>=2){<div class="maintenance-curtain"><MudProgressCircular Indeterminate="true"/><strong>@maintenance.Summary</strong><span>@maintenance.Phase · @maintenance.CompletedSteps / @maintenance.TotalSteps</span></div>}
  @if(lobby?.NeedsAttention is not null&&lobby.Status!="recovering"){<CapabilityGapDialog Incident="lobby.NeedsAttention" MatchId="@MatchId" ReturnRequested="ReturnFromIncident" RecoveryHref="@($"/lobbies/{MatchId}")" Overlay="true"/>}
 }
</div>

@code {
 [Parameter]public string MatchId{get;set;}="";[Parameter]public int SeatIndex{get;set;}
 private LobbyDetails? lobby;private LobbySeatSummary? seat;private HumanUiState? ui;private MaintenanceProgress? maintenance;private ControllerLeaseState? controllerLease;private List<LobbyMessage> messages=[];private List<ChatConversation> groups=[];private List<ChatParticipant> chatParticipants=[];private List<GovernanceProposal> proposals=[];private ElementReference shell;private IJSObjectReference? module;private IJSObjectReference? viewportWatcher;private DotNetObjectReference<Play>? selfReference;private PeriodicTimer? timer;private CancellationTokenSource? polling;private bool loading=true,panelOpen,fullscreen,confirmLeave,requestingResolution,automaticFit=true,profileLocked,cooldownBlocked,navigationGuardEnabled,deliberateNavigation;private int streamRevision,pollTicks;private DateTimeOffset lastLeaseHeartbeat;private string selectedProfile=ResolutionProfiles.DesktopDefault,conversation="global",draft="",recommendation="",newGroupName="",playInstanceId=$"play-{Guid.NewGuid():N}";private readonly HashSet<int> newGroupMembers=[];private string? error,confirmOperation,pendingNavigationTarget;private string global=>"global";
 private string StreamFrameKey=>$"{streamRevision}:{lobby?.RuntimeGeneration ?? 0}";
 private bool IsController=>controllerLease?.Role=="controller";
 private string StreamUrl=>seat?.InstanceId is null?"about:blank":$"/stream/{seat.InstanceId}/?view={(IsController?0:1)}&lease={Uri.EscapeDataString(controllerLease?.LeaseId??string.Empty)}&revision={streamRevision}";
 private IEnumerable<ChatParticipant> PrivateTargets=>chatParticipants.Where(item=>!item.Local&&item.PrivateEligible&&item.FactionId is not null);
 private IEnumerable<LobbySeatSummary> DisconnectedSeats=>lobby?.Seats.Where(item=>item.ControllerKind=="human"&&item.DelegationStatus!="active"&&item.ConnectionState is "idle_grace_period" or "temporarily_disconnected"&&item.LastBrowserSeenAt<DateTimeOffset.UtcNow-TimeSpan.FromSeconds(30))??[];
 private IEnumerable<LobbySeatSummary> DelegatedSeats=>lobby?.Seats.Where(item=>item.DelegationStatus=="active")??[];
 private LobbySeatSummary? ManagedHost=>lobby?.Seats.FirstOrDefault(item=>item.IsManagedHost);
 private IEnumerable<LobbySeatSummary> HostCandidates=>lobby?.Seats.Where(item=>item.InstanceId is not null&&!item.IsManagedHost&&item.DelegationStatus!="active")??[];
 private int PeerHumanCount=>Math.Max(0,(lobby?.Seats.Count(item=>item.ControllerKind=="human")??1)-1);
 private IEnumerable<LobbyMessage> VisibleMessages=>conversation=="global"?messages.Where(m=>m.Channel=="global"):conversation.StartsWith("private:")?messages.Where(m=>m.Channel=="private"&&(m.RecipientFactionId==int.Parse(conversation[8..])||m.SenderFactionId==int.Parse(conversation[8..]))):messages.Where(m=>m.Channel=="group"&&m.ConversationId==conversation[6..]);
 private string StageStyle=>ui is null?"--native-aspect:1.6;aspect-ratio:16/10":$"--native-aspect:{ui.NativeWidth/(double)ui.NativeHeight:F6};aspect-ratio:{ui.NativeWidth}/{ui.NativeHeight}";
 protected override async Task OnInitializedAsync(){await RefreshAll();loading=false;polling=new();timer=new(TimeSpan.FromMilliseconds(750));_=Poll(polling.Token);}
 protected override async Task OnAfterRenderAsync(bool firstRender){if(!firstRender)return;module=await Js.InvokeAsync<IJSObjectReference>("import","./js/game-shell.js");var pref=await module.InvokeAsync<DisplayPreference>("loadDisplayPreference");automaticFit=pref.Automatic;profileLocked=pref.Locked;if(!string.IsNullOrWhiteSpace(pref.ProfileId))selectedProfile=pref.ProfileId;selfReference=DotNetObjectReference.Create(this);viewportWatcher=await module.InvokeAsync<IJSObjectReference>("watchGameViewport",shell,selfReference);await FitNow();StateHasChanged();}
 private async Task Poll(CancellationToken token){try{while(timer is not null&&await timer.WaitForNextTickAsync(token)){try{var nextUi=(await Api.GetAsync<HumanUiState>($"api/lobbies/{MatchId}/human-ui/{SeatIndex}"))?.Data;if(nextUi?.NativeQuitIntercepted==true)Snackbar.Add("The in-game Exit command was canceled. Use Exit game view, Park match, or End match from managed controls.",Severity.Info);ui=nextUi;if(ui?.RootMenuVisible!=true)panelOpen=false;maintenance=(await Api.GetAsync<MaintenanceProgress>($"api/lobbies/{MatchId}/governance/maintenance"))?.Data;if(DateTimeOffset.UtcNow-lastLeaseHeartbeat>=TimeSpan.FromSeconds(8))await HeartbeatLease();pollTicks++;if(panelOpen||pollTicks%4==0)await RefreshPanel();await InvokeAsync(StateHasChanged);}catch(Exception)when(!token.IsCancellationRequested){}}}catch(OperationCanceledException)when(token.IsCancellationRequested){}}
 private async Task RefreshAll(){lobby=(await Api.GetAsync<LobbyDetails>($"api/lobbies/{MatchId}"))?.Data;seat=lobby?.Seats.FirstOrDefault(item=>item.SeatIndex==SeatIndex&&item.CanControl);if(seat is null)error="Sign in as the player assigned to this browser-managed seat.";else{var acquired=await Api.PostAsync<ControllerLeaseState>($"api/lobbies/{MatchId}/controller/{SeatIndex}/acquire",new ControllerLeaseRequest(playInstanceId));controllerLease=acquired.Payload?.Data;if(controllerLease is null)error=acquired.Payload?.Error?.Message??"The browser controller could not be prepared.";else navigationGuardEnabled=true;ui=(await Api.GetAsync<HumanUiState>($"api/lobbies/{MatchId}/human-ui/{SeatIndex}"))?.Data;lastLeaseHeartbeat=DateTimeOffset.UtcNow;}}
 private async Task RefreshPanel(){lobby=(await Api.GetAsync<LobbyDetails>($"api/lobbies/{MatchId}"))?.Data??lobby;messages=((await Api.GetAsync<IReadOnlyList<LobbyMessage>>($"api/lobbies/{MatchId}/messages"))?.Data??[]).ToList();groups=((await Api.GetAsync<IReadOnlyList<ChatConversation>>($"api/lobbies/{MatchId}/chat-groups"))?.Data??[]).ToList();chatParticipants=((await Api.GetAsync<IReadOnlyList<ChatParticipant>>($"api/lobbies/{MatchId}/chat-participants"))?.Data??[]).ToList();proposals=((await Api.GetAsync<IReadOnlyList<GovernanceProposal>>($"api/lobbies/{MatchId}/governance"))?.Data??[]).ToList();}
 private async Task OpenPanel(){panelOpen=true;await RefreshPanel();}private void ClosePanel(){panelOpen=false;error=null;}private void ConfirmLeave(){confirmLeave=true;panelOpen=false;}private void CancelLeave(){confirmLeave=false;pendingNavigationTarget=null;}
 private async Task Leave(){await ReleaseLease();deliberateNavigation=true;navigationGuardEnabled=false;if(module is not null)await module.InvokeVoidAsync("leaveGameFullscreen");Navigation.NavigateTo(string.IsNullOrWhiteSpace(pendingNavigationTarget)?"":pendingNavigationTarget);}
 private async Task ReturnFromIncident(){await ReleaseLease();deliberateNavigation=true;navigationGuardEnabled=false;if(module is not null)await module.InvokeVoidAsync("leaveGameFullscreen");Navigation.NavigateTo($"lobbies/{MatchId}");}
 private void GuardNavigation(LocationChangingContext context){if(deliberateNavigation)return;context.PreventNavigation();pendingNavigationTarget=context.TargetLocation;confirmLeave=true;panelOpen=false;StateHasChanged();}
 private async Task HeartbeatLease(){if(controllerLease is null)return;var wasController=IsController;var response=await Api.PostAsync<ControllerLeaseState>($"api/lobbies/{MatchId}/controller/{SeatIndex}/heartbeat",new ControllerLeaseActionRequest(controllerLease.LeaseId));lastLeaseHeartbeat=DateTimeOffset.UtcNow;if(response.Payload?.Data is { } current){controllerLease=current;if(wasController&&!IsController){streamRevision++;panelOpen=false;Snackbar.Add("Control moved to another game view. This tab is now safely view-only.",Severity.Warning);}}else if(response.Payload?.Error?.Code=="controller_lease_expired"){var acquired=await Api.PostAsync<ControllerLeaseState>($"api/lobbies/{MatchId}/controller/{SeatIndex}/acquire",new ControllerLeaseRequest(playInstanceId));controllerLease=acquired.Payload?.Data;streamRevision++;}}
 private async Task TakeControl(){if(controllerLease is null)return;var response=await Api.PostAsync<ControllerLeaseState>($"api/lobbies/{MatchId}/controller/{SeatIndex}/take-control",new ControllerLeaseActionRequest(controllerLease.LeaseId));if(response.Payload?.Data is { } current){controllerLease=current;streamRevision++;Snackbar.Add("This tab now controls the seat. The previous game view is read-only.",Severity.Success);}else error=response.Payload?.Error?.Message;}
 private async Task ReleaseLease(){if(controllerLease is null)return;await Api.PostAsync<bool>($"api/lobbies/{MatchId}/controller/{SeatIndex}/release",new ControllerLeaseActionRequest(controllerLease.LeaseId));controllerLease=null;}
 private async Task ToggleFullscreen(){if(module is not null)fullscreen=await module.InvokeAsync<bool>("toggleGameFullscreen",shell,true);}
 private async Task FitNow(){if(module is null)return;var viewport=await module.InvokeAsync<ViewportInfo>("measureGameViewport",shell);var candidate=Recommend(viewport);recommendation=$"This {candidate.DeviceClass} layout recommends {candidate.Width} × {candidate.Height}. The stream is already fitted with CSS; native Apply is optional.";if(automaticFit&&!profileLocked)selectedProfile=candidate.Id;}
 [JSInvokable]public async Task OnViewportChanged(ViewportInfo viewport){fullscreen=viewport.Fullscreen;var candidate=Recommend(viewport);recommendation=$"This {candidate.DeviceClass} layout recommends {candidate.Width} × {candidate.Height}. The stream is already fitted with CSS; native Apply is optional.";if(automaticFit&&!profileLocked)selectedProfile=candidate.Id;await InvokeAsync(StateHasChanged);}
 private static ResolutionProfile Recommend(ViewportInfo value){if(value.Touch&&Math.Min(value.Width,value.Height)<700)return ResolutionProfiles.Find("800x600")!;if(value.Touch&&Math.Min(value.Width,value.Height)<1100)return ResolutionProfiles.Find("1024x768")!;var w=value.Width*Math.Max(1,value.DevicePixelRatio);var h=value.Height*Math.Max(1,value.DevicePixelRatio);return ResolutionProfiles.All.Where(p=>p.Width<=w&&p.Height<=h).OrderByDescending(p=>p.Width*p.Height).FirstOrDefault()??ResolutionProfiles.Find("800x600")!;}
 private async Task SetAutomatic(bool value){automaticFit=value;await SavePreference();if(value)await FitNow();}private async Task SetLocked(bool value){profileLocked=value;await SavePreference();}private async Task SelectProfile(string value){selectedProfile=value;await SavePreference();}private async Task SavePreference(){if(module is not null)await module.InvokeVoidAsync("saveDisplayPreference",automaticFit,profileLocked,selectedProfile);}
 private async Task RequestNativeResolution(){requestingResolution=true;error=null;cooldownBlocked=false;var payload=JsonSerializer.Serialize(new{profileId=selectedProfile});var result=await Api.PostAsync<GovernanceProposal>($"api/lobbies/{MatchId}/governance",new CreateGovernanceProposalRequest("native_resolution_change",payload));if(result.Payload?.Ok!=true){error=result.Payload?.Error?.Message??"The resolution request failed.";cooldownBlocked=result.Payload?.Error?.Code=="resolution_cooldown_active";}else await RefreshPanel();requestingResolution=false;}
 private async Task Vote(string id,string vote){var result=await Api.PostAsync<GovernanceProposal>($"api/lobbies/{MatchId}/governance/{id}/vote",new GovernanceVoteRequest(vote));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message;await RefreshPanel();}
 private async Task SendChat(){var text=draft.Trim();if(text.Length==0)return;var channel="global";var recipient=0;string? id=null;if(conversation.StartsWith("private:")){channel="private";recipient=int.Parse(conversation[8..]);}else if(conversation.StartsWith("group:")){channel="group";id=conversation[6..];}var result=await Api.PostAsync<LobbyMessage>($"api/lobbies/{MatchId}/messages",new SendLobbyMessageRequest(text,recipient,channel,id));if(result.Payload?.Ok==true&&result.Payload.Data is{}message){draft="";var index=messages.FindIndex(item=>item.Id==message.Id);if(index>=0)messages[index]=message;else messages.Add(message);}else error=result.Payload?.Error?.Message??"Message failed.";}
 private async Task RespondGroup(string id,string response){var result=await Api.PostAsync<ChatConversation>($"api/lobbies/{MatchId}/chat-groups/{id}/respond",new RespondChatGroupRequest(response));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message;await RefreshPanel();}
 private void ToggleGroupMember(int factionId,bool enabled){if(enabled)newGroupMembers.Add(factionId);else newGroupMembers.Remove(factionId);}
 private async Task CreateGroup(){var result=await Api.PostAsync<ChatConversation>($"api/lobbies/{MatchId}/chat-groups",new CreateChatGroupRequest(newGroupName.Trim(),newGroupMembers.Order().ToArray()));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message;else{conversation=$"group:{result.Payload.Data!.ConversationId}";newGroupName="";newGroupMembers.Clear();}await RefreshPanel();}
 private async Task ProposeSeatOperation(string kind,int targetSeat){var result=await Api.PostAsync<GovernanceProposal>($"api/lobbies/{MatchId}/governance",new CreateGovernanceProposalRequest(kind,JsonSerializer.Serialize(new{seatIndex=targetSeat}),180));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message;await RefreshPanel();}
 private async Task ProposeOperation(string kind){var result=await Api.PostAsync<GovernanceProposal>($"api/lobbies/{MatchId}/governance",new CreateGovernanceProposalRequest(kind,"{}",180));if(result.Payload?.Ok!=true)error=result.Payload?.Error?.Message;else if(kind=="waive_resolution_cooldown")cooldownBlocked=false;await RefreshPanel();}
 private void AskOperationConfirmation(string kind){confirmOperation=kind;panelOpen=false;}
 private async Task ConfirmManagedOperation(){var kind=confirmOperation;confirmOperation=null;if(kind is not null)await ProposeOperation(kind);}
 public async ValueTask DisposeAsync(){if(polling is not null){polling.Cancel();polling.Dispose();}timer?.Dispose();if(viewportWatcher is not null)await viewportWatcher.InvokeVoidAsync("dispose");selfReference?.Dispose();if(module is not null)await module.DisposeAsync();}
 public sealed record ViewportInfo(double Width,double Height,double DevicePixelRatio,bool Touch,string Orientation,bool Fullscreen);private sealed record DisplayPreference(bool Automatic,bool Locked,string? ProfileId);
}
