@page "/admin/network"
@attribute [Authorize(Roles="Administrator")]
@inject Services.PortalApiClient Api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
<PageTitle>Network access · SMACX Agent</PageTitle>
<PageHeader Kicker="ACCESS CONTROL" Title="LAN and remote friends" Description="The same server handles trusted local play and invitation-only remote access. Remote players verify a local installation once; no game files are uploaded." />
@if(loading){<MudProgressLinear Indeterminate="true" Color="Color.Primary"/>}
else
{
  <div class="content-grid two-column">
    <section class="surface-panel"><span class="panel-kicker">TRUSTED NETWORKS</span><h2>Local access</h2>
      <MudSwitch @bind-Value="trustedInvite" Color="Color.Primary" Label="Require invitations on trusted networks" />
      <MudText Typo="Typo.body2" Color="Color.Secondary">Off by default: friends on your LAN may create accounts directly.</MudText>
      <MudSwitch @bind-Value="trustedVerification" Color="Color.Primary" Label="Require installation verification on trusted networks" Class="mt-3" />
      <MudText Typo="Typo.body2" Color="Color.Secondary">Off by default. Remote access always requires both an invitation and one-time verification.</MudText>
      <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="Save">Save access policy</MudButton>
      <MudDivider Class="my-4"/><strong>Recognized as trusted</strong>
      @foreach(var network in settings?.TrustedNetworks??[]){<MudChip T="string" Size="Size.Small" Class="ma-1">@network</MudChip>}
    </section>
    <section class="surface-panel"><span class="panel-kicker">PUBLIC EDGE</span><h2>Internet readiness</h2>
      <p>Caddy is the single browser-facing edge and remains available for LAN play. Public TLS and dynamic DNS activate only when configured on the host.</p>
      <dl class="detail-list"><dt>Public hostname</dt><dd>@(string.IsNullOrWhiteSpace(settings?.PublicHostname)?"Not configured":settings.PublicHostname)</dd><dt>Dynamic DNS provider</dt><dd>@(settings?.DdnsConfigured==true?$"{settings.DdnsProvider} selected":"Idle")</dd><dt>Primary admin remote login</dt><dd>@(settings?.PrimaryAdministratorRemoteLoginAllowed==true?"Explicitly enabled":"Blocked (recommended)")</dd></dl>
      <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Host-level public hostname and DDNS secrets stay outside the database. See the Internet hosting guide for the small <code>.env</code> configuration.</MudAlert>
    </section>
  </div>
  <section class="surface-panel mt-4"><div class="section-heading"><div><span class="panel-kicker">ONE-TIME INVITATIONS</span><h2>Invite a remote friend</h2></div><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="CreateInvite">Create invitation</MudButton></div>
    <MudTextField @bind-Value="label" Label="Optional private label" Variant="Variant.Outlined" HelperText="For example, Mara's laptop. The friend never sees this label." />
    @if(created is not null){<MudAlert Severity="@(string.IsNullOrWhiteSpace(settings?.PublicHostname)?Severity.Warning:Severity.Success)" Variant="Variant.Outlined" Class="my-3"><strong>@(string.IsNullOrWhiteSpace(settings?.PublicHostname)?"This link is local-only until a public hostname is configured.":"Share this link privately; it is shown only now.")</strong><br/><code>@Absolute(created.SharePath)</code><br/>Expires @created.ExpiresAt.ToLocalTime().ToString("g").</MudAlert>}
    @foreach(var invite in invitations){<div class="user-row"><div class="user-copy"><strong>@(invite.Label??"Unlabelled invitation")</strong><span>@invite.Status · expires @invite.ExpiresAt.ToLocalTime().ToString("g")</span></div>@if(invite.Status=="active"){<MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(()=>Revoke(invite))">Revoke</MudButton>}</div>}
  </section>
}
@code{
 private NetworkAccessSettings? settings;private IReadOnlyList<AdminInvitationSummary> invitations=[];private bool trustedInvite;private bool trustedVerification;private bool loading=true;private string? label;private CreatedInvitation? created;
 protected override async Task OnInitializedAsync(){await Reload();loading=false;}
 private async Task Reload(){settings=(await Api.GetAsync<NetworkAccessSettings>("api/access/settings"))?.Data;invitations=(await Api.GetAsync<IReadOnlyList<AdminInvitationSummary>>("api/access/invitations"))?.Data??[];trustedInvite=settings?.TrustedRegistrationRequiresInvite??false;trustedVerification=settings?.TrustedInstallationVerificationRequired??false;}
 private async Task Save(){var result=await Api.PostAsync<NetworkAccessSettings>("api/access/settings",new UpdateNetworkAccessSettingsRequest(trustedInvite,trustedVerification));if(result.Payload?.Ok==true){settings=result.Payload.Data;Snackbar.Add("Access policy saved.",Severity.Success);}else Snackbar.Add(result.Payload?.Error?.Message??"Could not save access policy.",Severity.Error);}
 private async Task CreateInvite(){var result=await Api.PostAsync<CreatedInvitation>("api/access/invitations",new CreateInvitationRequest(label));if(result.Payload?.Ok==true){created=result.Payload.Data;label=null;await Reload();}else Snackbar.Add(result.Payload?.Error?.Message??"Could not create invitation.",Severity.Error);}
 private async Task Revoke(AdminInvitationSummary invite){var result=await Api.PostAsync<bool>($"api/access/invitations/{invite.Id}/revoke",new{});if(result.Payload?.Ok==true)await Reload();else Snackbar.Add(result.Payload?.Error?.Message??"Could not revoke invitation.",Severity.Error);}
 private string Absolute(string path)=>string.IsNullOrWhiteSpace(settings?.PublicHostname)
    ? Navigation.ToAbsoluteUri(path).ToString()
    : $"https://{settings.PublicHostname.Trim().TrimEnd('/')}{path}";
}
