@implements IAsyncDisposable
@inject IJSRuntime JS
@using Smacx.Portal.Contracts

@if (loaded && !dismissed)
{
<div class="capability-gap-backdrop" role="presentation">
    <section class="capability-gap-dialog" role="alertdialog" aria-modal="true"
             aria-labelledby="capability-gap-title" aria-describedby="capability-gap-description">
        <div class="capability-gap-mark"><MudIcon Icon="@Icons.Material.Filled.ReportProblem" /></div>
        <div class="capability-gap-heading">
            <span class="panel-kicker">SEMANTIC BRIDGE · NEEDS ATTENTION</span>
            <h2 id="capability-gap-title">The AI stopped safely</h2>
            <p id="capability-gap-description">
                It found a game state the semantic bridge cannot yet understand or control. Automatic
                continuation is off, and the native game is preserved for diagnosis.
            </p>
        </div>

        <div class="capability-gap-summary">
            <div><span>Gap ID</span><code>@Incident.GapId</code></div>
            <div><span>Turn</span><strong>@(Incident.Turn?.ToString() ?? "Unknown")</strong></div>
            <div><span>Native state</span><strong>@Incident.ScreenOrState</strong></div>
            <div><span>Reported</span><strong>@Incident.ReportedAt.ToLocalTime().ToString("g")</strong></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Incident.IntendedDecision))
        {
            <div class="capability-gap-detail"><span>What the AI was trying to do</span><p>@Incident.IntendedDecision</p></div>
        }
        <div class="capability-gap-detail"><span>Why it stopped</span><p>@Incident.WhyBlocked</p></div>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            The diagnostic ZIP is redacted. It contains no game binaries, credentials, private provider
            addresses, chat history, account data, or full model reasoning.
        </MudAlert>
        @if (!Incident.VerifiedCheckpointAvailable)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                No bridge-verified checkpoint is available yet. Keep the native worker preserved or use
                Stop &amp; park; automatic retry remains disabled rather than guessing at game state.
            </MudAlert>
        }

        <div class="capability-gap-actions">
            @if (CanRetry && RetryRequested.HasDelegate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.RestartAlt"
                           Disabled="RetryBusy" OnClick="Retry">
                    @(RetryBusy ? "Recovering…" : "Retry from verified checkpoint")
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       Disabled="@(Incident.DiagnosticFileName is null || downloading)"
                       OnClick="DownloadDiagnostic">
                @(downloading ? "Preparing download…" : "Download diagnostic ZIP")
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.BugReport"
                       Href="@IssueHref" Target="_blank">
                Open GitHub issue
            </MudButton>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy"
                       OnClick="CopyIssueSummary">
                Copy issue summary
            </MudButton>
            @if (ReturnRequested.HasDelegate)
            {
                <MudButton Variant="Variant.Text" OnClick="ReturnToLobby">Return to lobby</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Text" OnClick="Dismiss">Dismiss for now</MudButton>
            }
        </div>
        @if (copied)
        {
            <span class="capability-gap-copied" role="status">Issue summary copied.</span>
        }
        @if (!string.IsNullOrWhiteSpace(downloadError))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@downloadError</MudAlert>
        }
        <small>GitHub does not allow websites to attach local files automatically. Drag the downloaded ZIP into the issue.</small>
    </section>
</div>
}
else if (loaded && dismissed)
{
    <section class="capability-gap-banner @(Overlay ? "overlay" : "")" role="status" aria-live="polite">
        <div class="capability-gap-banner-icon"><MudIcon Icon="@Icons.Material.Filled.PauseCircle" /></div>
        <div class="capability-gap-banner-copy">
            <span class="panel-kicker">AI PAUSED · OPERATOR ATTENTION REQUIRED</span>
            <strong>Autonomous play is stopped at turn @(Incident.Turn?.ToString() ?? "unknown").</strong>
            <p>The native game is preserved. Dismissing the report does not resume the AI.</p>
            <code>@Incident.GapId</code>
        </div>
        <div class="capability-gap-banner-actions">
            @if (CanRetry && RetryRequested.HasDelegate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.RestartAlt"
                           Disabled="RetryBusy" OnClick="Retry">
                    @(RetryBusy ? "Recovering…" : "Retry from checkpoint")
                </MudButton>
            }
            else if (!string.IsNullOrWhiteSpace(RecoveryHref))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.BuildCircle" Href="@RecoveryHref">
                    Open recovery controls
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" OnClick="Reopen">View incident</MudButton>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public CapabilityGapIncident Incident { get; set; } = default!;
    [Parameter, EditorRequired] public string MatchId { get; set; } = "";
    [Parameter] public EventCallback Dismissed { get; set; }
    [Parameter] public EventCallback ReturnRequested { get; set; }
    [Parameter] public EventCallback RetryRequested { get; set; }
    [Parameter] public bool CanRetry { get; set; }
    [Parameter] public bool RetryBusy { get; set; }
    [Parameter] public string? RecoveryHref { get; set; }
    [Parameter] public bool Overlay { get; set; }
    private IJSObjectReference? module;
    private bool copied, downloading, dismissed, loaded;
    private string? loadedIncidentId, downloadError;

    private string DownloadHref =>
        $"api/lobbies/{Uri.EscapeDataString(MatchId)}/incidents/{Uri.EscapeDataString(Incident.IncidentId)}/diagnostic";

    private string IssueSummary => string.Join("\n", new[]
    {
        "SMACX semantic capability gap", "", $"Gap ID: {Incident.GapId}",
        $"Match ID: {MatchId}", $"Turn: {Incident.Turn?.ToString() ?? "unknown"}",
        $"Native state: {Incident.ScreenOrState}",
        $"Intended decision: {Incident.IntendedDecision}",
        $"Missing observation: {Incident.RequiredObservation}",
        $"Missing action: {Incident.RequiredAction}", $"Reason blocked: {Incident.WhyBlocked}",
        "", "I downloaded the redacted diagnostic ZIP and will attach it to this issue.",
    });

    private string IssueHref =>
        "https://github.com/magiccodingman/smacx-agent/issues/new?" +
        $"title={Uri.EscapeDataString($"Capability gap {Incident.GapId}")}&" +
        $"body={Uri.EscapeDataString(IssueSummary)}";

    private async Task CopyIssueSummary()
    {
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/incident-actions.js");
        await module.InvokeVoidAsync("copyText", IssueSummary);
        copied = true;
    }

    protected override void OnParametersSet()
    {
        if (loadedIncidentId == Incident.IncidentId) return;
        loaded = false;
        dismissed = false;
        copied = false;
        downloadError = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loaded || loadedIncidentId == Incident.IncidentId) return;
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/incident-actions.js");
        dismissed = await module.InvokeAsync<bool>("isIncidentDismissed", Incident.IncidentId);
        loadedIncidentId = Incident.IncidentId;
        loaded = true;
        StateHasChanged();
    }

    private async Task DownloadDiagnostic()
    {
        if (Incident.DiagnosticFileName is null) return;
        downloading = true;
        downloadError = null;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/incident-actions.js");
            await module.InvokeVoidAsync("downloadFile", DownloadHref, Incident.DiagnosticFileName);
        }
        catch (JSException exception)
        {
            downloadError = $"The diagnostic could not be downloaded: {exception.Message}";
        }
        finally
        {
            downloading = false;
        }
    }

    private async Task RememberDismissal()
    {
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/incident-actions.js");
        await module.InvokeVoidAsync("dismissIncident", Incident.IncidentId);
        dismissed = true;
    }

    private async Task ReturnToLobby()
    {
        await RememberDismissal();
        await ReturnRequested.InvokeAsync();
    }

    private async Task Dismiss()
    {
        await RememberDismissal();
        await Dismissed.InvokeAsync();
    }

    private async Task Reopen()
    {
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/incident-actions.js");
        await module.InvokeVoidAsync("restoreIncident", Incident.IncidentId);
        dismissed = false;
    }

    private Task Retry() => RetryRequested.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (module is not null) await module.DisposeAsync();
    }
}
